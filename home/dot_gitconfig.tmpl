[user]
	name = Jérôme Poskin
	email = jerome@moinax.com
[core]
	autocrlf = input
	pager = hunk pager
	editor = nvim
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[alias]
	# `cleanup` is deliberately not an alias: it lives in ~/.local/bin/git-cleanup,
	# which Git resolves for `git cleanup` on its own. As a one-liner here it could
	# not skip branches held by a worktree, so it errored on every one of them.
	fp = push --force-with-lease
	pr = pull --rebase
	cm = checkout main
[init]
	defaultBranch = main
[color]
	ui = auto
[push]
	default = current
