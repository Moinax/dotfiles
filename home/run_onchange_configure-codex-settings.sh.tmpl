#!/usr/bin/env bash
# Keep the one machine-local integration key Codex must execute in the live
# config it owns. The source template is create-only because Codex adds trust,
# project and feature state to config.toml itself; replacing the file would
# erase that state. This targeted merge preserves every other key.
#
# Hash the desired line into the script so chezmoi reruns this when it changes:
# {{ include "dot_codex/private_create_config.toml" | sha256sum }}
set -euo pipefail

config="$HOME/.codex/config.toml"
mkdir -p "${config%/*}"
touch "$config"

desired='notify = ["{{ .chezmoi.homeDir }}/.local/bin/herdr-agent-title", "codex-notify"]'
tmp="$(mktemp "${config}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

awk -v desired="$desired" '
  BEGIN { written = 0 }
  /^notify[[:space:]]*=/ && !written { print desired; written = 1; next }
  /^\[/ && !written { print desired; print ""; written = 1 }
  { print }
  END { if (!written) print desired }
' "$config" >"$tmp"

if ! cmp -s "$tmp" "$config"; then
  chmod --reference="$config" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$config"
fi
