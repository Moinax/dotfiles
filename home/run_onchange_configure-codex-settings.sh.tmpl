#!/usr/bin/env bash
# private_create_config.toml only seeds new installations; update existing
# configs selectively to preserve the project and feature state Codex writes.
set -euo pipefail

config="$HOME/.codex/config.toml"
[ -f "$config" ] || exit 0

tmp="$(mktemp "${config}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

awk '
  BEGIN { print "mcp_oauth_credentials_store = \"file\"" }
  /^[[:space:]]*\[/ { in_table = 1 }
  /^[[:space:]]*(["\047]?(notify|mcp_oauth_credentials_store)["\047]?)[[:space:]]*=/ && !in_table { next }
  { print }
' "$config" >"$tmp"

if ! cmp -s "$tmp" "$config"; then
    chmod --reference="$config" "$tmp" 2>/dev/null || chmod 600 "$tmp"
    mv "$tmp" "$config"
    echo "codex-settings: configured MCP credential storage and removed the retired notify key"
fi
