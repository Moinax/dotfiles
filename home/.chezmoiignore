# Chezmoi ignore file
# Files listed here will not be managed by chezmoi based on conditions
# NOTE: patterns match against TARGET paths (e.g. .config/), not source paths (e.g. dot_config/)

# README and documentation
README.md
LICENSE

# Ignore Hyprland configs if not selected
{{- if not .install_hyprland }}
.config/hypr/hyprland.lua
.config/hypr/hypridle.conf
.config/hypr/hyprpaper.conf
.config/hypr/hyprlock.conf
.config/hypr/conf
.config/hypr/conf/**
.config/hypr/scripts
.config/hypr/scripts/**
{{- end }}

# Ignore Wayland desktop components if Hyprland is not selected
{{- if not .install_hyprland }}
.config/xdg-desktop-portal
.config/xdg-desktop-portal/**
.config/waybar
.config/waybar/**
.config/rofi
.config/rofi/**
.config/swaync
.config/swaync/**
.config/wlogout
.config/wlogout/**
.local/share/rofi
.local/share/rofi/**
.config/systemd/user/swayosd-server.service
.config/systemd/user/wayland-wm@.service.d
.config/systemd/user/wayland-wm@.service.d/**
{{- end }}

# Ignore AI configs if not selected
{{- if not .install_ai }}
.config/hyprvoice
.config/hyprvoice/**
.local/bin/toggle-dictation.sh
{{- end }}

# vibewatch drop-in + enable symlink only when vibewatch is installed
{{- if not .install_vibewatch }}
.config/systemd/user/vibewatch.service.d
.config/systemd/user/vibewatch.service.d/**
.config/systemd/user/graphical-session.target.wants/vibewatch.service
{{- end }}

# Ignore Development configs if not selected
{{- if not .install_development }}
.config/nvim
.config/nvim/**
.config/Cursor
.config/Cursor/**
.config/hunk
.config/hunk/**
.config/tuicr
.config/tuicr/**
.config/gh-dash
.config/gh-dash/**
.config/worktrunk
.config/worktrunk/**
.config/ccstatusline
.config/ccstatusline/**
.config/herdr
.config/herdr/**
.claude
.claude/**
.zsh/rc.d/60-worktree.zsh
.config/fish/conf.d/60-worktree.fish
.config/fish/functions/wtstart.fish
.local/bin/wtclean
.local/bin/wtupdate
