{{- if index . "install_browsers" -}}
#!/bin/bash
# Per-site page styling through Firefox's own userContent.css, no extension needed.
#
# Same per-profile mechanism, and the same reasons, as
# run_configure-firefox-locale.sh. Firefox reads both the pref and the stylesheet
# at startup only, so a change here shows after a Firefox restart.
set -e

PREF='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
FIREFOX_ROOT="$HOME/.config/mozilla/firefox"
INI="$FIREFOX_ROOT/profiles.ini"

[ -f "$INI" ] || { echo "firefox-user-content: no profiles.ini, nothing to configure"; exit 0; }

while IFS= read -r profile; do
    dir="$FIREFOX_ROOT/$profile"
    [ -d "$dir" ] || continue
    user_js="$dir/user.js"
    if ! { [ -f "$user_js" ] && grep -qF "$PREF" "$user_js"; }; then
        printf '%s\n%s\n' '// Load chrome/userContent.css. Managed by the dotfiles.' "$PREF" >> "$user_js"
    fi
    mkdir -p "$dir/chrome"
    cat > "$dir/chrome/userContent.css" <<'CSS'
/* Managed by the dotfiles: home/run_configure-firefox-user-content.sh.tmpl */

/* TF1+: the player spans the whole window. Below 1024px the site already does it. */
@-moz-document domain("tf1.fr") {
  @media (min-width: 1024px) {
    body:not(.fullscreen) [data-testid="video-page-container"] {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) 350px !important;
      gap: 1.5rem !important;
      max-width: none !important;
      margin-top: 0 !important;
      padding-inline: 3rem !important;
    }
    /* Flatten the left column so the player can span both grid columns. */
    body:not(.fullscreen) [data-testid="video-page-container"] > div:first-child {
      display: contents !important;
    }
    /* Details sit under the player instead of stretching to the episode list. */
    body:not(.fullscreen) [data-testid="video-page-container"] > div:first-child > div {
      align-self: start !important;
    }
    /* 3.5rem is the sticky site header: the controls stay inside a wide window. */
    body:not(.fullscreen) div:has(> [data-testid="video-page-player-container"]) {
      grid-column: 1 / -1 !important;
      width: calc(100% + 6rem) !important;
      max-height: calc(100vh - 3.5rem) !important;
      margin-inline: -3rem !important;
      border-radius: 0 !important;
      box-shadow: none !important;
    }
  }
}
CSS
done < <(sed -n 's/^Path=//p' "$INI")
{{- end -}}
