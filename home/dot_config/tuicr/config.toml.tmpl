# tuicr — code review TUI (https://github.com/agavra/tuicr)
# Theme follows the chezmoi dark_mode data flag; apply-dark-mode.sh
# re-applies this file on mode switch, like gh-dash/starship/yazi.
theme = "catppuccin-{{ if eq .dark_mode "light" }}latte{{ else }}mocha{{ end }}"

diff_view = "side-by-side"
show_file_list = true
transparent_background = true
scroll_offset = 5

# Comment classifications: badge in the TUI, [TYPE] tag in exports and
# submitted reviews, Tab cycles through them (first entry is the default).
comment_types = [
  { id = "issue", definition = "problems to fix", color = "red" },
  { id = "suggestion", definition = "possible improvements" },
  { id = "question", definition = "ask for clarification", color = "yellow" },
  { id = "nit", label = "nitpick", definition = "small optional tweaks" },
]
