"$schema" = 'https://starship.rs/config-schema.json'

# Jetpack-style layout: bare prompt character on the left, context bar on the
# right (needs a shell with right-prompt support; zsh/fish are fine).
format = """
$username\
$cmd_duration\
$character"""

right_format = """
[ ](bg:bar)\
$directory\
$git_branch\
$git_status\
$conda\
[ ](bg:bar)"""

palette = '{{ if eq .dark_mode "light" }}light{{ else }}dark{{ end }}'

[username]
style_user = "fg:peach"
style_root = "fg:red"
format = '[$user ]($style)'

[cmd_duration]
show_milliseconds = true
format = '[◄ $duration ](fg:cream)'

[directory]
style = "fg:green bg:bar"
format = "[$path]($style)"
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Projects" = "󰲋 "

[git_branch]
symbol = ""
format = '[ · ](fg:dim bg:bar)[$symbol $branch](fg:blue bg:bar)'

[git_status]
format = '([$all_status$ahead_behind](fg:pink bg:bar))'
conflicted = '  ${count}'
ahead = ' ⇡${count}'
behind = ' ⇣${count}'
diverged = ' ⇕⇡${ahead_count}⇣${behind_count}'
staged = '  ${count}'
modified = '  ${count}'
untracked = '  ${count}'
deleted = '  ${count}'
renamed = '  ${count}'
stashed = '  ${count}'

[conda]
format = '[ · ](fg:dim bg:bar)[$environment](fg:teal bg:bar)'
ignore_base = false

# success/error/vimcmd symbols are the starship defaults ([❯] green/red, [❮]
# green), already recolored by the palette; only the non-default ones are set.
[character]
vimcmd_replace_one_symbol = '[❮](bold fg:pink)'
vimcmd_replace_symbol = '[❮](bold fg:pink)'
vimcmd_visual_symbol = '[❮](bold fg:peach)'

# Flat pastel palette matched to the Catppuccin colors (ccstatusline
# settings.json uses the same hex values).
[palettes.dark]
bar = "#262434"
dim = "#8D92A7"
cream = "#F6E2B7"
peach = "#F2B590"
pink = "#E990A9"
teal = "#9FD6CF"
green = "#ABDFA7"
blue = "#8FB3EF"
red = "#F0919B"

# Darkened variants of the same hues for readable contrast on light terminals.
[palettes.light]
bar = "#E4E1ED"
dim = "#767C93"
cream = "#97742A"
peach = "#B4642A"
pink = "#BC4A6F"
teal = "#2E8078"
green = "#4E8F49"
blue = "#3D6ACA"
red = "#C43D4F"
