"$schema" = 'https://starship.rs/config-schema.json'

# Jetpack-style layout: bare prompt character on the left, context on the right
# prompt (needs a shell with right-prompt support; zsh is fine).
format = """
$username\
$cmd_duration\
$character"""

# No segment carries a background — see the translucent-pane convention in
# CLAUDE.md. No trailing space: it existed for fish, which flushes the right
# prompt to the last column, and zsh already indents by one on its own
# (ZLE_RPROMPT_INDENT default) — so with the fish config retired it was simply
# a second column of margin.
right_format = """
$directory\
$git_branch\
$git_status\
$conda"""

palette = '{{ if eq .dark_mode "light" }}light{{ else }}dark{{ end }}'

[username]
style_user = "fg:peach"
style_root = "fg:red"
format = '[$user ]($style)'

[cmd_duration]
show_milliseconds = true
format = '[◄ $duration ](fg:cream)'

[directory]
style = "fg:green"
format = "[$path]($style)"
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Projects" = "󰲋 "

[git_branch]
symbol = ""
format = '[ · ](fg:dim)[$symbol $branch](fg:blue)'

[git_status]
format = '([$all_status$ahead_behind](fg:pink))'
conflicted = '  ${count}'
ahead = ' ⇡${count}'
behind = ' ⇣${count}'
diverged = ' ⇕⇡${ahead_count}⇣${behind_count}'
staged = '  ${count}'
modified = '  ${count}'
untracked = '  ${count}'
deleted = '  ${count}'
renamed = '  ${count}'
stashed = '  ${count}'

[conda]
format = '[ · ](fg:dim)[$environment](fg:teal)'
ignore_base = false

# success/error/vimcmd symbols are the starship defaults ([❯] green/red, [❮]
# green), already recolored by the palette; only the non-default ones are set.
[character]
vimcmd_replace_one_symbol = '[❮](bold fg:pink)'
vimcmd_replace_symbol = '[❮](bold fg:pink)'
vimcmd_visual_symbol = '[❮](bold fg:peach)'

# Flat pastel palette matched to the Catppuccin colors (ccstatusline
# settings.json uses the same hex values).
[palettes.dark]
dim = "#8D92A7"
cream = "#F6E2B7"
peach = "#F2B590"
pink = "#E990A9"
teal = "#9FD6CF"
green = "#ABDFA7"
blue = "#8FB3EF"
red = "#F0919B"

# Darkened variants of the same hues for readable contrast on light terminals.
[palettes.light]
dim = "#767C93"
cream = "#97742A"
peach = "#B4642A"
pink = "#BC4A6F"
teal = "#2E8078"
green = "#4E8F49"
blue = "#3D6ACA"
red = "#C43D4F"
