if command -q eza
    alias ls "eza --icons --group-directories-first"
    alias ll "eza --icons --group-directories-first -l --git"
    alias lsa "eza --icons --group-directories-first -la --git"
    alias lt "eza --icons --group-directories-first --tree --level=2"
end

alias vim nvim
alias vi nvim
alias v nvim

alias lg lazygit
alias ld lazydocker
alias dash "gh dash"

alias gpr "git pull --rebase"
alias gcm "git checkout main"
alias gfp "git push --force-with-lease"
alias gcl "git cleanup"

# Herdr — per-session control (omit the name for a gum picker)
if command -q herdr
    alias hso "herdr-session open" # focus/open a session's client window
    alias hsd "herdr-session detach" # close the window, keep server + agents
    alias hss "herdr-session stop" # stop the server (kills its agents)
    alias hsl "herdr-session list" # persisted sessions, * = running
end
{{- if ne .install_purpose "terminal" }}

# Auto-copy terminfo to remote servers via kitten ssh
if test -n "$KITTY_WINDOW_ID"; and command -q kitten
    alias ssh "kitten ssh"
end
{{- end }}
