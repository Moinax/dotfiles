// Zellij — the persistent terminal. Managed by chezmoi.
//
// The agents live in T3 Code now, so this config is deliberately thin: one
// session ("main", opened by `term`) and one tab per checkout (`dev`).
// Everything the herdr setup built by hand — pane roles, session revive, a
// sidebar, tool tabs — zellij either does natively or no longer has anything
// to do.
//
// **zellij rewrites this file wholesale.** Its first-run wizard did exactly
// that on the first `zellij attach` — every default expanded, every comment
// here gone, the previous content moved to config.kdl.bak — and its
// configuration plugin (Ctrl+o, then c) writes the same way. `show_startup_tips
// false` below is what the wizard was after, so it does not fire again; the
// plugin is still a live hazard, and the fix after one is `chezmoi apply
// --force ~/.config/zellij/config.kdl`. Same shape as the herdr config keeping
// `onboarding` managed, and for the same reason.
show_startup_tips false

// Dark and light named together rather than one theme resolved at apply time:
// zellij owns the pair natively, and `zellij action set-dark-theme` /
// `set-light-theme` switch a *running* session between them, which is what lets
// `Mod+N` reach the terminal at all — apply-dark-mode.sh calls it for every live
// session. Neither key does anything alone; zellij falls back to `theme` unless
// both are set.
//
// So this file no longer depends on the `dark_mode` template variable, and an
// apply cannot leave the terminal on the wrong half of the toggle. It also
// means no palette had to be written out by hand — the builtins are named here,
// not redefined.
theme_dark "catppuccin-mocha"
theme_light "catppuccin-latte"

// `dev` can create the session headlessly from Vicinae, before Kitty exists to
// provide TERM. Without this, every restored Zsh inherits an unset TERM and
// ZLE cannot repaint edited lines (duplicated prompts, apparent spaces on
// backspace, broken Ctrl+L). Zellij's portable terminal capabilities are the
// xterm-256color set; enforce them for every pane regardless of launch path.
env {
    TERM "xterm-256color"
}

// Wayland clipboard. copy_on_select matches what kitty already does, so a
// selection means the same thing inside a pane and outside one.
copy_command "wl-copy"
copy_on_select true
scrollback_editor "nvim"

// Closing the terminal window detaches rather than killing the session. That,
// plus session_serialization (on by default), is the whole of what
// `herdr-clients revive-panes` and its role sidecar existed to provide: zellij
// serializes each pane's cwd and running command itself, and `zellij attach`
// resurrects a session that outlived its server.
on_force_close "detach"

keybinds {
    shared_except "locked" {
        // Tabs. ctrl+shift+t and ctrl(+shift)+tab follow the usual terminal /
        // browser conventions. kitty hands these chords to zellij because the
        // multiplexer is the sole owner of tabs; its own tab bar is hidden.
        // Close and rename use zellij's native tab mode (ctrl+t, then x/r), so
        // they need no extra global chords.
        //
        // One surprise worth knowing when a session does end: `zellij attach
        // -c` resurrects it from the serialized layout, and that layout is
        // only rewritten when zellij marks the session dirty — closing a tab
        // does not. So a tab closed shortly before the end comes back.
        // Measured; `serialization_interval` does not reach it, since it sets
        // the cadence and not what gets written. The only lever is
        // `session_serialization false`, which drops resurrection entirely.
        bind "Ctrl Shift t" { NewTab; }
        bind "Ctrl Tab" { GoToNextTab; }
        bind "Ctrl Shift Tab" { GoToPreviousTab; }

        // Direct tab jump. AZERTY needs no second binding here, unlike the
        // config this replaces: kitty already translates alt+& é " ' ( into
        // alt+1..5 at the terminal layer.
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }
}
