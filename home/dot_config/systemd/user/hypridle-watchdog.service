[Unit]
Description=Restart hypridle when it loses its Wayland connection
Documentation=https://github.com/hyprwm/hypridle
# Why this exists:
# hypridle is the logind Lock handler — `loginctl lock-session` (the Mod+Alt+L
# bind, the wlogout button, and hypridle's own before_sleep_cmd) only locks if
# hypridle is alive AND still connected to the compositor.
#
# When the compositor's Wayland display resets in place (e.g. an NVIDIA GPU /
# modeset hiccup), every Wayland client is disconnected. Well-behaved daemons
# (waybar, cliphist, xdg-desktop-portal-hyprland, ...) EXIT and systemd's
# Restart= respawns them. hypridle v0.1.7 does NOT exit — it logs
# `[CRITICAL] [core] Disconnected from pollfd id 1` and keeps running deaf, so
# Restart=on-failure never fires and the session is left with no lock handler.
#
# Nothing cycles in systemd's view during this event (the compositor service
# stays active, NRestarts=0), so a unit dependency/binding can't catch it.
# 0.1.7 is also the latest packaged hypridle (extra/hypridle 0.1.7-9 as of
# 2026-06-19; the old sdbus-cpp/hyprlock pins are now lifted), so there is no
# newer build that exits cleanly to upgrade to — the deaf-disconnect still fires
# on the current build. This watchdog tails hypridle's journal and restarts it
# the instant it reports the disconnect — the only signal the failure emits.
PartOf=graphical-session.target
After=graphical-session.target hypridle.service
StartLimitIntervalSec=0

[Service]
Slice=background-graphical.slice
Type=simple
# Follow hypridle's log from now on (-n0); on the disconnect marker, restart it.
# The 5s debounce prevents a tight restart loop while the compositor settles —
# the display reset is transient (clients reconnect within ~2s).
ExecStart=/usr/bin/sh -c 'exec journalctl --user -u hypridle.service -f -n0 --output=cat | while IFS= read -r line; do case "$line" in *"Disconnected from pollfd"*) systemctl --user restart hypridle.service; sleep 5 ;; esac; done'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
