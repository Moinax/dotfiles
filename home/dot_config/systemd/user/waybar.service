[Unit]
Description=Waybar (compositor-aware launcher)
Documentation=https://github.com/Alexays/Waybar/wiki/
PartOf=graphical-session.target
After=graphical-session.target
# No Requisite=graphical-session.target — it demands the target already be
# active when the job runs, which races under uwsm and silently drops the unit
# at session start (no retry). PartOf= still stops it on logout;
# StartLimitIntervalSec=0 avoids start-limit-hit on inter-session socket errors.
StartLimitIntervalSec=0

[Service]
Slice=background-graphical.slice
Type=simple
ExecStart=%h/.config/waybar/launch-waybar.sh
ExecReload=/usr/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
