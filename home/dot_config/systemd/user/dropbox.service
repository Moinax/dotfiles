[Unit]
Description=Dropbox
Documentation=https://help.dropbox.com/installs/linux
PartOf=graphical-session.target
After=graphical-session.target
# No Requisite=graphical-session.target — it demands the target already be
# active when the job runs, which races under uwsm and silently drops the unit
# at session start (no retry). PartOf= still stops it on logout;
# StartLimitIntervalSec=0 avoids start-limit-hit on inter-session socket errors.
StartLimitIntervalSec=0

# Skip cleanly until the user has installed Dropbox via the bypass path.
ConditionPathExists=%h/.dropbox-dist/dropboxd

[Service]
Slice=background-graphical.slice
Type=simple
ExecStart=%h/.dropbox-dist/dropboxd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
