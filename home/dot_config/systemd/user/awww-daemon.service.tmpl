{{- $wp := ternary "swww" "awww" (eq .chezmoi.osRelease.id "fedora") -}}
[Unit]
Description={{ $wp }} wallpaper daemon (animated transitions, IPC)
Documentation=https://codeberg.org/LGFae/awww
PartOf=graphical-session.target
After=graphical-session.target
# No Requisite=graphical-session.target / ConditionEnvironment=WAYLAND_DISPLAY —
# both gate on session state that races under uwsm and silently drops the unit
# at session start (no retry). PartOf= still stops it on logout; Restart= +
# StartLimitIntervalSec=0 self-heal if it starts before the wayland socket is up.
# Binary differs by distro: Arch ships awww (renamed swww), Fedora's copr still ships swww.
StartLimitIntervalSec=0

[Service]
Slice=background-graphical.slice
Type=exec
ExecStart=/usr/bin/{{ $wp }}-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
