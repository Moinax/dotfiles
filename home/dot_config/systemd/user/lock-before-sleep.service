[Unit]
Description=Lock and paint before the system suspends
Documentation=man:systemd-inhibit(1)
# Same gating as the other graphical daemons here: PartOf stops it on logout, and
# no Requisite=/ConditionEnvironment= because both race uwsm's env import at
# session start and silently drop the unit with no retry.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Slice=background-graphical.slice
Type=exec
# The inhibitor is the feature: `delay` holds the suspend open until the wrapped
# process exits, which is the only window in which the compositor can still draw
# (logind revokes DRM master on its way down). The script waits for
# PrepareForSleep, locks, lets hyprlock paint, and exits — see its header.
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=delay \
    --who=Hyprland --why="Lock the session while the screen can still be drawn" \
    %h/.local/bin/lock-before-sleep.sh
# Always, not on-failure: the script exits 0 on the normal path — one suspend
# handled — and the restart is what takes a fresh inhibitor for the next cycle.
# Without it, this would guard exactly one suspend per login.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
