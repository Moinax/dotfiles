[Unit]
Description=Daily check for the hypridle rebuild that unblocks the sdbus-cpp/hyprlock pins

[Timer]
OnCalendar=daily
# Catch up if the machine was off when the timer was due.
Persistent=true
# Spread the wakeup so it doesn't race every other daily.timer at midnight.
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
