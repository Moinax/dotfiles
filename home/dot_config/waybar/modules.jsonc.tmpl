{
  // Workspaces
{{ if .install_hyprland }}
  "hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "hide-active": false,
    "all-outputs": false,
{{- if eq .chezmoi.hostname "moinax-desktop" }}
    "persistent-workspaces": {
      "DP-2": [6],
      "DP-1": [7],
      "DP-3": [1, 2, 3, 4, 5]
    },
    "persistent-only": true,
{{- else }}
    "persistent-only": false,
{{- end }}
    "move-to-monitor": false,
    "format": "{name}",
  },
{{ end }}
  // Focused window
{{ if .install_hyprland }}
  "hyprland/window": {
    "rewrite": {
      "(.*) - Brave": "$1",
      "(.*) - Chromium": "$1",
      "(.*) - Brave Search": "$1",
      "(.*) - Outlook": "$1",
      "(.*) Microsoft Teams": "$1",
    },
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    // The tray sits in modules-center, so the title shares its half of the bar
    // with the workspaces only. The laptop's 1920px bar leaves less of it.
    "max-length": {{ if eq .chezmoi.hostname "moinax-laptop" }}45{{ else }}60{{ end }},
  },
  // Same module for the portrait bars: 1440px holds workspaces, title, the
  // centred tray and the clock, and a 60-char title runs into the tray.
  "hyprland/window#minimal": {
    "rewrite": {
      "(.*) - Brave": "$1",
      "(.*) - Chromium": "$1",
      "(.*) - Brave Search": "$1",
      "(.*) - Outlook": "$1",
      "(.*) Microsoft Teams": "$1",
    },
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "max-length": 35,
  },
{{ end }}
  "custom/exit": {
    "format": "",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout-wrapper.sh",
    "tooltip": false,
  },
  // Keyboard State
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": "",
    },
  },
  // System tray
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
  },
  // Clock
  "clock": {
    // "timezone": "America/New_York",
    "format": "{:%d.%m - %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    // "format-alt": "{:%Y-%m-%d}",
  },
  // System
  "custom/system": {
    "format": " ",
    "tooltip": false,
  },
  // CPU
  "cpu": {
    "format": " {usage}%",
    // "on-click": "alacritty -e htop"
    "on-click": "kitty -T btop btop",
  },
  // Memory
  "memory": {
    "format": " {used:.0f}G",
    // Same command as cpu on purpose: the two are one visible pill (group/stats)
    // and the whole pill has to be clickable. The -T is load-bearing — it is what
    // the float+center window rule matches on (hypr/conf/windowrules.lua).
    "on-click": "kitty -T btop btop",
  },
  // Harddisc space used
  "disk": {
    "interval": 30,
    "format": "D {percentage_used}% ",
    "path": "/",
    "on-click": "kitty -T btop btop",
  },
  "hyprland/language": {
    "format": "/ K {short}",
  },
  "custom/keyboard-layout": {
    "exec": "~/.local/bin/waybar-keyboard-layout.sh",
    "interval": 2,
    "format": "⌨ {}",
    "tooltip": false,
    // Same selector as Mod+K. The old target, toggle-keyboard-layout.sh bare,
    // stopped being a picker when it was refactored into list|set for the
    // vicinae command — a bare call now exits 1, so the click did nothing.
    "on-click": "vicinae 'vicinae://launch/@moinax/moinax/keyboard-layout?toggle=true'",
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory"],
  },
  // Battery
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon}  {time}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [" ", " ", " ", " ", " "],
  },
  // Pulseaudio
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{icon} {volume}",
    "format-bluetooth": "{icon} ",
    "format-bluetooth-muted": " ",
    "format-muted": "",
    "format-source": "",
    "format-source-muted": " ",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol-qt",
  },
  // Bluetooth
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": "",
  },
  // Other
  "user": {
    "format": "{user}",
    "interval": 60,
    "icon": false,
  },
  // Idle Inhibator
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip": true,
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
    "on-click-right": "loginctl lock-session",
  },
  // HDR/SDR toggle; hidden automatically when no HDR-capable display is present.
  "custom/hdr": {
    "exec": "~/.local/bin/waybar-hdr.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "signal": 9,
    "interval": 5,
    "on-click": "~/.local/bin/toggle-hdr.sh",
  },
  // Dark/light mode (follows the portal colour-scheme — continuous exec)
  "custom/dark-mode": {
    "exec": "~/.local/bin/waybar-dark-mode.sh",
    "return-type": "json",
    "restart-interval": 1,
    "on-click": "~/.local/bin/toggle-dark-mode.sh",
  },
  // Caffeine mode (custom idle toggle — continuous exec via inotifywait)
  "custom/caffeine": {
    "exec": "~/.local/bin/waybar-caffeine.sh",
    "return-type": "json",
    "restart-interval": 1,
    "on-click": "~/.local/bin/toggle-caffeine.sh",
  },
  // VPN: which of Tailscale / NetBird is up. The click opens the same vicinae
  // picker as Mod+Ctrl+N rather than toggling in place — there are two tunnels
  // now and they are mutually exclusive, so a click has no single obvious
  // meaning and the menu is where the choice belongs.
  "custom/vpn": {
    "exec": "~/.local/bin/waybar-vpn.sh",
    "return-type": "json",
    "signal": 11,
    // Thirty seconds, and do not raise it. It was 300 for one commit, on the
    // grounds that toggle-vpn.sh signals the bar itself so the poll only catches
    // an out-of-band `tailscale up` — which missed the boot race: waybar starts
    // ~12s before tailscaled reaches Running, reads "nothing connected" quite
    // correctly, and then has no event to tell it otherwise. At 300 the shield
    // lied for five minutes after every boot. Two local daemon round trips per
    // tick is the cheaper end of that trade.
    "interval": 30,
    "on-click": "vicinae 'vicinae://launch/@moinax/moinax/vpn?toggle=true'",
  },
  // Headset battery (via headsetcontrol)
  "custom/headset-battery": {
    "exec": "~/.local/bin/waybar-headset-battery.sh",
    "return-type": "json",
    "interval": 60,
    "format": "{}",
    "tooltip": true,
  },
  // Notification center (SwayNC)
  "custom/notification": {
    "exec": "~/.local/bin/waybar-notification.sh",
    "return-type": "json",
    // Continuous scripts get no second chance: a bar teardown (a monitor coming
    // back is enough) kills them and the module then shows its last value
    // forever. Waybar is the only supervisor they have — same as dark-mode and
    // caffeine above.
    "restart-interval": 1,
    "tooltip": true,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "escape": true,
    "format": "{}"
  }
}
