{
  // Workspaces
{{ if .install_hyprland }}
  "hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "hide-active": false,
    "all-outputs": false,
{{- if eq .chezmoi.hostname "moinax-desktop" }}
    "persistent-workspaces": {
      "DP-2": [6],
      "DP-1": [7],
      "DP-3": [1, 2, 3, 4, 5]
    },
    "persistent-only": true,
{{- else }}
    "persistent-only": false,
{{- end }}
    "move-to-monitor": false,
    "format": "{name}",
  },
{{ end }}
  // Focused window
{{ if .install_hyprland }}
  "hyprland/window": {
    "rewrite": {
      "(.*) - Brave": "$1",
      "(.*) - Chromium": "$1",
      "(.*) - Brave Search": "$1",
      "(.*) - Outlook": "$1",
      "(.*) Microsoft Teams": "$1",
    },
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "max-length": 60,
  },
{{ end }}
  "custom/exit": {
    "format": "",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout-wrapper.sh",
    "tooltip": false,
  },
  // Keyboard State
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": "",
    },
  },
  // System tray
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
  },
  // Clock
  "clock": {
    // "timezone": "America/New_York",
    "format": "{:%d.%m - %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    // "format-alt": "{:%Y-%m-%d}",
  },
  // System
  "custom/system": {
    "format": " ",
    "tooltip": false,
  },
  // CPU
  "cpu": {
    "format": " {usage}%  ",
    // "on-click": "alacritty -e htop"
    "on-click": "kitty -T btop btop",
  },
  // Memory
  "memory": {
    "format": " {used}G",
    // Same command as cpu on purpose: the two are one visible pill (group/stats)
    // and the whole pill has to be clickable. The -T is load-bearing — it is what
    // the float+center window rule matches on (hypr/conf/windowrules.lua).
    "on-click": "kitty -T btop btop",
  },
  // Harddisc space used
  "disk": {
    "interval": 30,
    "format": "D {percentage_used}% ",
    "path": "/",
    "on-click": "kitty -T btop btop",
  },
  "hyprland/language": {
    "format": "/ K {short}",
  },
  "custom/keyboard-layout": {
    "exec": "~/.local/bin/waybar-keyboard-layout.sh",
    "interval": 2,
    "format": "⌨ {}",
    "tooltip": false,
    // Same selector as Mod+K. The old target, toggle-keyboard-layout.sh bare,
    // stopped being a picker when it was refactored into list|set for the
    // vicinae command — a bare call now exits 1, so the click did nothing.
    "on-click": "vicinae 'vicinae://launch/@moinax/moinax/keyboard-layout?toggle=true'",
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory"],
  },
  // Battery
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon}  {time}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [" ", " ", " ", " ", " "],
  },
  // Pulseaudio
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{icon} {volume}",
    "format-bluetooth": "{icon} ",
    "format-bluetooth-muted": " ",
    "format-muted": "",
    "format-source": "",
    "format-source-muted": " ",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol-qt",
  },
  // Bluetooth
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": "",
  },
  // Other
  "user": {
    "format": "{user}",
    "interval": 60,
    "icon": false,
  },
  // Idle Inhibator
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip": true,
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
    "on-click-right": "loginctl lock-session",
  },
  // HDR/SDR toggle for the HDR-capable monitor (desktop DP-3)
  "custom/hdr": {
    "exec": "~/.local/bin/waybar-hdr.sh",
    "return-type": "json",
    "signal": 9,
    "interval": 5,
    "on-click": "~/.local/bin/toggle-hdr.sh",
  },
  // Dark/light mode (follows the portal colour-scheme — continuous exec)
  "custom/dark-mode": {
    "exec": "~/.local/bin/waybar-dark-mode.sh",
    "return-type": "json",
    "restart-interval": 1,
    "on-click": "~/.local/bin/toggle-dark-mode.sh",
  },
  // Caffeine mode (custom idle toggle — continuous exec via inotifywait)
  "custom/caffeine": {
    "exec": "~/.local/bin/waybar-caffeine.sh",
    "return-type": "json",
    "restart-interval": 1,
    "on-click": "~/.local/bin/toggle-caffeine.sh",
  },
  // Tailscale VPN toggle
  "custom/tailscale": {
    "exec": "~/.local/bin/waybar-tailscale.sh",
    "return-type": "json",
    "signal": 11,
    "interval": 30,
    "on-click": "~/.local/bin/toggle-tailscale.sh",
  },
  // Headset battery (via headsetcontrol)
  "custom/headset-battery": {
    "exec": "~/.local/bin/waybar-headset-battery.sh",
    "return-type": "json",
    "interval": 60,
    "format": "{}",
    "tooltip": true,
  },
{{ if .install_vibewatch }}
{{- $vw := "~/.cargo/bin/vibewatch" }}
  // AI agent monitor (vibewatch). Three children rather than one label, because
  // the state wants its own rounded, darkened chip and waybar can only give a
  // background to a real widget — the same reason group/stats splits cpu and
  // memory. Each child needs its own `exec`: one stream cannot feed two widgets,
  // hence `--part`.
  //
  // The absolute path is a local, not repeated: `~/.cargo/bin` is on PATH for
  // interactive zsh/fish (dot_zshenv.tmpl) but never for the graphical session,
  // so every exec here has to spell it out — and six copies of a path is six
  // places to miss when a `cargo install --root` moves it.
  //
  // Cost, measured, because a `--watch` exec is a resident process and this is
  // three of them: config-hyprland defines two bars over three monitors, so the
  // bar count multiplies the part count — 3 instances × 3 parts = 9 subscribers,
  // ~50MB PSS / ~273MB RSS in total (verified with pgrep + smaps_rollup), up
  // from 3 and ~16MB when this was one label. CPU is genuinely nil (0.03s over
  // 9 minutes each), but the daemon now fans every agent state change out to 9
  // pipes. If that ever needs cutting, the state is the only part that truly
  // needs its own widget — name and count could share one stream with the badge
  // appended as Pango, which is a change to vibewatch's `--part` contract and
  // not something this file can do alone.
  // Order is layout: logo+name, then the state chip, then the count.
  "group/vibewatch": {
    "orientation": "horizontal",
    "modules": ["custom/vibewatch-name", "custom/vibewatch-state", "custom/vibewatch-count"],
  },
  "custom/vibewatch-name": {
    "exec": "{{ $vw }} status --watch --part name",
    "return-type": "json",
    "on-click": "{{ $vw }} toggle-panel",
    "format": "{}",
    "tooltip": false,
  },
  "custom/vibewatch-state": {
    "exec": "{{ $vw }} status --watch --part state",
    "return-type": "json",
    "on-click": "{{ $vw }} toggle-panel",
    "format": "{}",
    "tooltip": false,
  },
  "custom/vibewatch-count": {
    "exec": "{{ $vw }} status --watch --part count",
    "return-type": "json",
    "on-click": "{{ $vw }} toggle-panel",
    // The badge is empty whenever one agent is alive. waybar's own answer to
    // that is better than any CSS: it drops the widget instead of leaving its
    // padding behind. (GTK has no `:empty`, and reaching for it takes the whole
    // bar down — it fails to parse and waybar exits.)
    "hide-empty-text": true,
    "format": "{}",
    "tooltip": false,
  },
{{ end }}
  // Notification center (SwayNC)
  "custom/notification": {
    "exec": "~/.local/bin/waybar-notification.sh",
    "return-type": "json",
    "tooltip": true,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "escape": true,
    "format": "{}"
  }
}
