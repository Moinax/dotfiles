{{- /* Waybar config for Hyprland compositor — two bars: full and minimal */ -}}
[
  {
    "name": "full",
    "output": [],
    "spacing": 4,
    "include": [
      "~/.config/waybar/modules.jsonc"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "group/stats",
      "clock"
    ],
    "modules-right": [
      "custom/keyboard-layout",
      "custom/hdr",
      "custom/dark-mode",
      "custom/caffeine",
      "custom/vpn",
      "pulseaudio",
      "custom/headset-battery",
      "battery",
      "tray",
      "custom/notification",
      "custom/exit"
    ]
  },
  {
    "name": "minimal",
    "output": [],
    "spacing": 4,
    "include": [
      "~/.config/waybar/modules.jsonc"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window#minimal"
    ],
    "modules-center": [
      "group/stats",
      "clock"
    ],
    "modules-right": [
      "battery",
      "tray",
      "custom/notification",
      "custom/exit"
    ]
  }
]
