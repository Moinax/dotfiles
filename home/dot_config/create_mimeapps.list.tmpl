{{- $textEditor := "org.kde.kate.desktop" -}}
{{- if lookPath "code" -}}
{{-   $textEditor = "code.desktop" -}}
{{- end -}}
{{- if lookPath "cursor" -}}
{{-   $textEditor = "cursor.desktop" -}}
{{- end -}}
{{- $imageViewer := "org.kde.gwenview.desktop" -}}
{{- $pdfViewer := "org.kde.okular.desktop" -}}
{{- /* This file uses chezmoi's `create_` attribute (see the source filename:
       create_mimeapps.list.tmpl): it is seeded ONCE on a fresh machine and
       then never managed again. That is deliberate — browsers and KDE rewrite
       ~/.config/mimeapps.list themselves via xdg-settings/xdg-mime when you set
       a default browser, so if chezmoi kept managing it you'd get perpetual
       `chezmoi diff` churn and your browser choice reverted on every apply.
       Instead we seed sane defaults (Firefox — the only browser on a fresh
       CachyOS — plus the image/video/pdf associations below), then hand the
       file over to you and your apps. Set your real default browser through the
       browser itself; chezmoi won't fight it. */ -}}
{{- $browser := "firefox.desktop" -}}
[Default Applications]
# Images
image/bmp={{ $imageViewer }}
image/gif={{ $imageViewer }}
image/jpeg={{ $imageViewer }}
image/png={{ $imageViewer }}
image/svg+xml={{ $imageViewer }}
image/tiff={{ $imageViewer }}
image/webp={{ $imageViewer }}
image/avif={{ $imageViewer }}
image/heif={{ $imageViewer }}

# Videos
video/mp4=mpv.desktop
video/mpeg=mpv.desktop
video/ogg=mpv.desktop
video/webm=mpv.desktop
video/x-matroska=mpv.desktop
video/x-msvideo=mpv.desktop
video/quicktime=mpv.desktop
video/x-flv=mpv.desktop

# Audio
audio/aac=mpv.desktop
audio/flac=mpv.desktop
audio/mpeg=mpv.desktop
audio/ogg=mpv.desktop
audio/opus=mpv.desktop
audio/wav=mpv.desktop
audio/x-wav=mpv.desktop
audio/webm=mpv.desktop
audio/x-vorbis+ogg=mpv.desktop

# Documents
application/pdf={{ $pdfViewer }}

# Text
text/plain={{ $textEditor }}
text/x-csrc={{ $textEditor }}
text/x-chdr={{ $textEditor }}
text/x-c++src={{ $textEditor }}
text/x-python={{ $textEditor }}
text/x-shellscript={{ $textEditor }}
text/xml={{ $textEditor }}
text/csv={{ $textEditor }}
text/markdown={{ $textEditor }}
application/json={{ $textEditor }}
application/x-yaml={{ $textEditor }}
application/toml={{ $textEditor }}

# Web
text/html={{ $browser }}
x-scheme-handler/http={{ $browser }}
x-scheme-handler/https={{ $browser }}
x-scheme-handler/about={{ $browser }}
x-scheme-handler/unknown={{ $browser }}
x-scheme-handler/mailto={{ $browser }}
x-scheme-handler/chrome={{ $browser }}
x-scheme-handler/webcal={{ $browser }}
application/x-extension-htm={{ $browser }}
application/x-extension-html={{ $browser }}
application/x-extension-shtml={{ $browser }}
application/xhtml+xml={{ $browser }}
application/x-extension-xhtml={{ $browser }}
application/x-extension-xht={{ $browser }}

# Other schemes
x-scheme-handler/jetbrains=jetbrainsd.desktop
x-scheme-handler/slack=slack.desktop

# File manager
inode/directory=org.kde.dolphin.desktop

[Added Associations]
image/bmp={{ $imageViewer }}
image/gif={{ $imageViewer }}
image/jpeg={{ $imageViewer }}
image/png={{ $imageViewer }}
image/svg+xml={{ $imageViewer }}
image/tiff={{ $imageViewer }}
image/webp={{ $imageViewer }}
image/avif={{ $imageViewer }}
image/heif={{ $imageViewer }}
video/mp4=mpv.desktop
video/mpeg=mpv.desktop
video/ogg=mpv.desktop
video/webm=mpv.desktop
video/x-matroska=mpv.desktop
video/x-msvideo=mpv.desktop
video/quicktime=mpv.desktop
video/x-flv=mpv.desktop
application/pdf={{ $pdfViewer }}
inode/directory=org.kde.dolphin.desktop
