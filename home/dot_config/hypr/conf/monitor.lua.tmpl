{{- if eq .chezmoi.hostname "moinax-desktop" }}
-- LAYOUT: three_monitors
-- Left Monitor (DP-2) - Vertical
hl.monitor({ output = "DP-2", mode = "2560x1440",        position = "-1440x-500", scale = 1, transform = 1 })
-- Center Monitor (DP-3) - Horizontal.
hl.monitor({ output = "DP-3", mode = "3440x1440@174.96", position = "0x0",        scale = 1 })
-- Right Monitor (DP-1) - Vertical
hl.monitor({ output = "DP-1", mode = "2560x1440",        position = "3440x-500",  scale = 1, transform = 1 })
{{- else if eq .chezmoi.hostname "moinax-laptop" }}
-- Built-in 4K panel (Sharp 3840x2400 @ 60Hz, ~16"). Integer scale 2 gives a
-- 1920x1200 logical workspace — bigger text than 1.6 (2400x1500) and, being
-- integer, no XWayland blur. 1.92 (2000x1250) is the only clean step between
-- the two; anything else leaves a non-integer logical size.
hl.monitor({ output = "eDP-1", mode = "3840x2400@59.99", position = "auto", scale = 2 })
{{- else }}
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
{{- end }}
