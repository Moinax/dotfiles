hl.bind(mod .. " + A",            hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/audio-output?toggle=true'"))    -- Switch audio output
hl.bind(mod .. " + K",            hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/keyboard-layout?toggle=true'")) -- Switch keyboard layout
hl.bind(mod .. " + TAB",          hl.dsp.exec_cmd("vicinae 'vicinae://launch/wm/switch-windows?toggle=true'"))              -- Window switcher
hl.bind(mod .. " + Escape",       hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/kill-window?toggle=true'"))     -- Close or force-kill a window
hl.bind(mod .. " + V",            hl.dsp.exec_cmd("vicinae 'vicinae://launch/clipboard/history?toggle=true'"))              -- Clipboard history
hl.bind(mod .. " + SHIFT + P",    hl.dsp.exec_cmd("hyprpicker"))                                                            -- Color picker
hl.bind(mod .. " + R",            hl.dsp.exec_cmd("vicinae 'vicinae://launch/theme/set?toggle=true'"))                      -- Theme selector
hl.bind(mod .. " + M",            hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/monitors?toggle=true'"))        -- Toggle monitors on/off
