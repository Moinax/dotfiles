{{- end }}
{{- if .install_ai }}
hl.bind(mod .. " + D",            hl.dsp.exec_cmd(home .. "/.local/bin/toggle-dictation.sh"))                               -- Toggle dictation
-- Discard, the keyboard twin of the overlay's ✕. Safe to leave always live:
-- cancelling while idle is a no-op the daemon just logs and ignores. It cannot
-- live in the overlay itself — a layer surface that takes keyboard focus becomes
-- hyprvoice's injection target, so the dictation would land in the pill.
hl.bind(mod .. " + SHIFT + D",    hl.dsp.exec_cmd("hyprvoice cancel"))                                                      -- Cancel dictation (discard)
-- Whisper decides the language once per clip from the audio, then writes *in
-- it* — on accented English it picks French and translates rather than
-- mis-spells. These two are the switch: Alt for one clip (it puts the language
-- back on its own), Ctrl to stay there. dictation-lang carries the evidence.
hl.bind(mod .. " + ALT + D",      hl.dsp.exec_cmd(home .. "/.local/bin/toggle-dictation.sh --lang en"))                      -- Dictate one clip in English
hl.bind(mod .. " + CTRL + D",     hl.dsp.exec_cmd(home .. "/.local/bin/dictation-lang cycle"))                               -- Cycle dictation language (auto/fr/en)
{{- end }}

-- ── 2. Window Management ──────────────────────────────────────────
hl.bind(mod .. " + Q",       hl.dsp.window.close())                                       -- Close window
hl.bind(mod .. " + T",       hl.dsp.window.float({ action = "toggle" }))                  -- Toggle floating
hl.bind(mod .. " + ALT + T", hl.dsp.window.pseudo())                                      -- Toggle pseudotile (keeps its own size inside its tile)
hl.bind(mod .. " + F",       hl.dsp.window.fullscreen({ mode = "maximized" }))            -- Fullscreen (with bar)
hl.bind(mod .. " + ALT + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }))           -- True fullscreen
hl.bind(mod .. " + P",       hl.dsp.window.pin())                                         -- Pin window

-- ── 3. Focus Navigation ──────────────────────────────────────────
hl.bind(mod .. " + left",          hl.dsp.focus({ direction = "l" }))
hl.bind(mod .. " + right",         hl.dsp.focus({ direction = "r" }))
hl.bind(mod .. " + up",            hl.dsp.focus({ direction = "u" }))
hl.bind(mod .. " + down",          hl.dsp.focus({ direction = "d" }))
hl.bind(mod .. " + SHIFT + Tab",   hl.dsp.window.cycle_next({ next = false }))            -- Cycle prev window

-- ── 4. Move Window / Column ──────────────────────────────────────
-- Mod+Ctrl+Arrow: group-aware swap within the current monitor (in-group →
-- out, adjacent-group → in, else swap with the visual neighbor). Lua 0.55
-- has no single dispatcher for this, so we shell out; `hl.exec_cmd` is
-- async, so it's safe — an `io.popen` from a Lua bind would deadlock.
hl.bind(mod .. " + CTRL + right", hl.dsp.exec_cmd(home .. "/.local/bin/hypr-move-or-group.sh r")) -- Move window/group right
hl.bind(mod .. " + CTRL + left",  hl.dsp.exec_cmd(home .. "/.local/bin/hypr-move-or-group.sh l")) -- Move window/group left
hl.bind(mod .. " + CTRL + up",    hl.dsp.exec_cmd(home .. "/.local/bin/hypr-move-or-group.sh u")) -- Move window/group up
hl.bind(mod .. " + CTRL + down",  hl.dsp.exec_cmd(home .. "/.local/bin/hypr-move-or-group.sh d")) -- Move window/group down

-- Mod+Alt+Arrow: plain directional movewindow. No group entry/exit — when
-- the focus is inside a group, this moves the entire group container as
-- one unit through the tile tree. At the monitor edge, the window crosses
-- to the adjacent monitor automatically.
hl.bind(mod .. " + ALT + right",  hl.dsp.window.move({ direction = "r" }))
hl.bind(mod .. " + ALT + left",   hl.dsp.window.move({ direction = "l" }))
hl.bind(mod .. " + ALT + up",     hl.dsp.window.move({ direction = "u" }))
hl.bind(mod .. " + ALT + down",   hl.dsp.window.move({ direction = "d" }))

-- ── 5. Resize ────────────────────────────────────────────────────
hl.bind(mod .. " + SHIFT + right", hl.dsp.window.resize({ x =  30, y =   0, relative = true }), { repeating = true })
hl.bind(mod .. " + SHIFT + left",  hl.dsp.window.resize({ x = -30, y =   0, relative = true }), { repeating = true })
hl.bind(mod .. " + SHIFT + up",    hl.dsp.window.resize({ x =   0, y = -30, relative = true }), { repeating = true })
hl.bind(mod .. " + SHIFT + down",  hl.dsp.window.resize({ x =   0, y =  30, relative = true }), { repeating = true })

-- ── 6. Column / Group Operations ─────────────────────────────────
hl.bind(mod .. " + J",          hl.dsp.layout("togglesplit"))                              -- Toggle split (dwindle)
hl.bind(mod .. " + G",          hl.dsp.group.toggle())                                     -- Toggle group
hl.bind("ALT + TAB",            hl.dsp.group.next())                                       -- Cycle group forward
hl.bind("ALT + SHIFT + TAB",    hl.dsp.group.prev())                                       -- Cycle group backward
hl.bind("ALT + CTRL + TAB",     hl.dsp.group.move_window({ forward = true }))              -- Move window in group

-- ── 6b. Layout Switching ─────────────────────────────────────────
-- Scrolling layout reuses the standard focus / move / resize / group-swap
-- arrow binds above (focus, movewindow, group-swap script all work in both
-- layouts). Column-stacking ops (consume/expel/promote/inhibit/swapcol) and
-- viewport pan are unused.
hl.bind(mod .. " + SHIFT + T",       hl.dsp.exec_cmd(home .. "/.config/hypr/scripts/toggle-workspace-scrolling.sh")) -- Toggle tape (scrolling) layout ↔ baseline

-- ── 7. Workspace Navigation ──────────────────────────────────────
-- QWERTY 1-7
for i = 1, 7 do
    hl.bind(mod .. " + " .. tostring(i), hl.dsp.focus({ workspace = tostring(i) }))
end
-- AZERTY 1-7
local azerty_top_row = {
    [1] = "ampersand", [2] = "eacute", [3] = "quotedbl", [4] = "apostrophe",
    [5] = "parenleft", [6] = "minus",  [7] = "egrave",
}
for ws, key in pairs(azerty_top_row) do
    hl.bind(mod .. " + " .. key, hl.dsp.focus({ workspace = tostring(ws) }))
end
-- Relative prev/next workspace (scrolling up/down). `r±1` walks rule-defined
-- workspaces on the current monitor including empty ones — so on DP-3 (WS 1-5)
-- it cycles 1→2→3→4→5 even before those workspaces have any windows. `e±1`
-- would skip empty workspaces and jump straight to whatever's populated.
hl.bind(mod .. " + Page_Up",   hl.dsp.focus({ workspace = "r-1" }))
hl.bind(mod .. " + Page_Down", hl.dsp.focus({ workspace = "r+1" }))
-- Wheel inverted vs Page keys: scrolling up advances to next workspace
-- (natural-scroll feel, matches Waybar's default `on-scroll-up`).
hl.bind(mod .. " + mouse_up",   hl.dsp.focus({ workspace = "r+1" }))
hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "r-1" }))

-- ── 8. Move to Workspace ─────────────────────────────────────────
-- Convention: ALT = move with follow, CTRL = silent move (no follow).
-- QWERTY 1-7
for i = 1, 7 do
    hl.bind(mod .. " + ALT + "  .. tostring(i), hl.dsp.window.move({ workspace = tostring(i) }))
    hl.bind(mod .. " + CTRL + " .. tostring(i), hl.dsp.window.move({ workspace = tostring(i), follow = false }))
end
-- AZERTY 1-7
for ws, key in pairs(azerty_top_row) do
    hl.bind(mod .. " + ALT + "  .. key, hl.dsp.window.move({ workspace = tostring(ws) }))
    hl.bind(mod .. " + CTRL + " .. key, hl.dsp.window.move({ workspace = tostring(ws), follow = false }))
end
-- Relative prev/next (mirror of focus binds above).
hl.bind(mod .. " + ALT + Page_Up",      hl.dsp.window.move({ workspace = "r-1" }))
hl.bind(mod .. " + ALT + Page_Down",    hl.dsp.window.move({ workspace = "r+1" }))
hl.bind(mod .. " + CTRL + Page_Up",     hl.dsp.window.move({ workspace = "r-1", follow = false }))
hl.bind(mod .. " + CTRL + Page_Down",   hl.dsp.window.move({ workspace = "r+1", follow = false }))
hl.bind(mod .. " + ALT + mouse_up",     hl.dsp.window.move({ workspace = "r+1" }))
hl.bind(mod .. " + ALT + mouse_down",   hl.dsp.window.move({ workspace = "r-1" }))
hl.bind(mod .. " + CTRL + mouse_up",    hl.dsp.window.move({ workspace = "r+1", follow = false }))
hl.bind(mod .. " + CTRL + mouse_down",  hl.dsp.window.move({ workspace = "r-1", follow = false }))

-- Whole workspace at once: ALT and CTRL are already spent on the single-window
-- moves above, so SHIFT marks the bulk move and CTRL + SHIFT its silent twin.
-- What counts as "the workspace" — the scratchpad when it is the thing on
-- screen — is the script's business, and its header is where that is written.
local move_all = home .. "/.local/bin/hypr-move-all.sh "
-- QWERTY 1-7
for i = 1, 7 do
    hl.bind(mod .. " + SHIFT + "        .. tostring(i), hl.dsp.exec_cmd(move_all .. i))                -- Move every window to this workspace
    hl.bind(mod .. " + CTRL + SHIFT + " .. tostring(i), hl.dsp.exec_cmd(move_all .. i .. " --silent")) -- Move every window to this workspace (silent)
end
-- AZERTY 1-7
for ws, key in pairs(azerty_top_row) do
    hl.bind(mod .. " + SHIFT + "        .. key, hl.dsp.exec_cmd(move_all .. ws))                -- Move every window to this workspace
    hl.bind(mod .. " + CTRL + SHIFT + " .. key, hl.dsp.exec_cmd(move_all .. ws .. " --silent")) -- Move every window to this workspace (silent)
end

-- ── 10. Scratchpad (default unnamed special workspace) ──────────
-- The scratchpad has no home monitor of its own: every dispatcher that reveals
-- it shows it on whichever monitor is focused, dragging it off the one it was
-- on. A `monitor:` workspace rule on `special:special` does not hold it either
-- — it parses, and the workspace still moves. Focusing the monitor first is the
-- only thing that pins it, so the three revealing binds route through
-- ScratchpadToMain. The two `--silent` binds must reveal nothing and stay on
-- the plain dispatchers.
--
-- nil where there is nothing to pin to: a single-monitor host wants the plain
-- toggle, and every step below degrades to it on its own.
local scratchpad_monitor = {{ if eq .chezmoi.hostname "moinax-desktop" }}"DP-3"{{ else }}nil{{ end }}

-- Global on purpose: the shell chain in the Mod+Shift+S bind re-enters it
-- through `hyprctl eval` rather than restating the logic in shell.
function ScratchpadToMain()
    if scratchpad_monitor then hl.dispatch(hl.dsp.focus({ monitor = scratchpad_monitor })) end
    -- Unconditional would *hide* a scratchpad already up there.
    if not hl.get_active_special_workspace(scratchpad_monitor) then
        hl.dispatch(hl.dsp.workspace.toggle_special(""))
    end
end

-- Toggles both ways. The hide half still has to step onto the monitor — the
-- dispatcher only ever acts on the focused one — and hand focus straight back,
-- or dismissing the scratchpad from another screen would leave you typing into
-- this one.
hl.bind(mod .. " + S", function()                                                                                      -- Toggle scratchpad (pinned to DP-3)
    if hl.get_active_special_workspace(scratchpad_monitor) then
        local back = hl.get_active_monitor()
        if scratchpad_monitor then hl.dispatch(hl.dsp.focus({ monitor = scratchpad_monitor })) end
        hl.dispatch(hl.dsp.workspace.toggle_special(""))
        if back then hl.dispatch(hl.dsp.focus({ monitor = back.name })) end
    else
        ScratchpadToMain()
    end
end)
-- Move silently first, then reveal: a following move would show the scratchpad
-- on the monitor the window came from.
hl.bind(mod .. " + ALT + S", function()                                                                                -- Move to scratchpad
    hl.dispatch(hl.dsp.window.move({ workspace = "special", follow = false }))
    ScratchpadToMain()
end)
hl.bind(mod .. " + CTRL + S",  hl.dsp.window.move({ workspace = "special", follow = false }))                          -- Move to scratchpad (silent)
-- Chained in the shell rather than fired from Lua after `hl.exec_cmd`: that
-- call is async and hypr-move-all.sh reads the focused monitor to find its
-- source workspace, so a Lua-side reveal wins the race and the script empties
-- the wrong monitor (measured, not theorised). `hyprctl eval` exits non-zero on
-- a Lua error into a detached child nobody reads, hence the notify.
local reveal_scratchpad = " && { hyprctl eval 'ScratchpadToMain()' >/dev/null" ..
    " || notify-send -u critical 'Scratchpad' 'reveal failed — see ScratchpadToMain in binds.lua'; }"
hl.bind(mod .. " + SHIFT + S", hl.dsp.exec_cmd(move_all .. "special --silent" .. reveal_scratchpad))                   -- Move every window of the workspace to the scratchpad
hl.bind(mod .. " + CTRL + SHIFT + S", hl.dsp.exec_cmd(move_all .. "special --silent"))                                 -- Same, silent

