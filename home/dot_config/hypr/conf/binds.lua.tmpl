-- Hyprland Keybindings
-- See https://wiki.hypr.land/Configuring/Basics/Binds/ for more

local mod  = "SUPER"
local home = assert(os.getenv("HOME"), "HOME not set")

-- Launcher: vicinae. Every menu below reaches it through a `vicinae://` deeplink
-- rather than a script, which is the whole difference from the rofi binds these
-- replace — a rofi bind had to spawn a process that built a menu, piped it into
-- rofi and dispatched the result by exit code, so the menu logic lived in the
-- keybind's script. A deeplink just names a command the running server already
-- has; `?toggle=true` makes a second press close the window instead of
-- reopening it, which is what makes these feel like toggles rather than launches.
--
-- Nothing rofi is left on this branch: the scripts, themes, config and packages
-- all went with the binds. `main` still carries them, and switching between the
-- two branches is how the pair is compared.
--
-- ── 1. Application Shortcuts ──────────────────────────────────────
hl.bind(mod .. " + RETURN",       hl.dsp.exec_cmd("kitty"))                                                                 -- Open a terminal (plain kitty, a new window each time)
hl.bind(mod .. " + ALT + RETURN", hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/dev?toggle=true'"))             -- Pick main project & open dev workspace (Shift+Enter → worktrees)
hl.bind(mod .. " + CTRL + RETURN", hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/t3?toggle=true'"))            -- Pick a project & open/create a T3 Code thread
hl.bind(mod .. " + SPACE",        hl.dsp.exec_cmd("vicinae vicinae://toggle"))                                              -- Launcher (apps, files, maths, everything)
hl.bind(mod .. " + B",            hl.dsp.exec_cmd(home .. "/.local/bin/browser-launch.sh"))                                 -- Open default browser
hl.bind(mod .. " + ALT + B",      hl.dsp.exec_cmd("vicinae 'vicinae://launch/@moinax/moinax/browser?toggle=true'"))         -- Pick browser (default marked)
{{- /* `index` and not the bare `.install_messaging`: chezmoi errors on a missing
       key, and machines set up before the Messaging split have none until
