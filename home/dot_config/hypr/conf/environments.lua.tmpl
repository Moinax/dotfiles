-- Ensure ~/.local/bin is in PATH for all spawned processes
hl.env("PATH", (os.getenv("HOME") or "") .. "/.local/bin:" .. (os.getenv("PATH") or ""))

-- XDG Desktop Portal
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE",    "wayland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_MENU_PREFIX",     "plasma-")

-- Qt
hl.env("QT_QPA_PLATFORM",                  "wayland;xcb")
hl.env("QT_QPA_PLATFORMTHEME",             "kde")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR",      "1")

-- GTK
hl.env("GDK_SCALE", "1")

-- Mozilla
hl.env("MOZ_ENABLE_WAYLAND", "1")

{{ if stat "/proc/driver/nvidia" -}}
-- NVIDIA, per the Hyprland wiki's Nvidia page; the why is in
-- environment.d/60-nvidia.conf.
hl.env("LIBVA_DRIVER_NAME",         "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND",               "direct")
hl.env("MOZ_DISABLE_RDD_SANDBOX",   "1")

{{ end -}}
-- Cursor: white-toned on mocha, black-toned on latte (the suffix names the
-- cursor color, not the palette). hyprcursor falls back to xcursor.
{{ $cursor_theme := "catppuccin-mocha-dark-cursors" -}}
{{- if eq .dark_mode "light" }}{{ $cursor_theme = "catppuccin-latte-light-cursors" }}{{ end }}
hl.env("XCURSOR_THEME",   "{{ $cursor_theme }}")
hl.env("XCURSOR_SIZE",    "24")
hl.env("HYPRCURSOR_THEME","{{ $cursor_theme }}")
hl.env("HYPRCURSOR_SIZE", "24")

-- Ozone (Chromium / Electron)
hl.env("OZONE_PLATFORM", "wayland")

{{ if .install_development -}}
-- Let CodeBurn launched from the desktop read both Claude Code accounts.
local home = os.getenv("HOME") or ""
hl.env("CLAUDE_CONFIG_DIRS", home .. "/.claude:" .. home .. "/.claude-mbrella")
{{ end -}}

