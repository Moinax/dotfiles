# The same file the login greeter shows, so the two screens carry the picked
# wallpaper by construction rather than by two configs agreeing. Extension-less
# on purpose: hyprlock sniffs the content (hyprgraphics links libmagic), so a
# fixed `current.jpg` would lie the first time a .png is picked. Why it lives
# outside $HOME, and what creates it, are in CLAUDE.md.
background {
    monitor =
    path = /var/lib/wallpaper/current
}

# Everything below is dressed to match the Plasma login greeter, which is a
# different program on a different session (see the note in CLAUDE.md — a lock
# screen must hold the compositor's session-lock grab, so it can never *be* the
# greeter). Only the look is shared: Breeze accent #1d99f3 lifted from
# /usr/share/sddm/themes/breeze/theme.conf, Noto Sans as the Plasma UI font,
# clock over a centred name and password field. Deliberately no blur — the
# greeter blurs only while fading into the session, so a blurred lock screen
# would match the one state you never sit looking at.
input-field {
    monitor =
    size = 300, 50
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgba(1d99f3ff)
    inner_color = rgba(00000066)
    font_color = rgba(ffffffff)
    font_family = Noto Sans
    fade_on_empty = false
    placeholder_text = Password
    rounding = 12
    check_color = rgba(1d99f3ff)
    fail_color = rgba(da4453ff)
    fail_text = $FAIL (<b>$ATTEMPTS</b>)
    capslock_color = rgba(f67400ff)
    halign = center
    valign = center
    position = 0, -20
}

label {
    monitor =
    #clock
    # Bare $TIME, not `cmd[update:1000] echo "$TIME"` — hyprlock substitutes and
    # refreshes it itself (upstream's own sample does this), and the cmd form
    # forks a shell every second for as long as the screen stays locked.
    text = $TIME
    color = rgba(ffffffff)
    font_size = 64
    font_family = Noto Sans Light
    halign = center
    valign = top
    position = 0, -80
    shadow_passes = 3
    shadow_size = 6
}

label {
    monitor =
    #date — %-d drops the leading zero, the way the greeter's locale format does
    text = cmd[update:60000] date +"%A %-d %B"
    color = rgba(ffffffdd)
    font_size = 18
    font_family = Noto Sans
    halign = center
    valign = top
    position = 0, -175
    shadow_passes = 3
    shadow_size = 6
}

label {
    monitor =
    # $DESC is the GECOS full name ("Jérôme Poskin"), which is what the greeter
    # lists — $USER would read as the login name the greeter never shows.
    text = $DESC
    color = rgba(ffffffff)
    font_size = 20
    font_family = Noto Sans
    halign = center
    valign = center
    position = 0, 40
    shadow_passes = 3
    shadow_size = 6
}

{{ if and (hasKey . "has_fingerprint") .has_fingerprint -}}
# Talks to fprintd directly over D-Bus — independent from the PAM password stack,
# so password input stays responsive even while a scan is in progress.
# Only emitted when a fingerprint reader is present and fprintd support was both
# selected and installed. Enabling it without fprintd installed makes hyprlock
# hang on a D-Bus timeout AFTER a successful password auth, which wedges the
# session locked — so this block is gated, not unconditionally on.
auth {
    fingerprint {
        enabled = true
        ready_message = Scan fingerprint to unlock
        present_message = Scanning fingerprint...
        retry_delay = 250
    }
}
{{- end }}
