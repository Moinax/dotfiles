# Hyprvoice configuration
# https://github.com/LeonardoTrapani/hyprvoice
#
# First-time setup: run `hyprvoice onboarding`
# Edit interactively: run `hyprvoice configure`
# Download a local model: `hyprvoice model download large-v3-turbo`
#
# Config hot-reloads automatically when saved.

# ── Recording ──────────────────────────────────────────────────
[recording]
sample_rate = 16000              # 16 kHz — standard for Whisper speech recognition
channels = 1                     # Mono
format = "s16"                   # 16-bit signed integers
buffer_size = 8192               # Internal buffer size in bytes
device = ""                      # Empty = default PipeWire microphone
channel_buffer_size = 30         # Audio frame buffer size
timeout = "5m"                   # Maximum recording duration per toggle

# ── Transcription ───────────────────────────────────────────────
[transcription]
{{- $provider := "whisper-cpp" -}}
{{- if hasKey . "hyprvoice_provider" -}}
{{-   $provider = .hyprvoice_provider -}}
{{- end }}
provider = {{ $provider | quote }}
model = {{ .hyprvoice_model | quote }}    # Multilingual model (EN+FR).
language = ""                    # Empty = auto-detect. Set "en" or "fr" to force a language.
streaming = false
{{- if eq $provider "whisper-cpp" }}
threads = 0                      # 0 = auto (NumCPU - 1)
{{- end }}

# ── Providers ───────────────────────────────────────────────────
{{- if eq $provider "groq" }}
[providers.groq]
api_key = ""                     # Set GROQ_API_KEY env var instead (recommended)
{{- else }}
# [providers.groq]
# api_key = ""                   # Or set GROQ_API_KEY env var
{{- end }}

# ── LLM Post-Processing (requires API key) ─────────────────────
[llm]
enabled = false                  # Set to true + configure a provider below for text cleanup

# ── Text Injection ──────────────────────────────────────────────
[injection]
backends = ["wtype", "clipboard"]  # wtype auto-types; clipboard (copy-only) is a fallback.
                                 # NB: bare /usr/bin/wtype races the virtual-keymap upload
                                 # on Hyprland and injects number-row garbage ("12345…").
                                 # Fixed by the ~/.local/bin/wtype wrapper (adds `-s` sleep),
                                 # which shadows it in the service PATH. Keep that wrapper.
wtype_timeout = "5s"
clipboard_timeout = "3s"
ydotool_timeout = "5s"           # Unused (ydotool is not a backend above), but
                                 # the daemon validates every timeout at boot and
                                 # logs "invalid injection.ydotool_timeout: 0s"
                                 # when it is absent. Set so real warnings stand out.

# ── Notifications ───────────────────────────────────────────────
[notifications]
# `type` is what actually silences hyprvoice — "desktop", "log" or "none".
# `enabled = false` is IGNORED by hyprvoice v1.0.2: verified on the D-Bus
# Notify calls, with a freshly booted daemon, still firing "Recording Started".
# It is left set only to state the intent should upstream ever honour it; do not
# take it for the mechanism. Use "log" instead of "none" to keep the events in
# ~/.local/state/hyprvoice.log without popups.
#
# Silenced because the hyprvoice-widget.py overlay reports the same state live
# (level, elapsed, transcribing, muted mic), so the start/stop pair was pure
# duplication. Failures are not lost — the daemon log kept by
# toggle-dictation.sh records every one.
#
# Notifications are per-event if only errors are ever wanted back: set
# type = "desktop" again, then blank the chatty ones under
# [notifications.messages.<event>] (title/body). Events: recording_started,
# recording_aborted, transcribing, llm_processing, post_processing,
# injection_aborted, transcriber_error, operation_cancelled, config_reloaded,
# general.
#
# NB: a config hot-reload does not rebuild the notifier — it only restarts the
# pipeline. Changing anything here needs `hyprvoice stop` and a fresh daemon.
enabled = false
type = "none"
