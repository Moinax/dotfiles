# Hyprvoice configuration
# https://github.com/LeonardoTrapani/hyprvoice
#
# First-time setup: run `hyprvoice onboarding`
# Edit interactively: run `hyprvoice configure`
# Download a local model: `hyprvoice model download large-v3-turbo`
#
# Config hot-reloads automatically when saved.

# ── Vocabulary ──────────────────────────────────────────────────
# Top-level key, and it MUST stay above the first [table]: a bare TOML key
# lands in whatever table precedes it, so moving this down silently turns it
# into `recording.keywords` and it stops being read.
#
# This is the single biggest accuracy lever available here. The list is fed
# twice: to Whisper as its `prompt` (a spelling prior, ~224 tokens max — keep
# the list short) and to the LLM pass as "context keywords". The dictation is
# French prose carrying English tool names, and with no prior Whisper spells
# those names the way a French speaker would hear them — worktree became
# "WordTree", pane "pays", tab "table", Claude "Cloud", vibewatch "time watch",
# `wt switch` "WTS". Every one of those is a name that appears nowhere in the
# model's training data, which is exactly what a prompt hint is for.
keywords = [
  # Desktop stack
  "Hyprland", "Waybar", "chezmoi", "CachyOS", "PipeWire", "kitty", "yazi",
  "nvim", "vicinae", "starship", "lazygit",
  # Missing from this list, "RNNoise" came back as "hermose" — and the cleanup
  # pass then "fixed" that to Hyprland, which IS listed. A name absent here is
  # not merely left alone; it gets pulled toward whichever name is present.
  "RNNoise",
  # Home-grown commands — no language model has ever seen these
  "zellij", "hunk", "tuicr", "vibewatch", "worktrunk", "hyprvoice", "dotfiles",
  # As a phrase, not just "chezmoi": spoken /ʃemwa/ it lands one vowel from
  # "schéma", and that is a far commoner French word — the bare term lost to it
  # in a real dictation. The two-word form gives Whisper a longer target.
  "chezmoi apply",
  # Git / worktree
  "worktree", "wt switch", "wt remove", "branch", "commit", "rebase", "diff",
  "pull request", "repo", "checkout",
  # Multiplexer
  "pane", "tab", "workspace", "layout", "session", "daemon", "socket",
  # Agents
  "Claude Code", "Claude", "agent", "subagent", "prompt", "transcript",
  "hook", "Linear", "ticket",
  # Config
  "TOML", "YAML", "template", "keybinding", "dispatch", "statusline",
]

# ── Recording ──────────────────────────────────────────────────
[recording]
sample_rate = 16000              # 16 kHz — standard for Whisper speech recognition
channels = 1                     # Mono
format = "s16"                   # 16-bit signed integers
buffer_size = 8192               # Internal buffer size in bytes
device = ""                      # Empty = follow the PipeWire default source, and
                                 # it has to stay empty: the Mod+D overlay's mic
                                 # picker works by calling `pactl
                                 # set-default-source`, so pinning a node here
                                 # overrides the picker and makes it a no-op.
                                 # hyprvoice-widget.py's pinned_device() checks
                                 # for exactly that and greys the picker out.
                                 #
                                 # Whichever mic is picked is a deliberate
                                 # choice, not a misconfiguration — but a
                                 # far-field one (the webcam) does cost real
                                 # accuracy, and no model setting recovers a
                                 # word the mic never captured. That is what the
                                 # LLM pass below is there to absorb.
channel_buffer_size = 30         # Audio frame buffer size
timeout = "5m"                   # Maximum recording duration per toggle

# ── Transcription ───────────────────────────────────────────────
[transcription]
{{- $provider := "whisper-cpp" -}}
{{- if hasKey . "hyprvoice_provider" -}}
{{-   $provider = .hyprvoice_provider -}}
{{- end }}
provider = {{ $provider | quote }}
model = {{ .hyprvoice_model | quote }}    # Multilingual model (EN+FR).

# Whisper picks a language once per clip, from the audio alone, and then writes
# *in it* — so a wrong pick is not a spelling error, it is a translation. Both
# halves of that are measured, not inferred: forcing "fr" on English audio
# returns "Et donc, mes collègues américains, ne demandez pas ce que votre pays
# peut faire pour vous" (Groq API, whisper.cpp's jfk.wav), and auto-detect does
# the same thing to French-accented English on its own — hyprvoice.log has "Ok,
# pour Prettier, vous pouvez créer un ticket Linear…" leaving the *transcriber*,
# with the LLM pass echoing it back unchanged. Nothing downstream can undo that;
# the English is already gone.
#
# `keywords` above is not a lever on it either way: a French *prose* prompt
# leaves a confidently-English clip in English, same clip, measured. Only this
# field moves it, and hyprvoice has no per-clip flag for it — so the switch is
# ~/.local/bin/dictation-lang, which patches the line below in place and waits
# out the ~1s hot-reload. Mod+Ctrl+D cycles auto → fr → en and remembers it,
# Mod+Alt+D dictates one clip in English and puts this back afterwards. Neither
# ever writes mid-dictation: a reload calls stopPipeline(), so that would not
# reconfigure the recording, it would destroy it.
#
# Empty stays the right default — auto-detect holds French correctly even on
# openers like "Hello comment ça va", and pinning "fr" permanently would only
# trade this bug for its mirror image on every English dictation.
#
# Templated from the same state file the switch writes, so `chezmoi apply`
# reproduces the current choice. Without that it would reset the language to
# auto mid-session, silently, on any `dots update` that touches dotfiles.
{{- $state := printf "%s/hyprvoice-lang" (env "XDG_STATE_HOME" | default (printf "%s/.local/state" .chezmoi.homeDir)) -}}
{{- $sticky := "" -}}
{{- if stat $state }}{{ $sticky = output "cat" $state | trim }}{{ end }}
language = {{ if or (eq $sticky "fr") (eq $sticky "en") }}{{ $sticky | quote }}{{ else }}""{{ end }}
streaming = false
{{- if eq $provider "whisper-cpp" }}
threads = 0                      # 0 = auto (NumCPU - 1)
{{- end }}

# ── Providers ───────────────────────────────────────────────────
{{- if eq $provider "groq" }}
[providers.groq]
api_key = ""                     # Set GROQ_API_KEY env var instead (recommended)
{{- else }}
# [providers.groq]
# api_key = ""                   # Or set GROQ_API_KEY env var
{{- end }}

# ── LLM Post-Processing (requires API key) ─────────────────────
# The second half of what a Wispr Flow does: Whisper hears, an LLM then repairs.
# Reuses GROQ_API_KEY (same key as the transcription provider), and costs one
# extra round trip — ~0.5-1.5s on top of the ~1s transcription. Drop to
# "llama-3.1-8b-instant" if that tail is felt; it fixes the obvious phonetic
# mistakes but reconstructs truncated words far less well.
#
# Note this only ever repairs what Whisper produced. It cannot recover a word
# that was never captured, which is why `keywords` above and a close mic matter
# more than anything set here.
[llm]
enabled = true
provider = "groq"
model = "llama-3.3-70b-versatile"

  [llm.post_processing]
  remove_stutters = true         # "avec avec le renommage" → "avec le renommage"
  remove_filler_words = true
  add_punctuation = true         # Whisper drops it entirely on long clips
  fix_grammar = true             # Also what repairs mis-heard words from context

  [llm.custom_prompt]
  enabled = true                 # Without this the prompt below is loaded and ignored
  # Written in English on purpose, and it is not a style preference. An earlier
  # draft of this prompt was in French and it translated every English dictation
  # into French — verified, both directions. The prompt's own language is a far
  # stronger signal to the model than any "never translate" it contains, so the
  # instruction has to sit in a language that favours neither input. It matches
  # hyprvoice's built-in system prompt, which is English too.
  #
  # The mis-hearings below are real ones lifted from ~/.local/state/hyprvoice.log.
  # Add to that list rather than generalising it: concrete pairs correct far more
  # reliably than a description of the failure.
  #
  # "never delete a word you cannot fix" is not padding. Caught live: Whisper
  # heard "chezmoi apply" as "schéma Apply", and the model's response was to drop
  # "Apply" and emit a fluent "le schéma" — turning a repairable mis-hearing into
  # a clean sentence that had lost the point. Deleting always reads as better
  # prose than guessing, so left to itself the cleanup pass optimises for
  # fluency over fidelity. hyprvoice's built-in "Do not remove meaningful
  # content" did not stop it; this does.
  #
  # What it does NOT stop is the opposite failure: on a garbled name the model
  # now substitutes rather than deletes, reaching into the keyword list for
  # something plausible ("le hermose" → Hyprland). Two stricter prompts were
  # measured against this and both cost more than they saved — forbidding
  # substitution outright also stopped the explicit pairs above from applying,
  # and on heavily clipped input the model destabilised (it once emitted
  # Cyrillic mid-sentence). So the substitution stays, bounded by measurement:
  # a name Whisper transcribes CORRECTLY is never touched, listed or not.
  # Only already-garbled words get replaced. That makes this a transcription
  # problem, not a cleanup one — the fix for a new tool name is to add it to
  # `keywords` above so Whisper hears it, never to fight the model here.
  #
  # 520 chars, deliberately past the 500 the `hyprvoice configure` TUI enforces
  # on this field. Nothing validates it on load, and the config is edited here
  # rather than in the TUI — worth knowing only if that screen is ever opened.
  prompt = """
A developer dictating about their dev setup (terminal, git, Claude Code). French or English — write it back in the language spoken, never translate. English tool names get transcribed phonetically as French; restore the real spelling (WordTree → worktree, pays/pain → pane, à table → the tab, Cloud → Claude, WTS → wt switch, time watch → vibewatch, linéaire → Linear, schéma apply → chezmoi apply). Rebuild clipped words from context; never delete a word you cannot fix. Keep the spoken tone; never answer or summarise.
"""

# ── Text Injection ──────────────────────────────────────────────
[injection]
backends = ["wtype", "clipboard"]  # wtype auto-types; clipboard (copy-only) is a fallback.
                                 # NB: bare /usr/bin/wtype races the virtual-keymap upload
                                 # on Hyprland and injects number-row garbage ("12345…").
                                 # Fixed by the ~/.local/bin/wtype wrapper (adds `-s` sleep),
                                 # which shadows it in the service PATH. Keep that wrapper.
wtype_timeout = "5s"
clipboard_timeout = "3s"
ydotool_timeout = "5s"           # Unused (ydotool is not a backend above), but
                                 # the daemon validates every timeout at boot and
                                 # logs "invalid injection.ydotool_timeout: 0s"
                                 # when it is absent. Set so real warnings stand out.

# ── Notifications ───────────────────────────────────────────────
[notifications]
# `type` is what actually silences hyprvoice — "desktop", "log" or "none".
# `enabled = false` is IGNORED by hyprvoice v1.0.2: verified on the D-Bus
# Notify calls, with a freshly booted daemon, still firing "Recording Started".
# It is left set only to state the intent should upstream ever honour it; do not
# take it for the mechanism. Use "log" instead of "none" to keep the events in
# ~/.local/state/hyprvoice.log without popups.
#
# Silenced because the hyprvoice-widget.py overlay reports the same state live
# (level, elapsed, transcribing, muted mic), so the start/stop pair was pure
# duplication. Failures are not lost — the daemon log kept by
# toggle-dictation.sh records every one.
#
# Notifications are per-event if only errors are ever wanted back: set
# type = "desktop" again, then blank the chatty ones under
# [notifications.messages.<event>] (title/body). Events: recording_started,
# recording_aborted, transcribing, llm_processing, post_processing,
# injection_aborted, transcriber_error, operation_cancelled, config_reloaded,
# general.
#
# NB: a config hot-reload does not rebuild the notifier — it only restarts the
# pipeline. Changing anything here needs `hyprvoice stop` and a fresh daemon.
enabled = false
type = "none"
