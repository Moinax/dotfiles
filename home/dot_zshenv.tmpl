# This file is sourced for all zsh shells (interactive and non-interactive)
# Perfect for PATH configuration needed by VS Code and other tools

# Pnpm. Globally installed binaries (pnpx, pnx, ...) land in $PNPM_HOME/bin, so
# that subdir is the one that has to be on PATH. $PNPM_HOME itself only holds
# bin/, global/ and store/ here — `pnpm` comes from fnm, not from pnpm's
# standalone installer that would drop the executable directly in PNPM_HOME.
export PNPM_HOME="$HOME/.local/share/pnpm"
for _pnpm_dir in "$PNPM_HOME" "$PNPM_HOME/bin"; do
  case ":$PATH:" in
    *":$_pnpm_dir:"*) ;;
    *) export PATH="$_pnpm_dir:$PATH" ;;
  esac
done
unset _pnpm_dir

# fnm (Node.js version manager)
export FNM_PATH="$HOME/.local/share/fnm"
if [[ -d "$FNM_PATH" ]]; then
  export PATH="$FNM_PATH:$PATH"
  if [[ -o interactive ]]; then
    eval "$(fnm env --use-on-cd --shell zsh)"
  else
    # Non-interactive shells (Claude Code's `zsh -c`, VS Code tasks): put the
    # default Node version's real bin on PATH directly. Skip fnm's per-shell
    # `fnm env` multishell + `--use-on-cd` chpwd hook, which race with Claude
    # Code's shell snapshot: .zshenv creates a fresh multishell, then the
    # snapshot replays an older PATH without it, so `fnm use` (fired on cd)
    # warns "the current Node.js path is not on your PATH".
    _fnm_default="$FNM_PATH/aliases/default/bin"
    [[ -x "$_fnm_default/node" ]] && export PATH="$_fnm_default:$PATH"
    unset _fnm_default
  fi
fi

# Cargo (worktrunk, vibewatch, etc.)
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Vite+ (t3code's build toolchain). The official global CLI delegates project
# commands to each workspace's local vite-plus package. Its installer appends
# the same line to shell rc files that chezmoi owns, so keep it here instead.
if [[ -f "$HOME/.config/vite-plus/env" ]]; then
  source "$HOME/.config/vite-plus/env"
elif [[ -f "$HOME/.vite-plus/env" ]]; then
  source "$HOME/.vite-plus/env"
fi
case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) [[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH" ;;
esac

# Lazy docker, zoxide, ...
export PATH="$HOME/.local/bin:$PATH"

{{ if .install_development }}
# Nix project environments. The daemon profile script defines NIX_PROFILES and
# any installer-specific environment needed by `nix`, including in non-login
# shells opened by agents and editors. Preserve the PATH assembled above: Nix is
# complementary, so its otherwise-prepended profile bins are appended and cannot
# shadow CachyOS tools outside `nix develop`.
if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  _nix_path_before="$PATH"
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  _nix_path_from_profile="$PATH"
  export PATH="$_nix_path_before"
  for _nix_dir in ${(s/:/)_nix_path_from_profile}; do
    [[ -n "$_nix_dir" ]] || continue
    case ":$PATH:" in
      *":$_nix_dir:"*) ;;
      *) export PATH="${PATH:+$PATH:}$_nix_dir" ;;
    esac
  done
  unset _nix_dir _nix_path_before _nix_path_from_profile
fi
{{ end }}

# Silence zoxide's "configuration issue" doctor. It fires a false positive in
# Claude Code's Bash tool: the shell snapshot replays zoxide's `cd` wrapper but
# not the `chpwd_functions+=(__zoxide_hook)` line from `zoxide init`, so the
# doctor sees a missing hook on every command. Zoxide still works fine.
export _ZO_DOCTOR=0

# o27 socle dev secrets: passphrase-less key for non-interactive sops decrypt
export SOPS_AGE_SSH_PRIVATE_KEY_FILE="$HOME/.ssh/o27_socle_sops"
{{- if .install_hyprland }}
# Rofi scripts
{{- end }}
