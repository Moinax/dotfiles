{{- if .install_development -}}
#!/bin/bash
# Converge canonical Claude Code settings into ~/.claude/settings.json, then
# make the marketplaces and plugins they declare actually exist on this machine.
# create_settings.json.tmpl only applies when the target file is missing, so
# machines where it already exists never pick up later edits — this script
# jq-merges the canonical keys on every change while leaving machine-specific
# keys (model, theme, ...) untouched. Hooks ARE canonical (vibewatch), so a
# wiped settings.json gets them back on the next apply.
set -e

# Bail out if jq is not available
if ! command -v jq &>/dev/null; then
    echo "claude-settings: jq not found, skipping Claude Code settings convergence"
    exit 0
fi

# Canonical settings, inlined from dot_claude/create_settings.json at chezmoi
# render time — editing that file changes this script's content, which is what
# re-triggers the run_onchange execution.
CANONICAL='{{ includeTemplate "dot_claude/create_settings.json.tmpl" . }}'

# Two config dirs, one per subscription: ~/.claude is the personal account,
# ~/.claude-mbrella the Mbrella one, reached through CLAUDE_CONFIG_DIR (T3 Code
# sets it per provider instance). Identity lives in each dir's .claude.json and
# .credentials.json; everything else — CLAUDE.md, skills, agents, plugins — is a
# symlink back into ~/.claude (dot_claude-mbrella/), so only settings.json
# needs converging twice: Claude Code writes it in place, so a symlink there
# would be replaced by a plain file on the first `/config` edit.
for dir in "$HOME/.claude" "$HOME/.claude-mbrella"; do
    settings="$dir/settings.json"
    mkdir -p "$dir"
    # A new dir starts as a copy of the personal one so the machine-local keys
    # (model, theme, locally enabled plugins) carry over; ~/.claude comes first
    # in the loop, so on a fresh machine it exists by the time this runs.
    [ -f "$settings" ] || cp "$HOME/.claude/settings.json" "$settings" 2>/dev/null || echo '{}' > "$settings"
    # Merge into existing settings (jq * operator does a recursive merge)
    tmp=$(mktemp)
    if jq --argjson canonical "$CANONICAL" '. * $canonical' "$settings" > "$tmp"; then
        mv "$tmp" "$settings"
        chmod 644 "$settings"
        echo "claude-settings: canonical Claude Code settings converged into $settings"
    else
        rm -f "$tmp"
        echo "claude-settings: failed to update $settings"
        exit 1
    fi
done

# Declaring a plugin in enabledPlugins only *enables* it — it never installs it,
# and nothing else in the pipeline runs `claude plugin install`. Left at the
# merge above, a fresh machine ends up with the marketplaces cloned and not one
# plugin installed, silently: `claude plugin list` simply omits them. So drive
# both off the canonical settings here, which is what makes the declaration
# self-sufficient. Additive only, mirroring the merge: a plugin dropped from
# CANONICAL is left installed rather than uninstalled behind the user's back.
if ! command -v claude &>/dev/null; then
    echo "claude-settings: claude not found, skipping plugin reconciliation"
    exit 0
fi

known=$(claude plugin marketplace list --json 2>/dev/null | jq -r '.[].name')
# Filled by the loop below with the marketplaces it DELIBERATELY skipped, and
# read by the plugin loop after it. Deliberately, and never "absent from the
# list I read": `claude plugin marketplace list` failing, or its JSON shape
# moving under the jq below, empties $known — and a filter built on that would
# then skip every plugin on the machine while printing a message that says
# nothing is wrong. Attempting the install and failing out loud is the honest
# answer to a state this script cannot explain.
absent=""
while IFS=$'\t' read -r name kind source; do
    if [ -z "$name" ] || grep -qxF "$name" <<<"$known"; then continue; fi
    # A directory marketplace whose repo is not checked out here is not an
    # error — that machine just does not have it, and `add` would only fail.
    if [ "$kind" = "directory" ] && [ ! -d "$source" ]; then
        echo "claude-settings: marketplace '$name' skipped ($source not on this machine)"
        absent+="$name"$'\n'
        continue
    fi
    claude plugin marketplace add "$source" >/dev/null \
        && echo "claude-settings: registered marketplace '$name'" \
        || echo "claude-settings: failed to register marketplace '$name'"
done < <(jq -r '.extraKnownMarketplaces // {} | to_entries[]
                | [.key, .value.source.source, (.value.source.repo // .value.source.path)] | @tsv' <<<"$CANONICAL")

installed=$(claude plugin list --json 2>/dev/null | jq -r '.[].id')
while read -r id; do
    if [ -z "$id" ] || grep -qxF "$id" <<<"$installed"; then continue; fi
    # A plugin whose marketplace was skipped just above cannot install, and
    # reporting it as "failed" on every run reads as something broken rather
    # than as this machine simply not having that checkout. The droplet is where
    # this bites: mbrella is a directory marketplace under ~/Projects.
    if [ -n "$absent" ] && grep -qxF "${id##*@}" <<<"$absent"; then
        echo "claude-settings: plugin '$id' skipped (marketplace not on this machine)"
        continue
    fi
    # -y: a marketplace-declared install command prompts, and this runs headless
    # under `dots update` where stdin is not a TTY.
    claude plugin install "$id" -y >/dev/null \
        && echo "claude-settings: installed plugin '$id'" \
        || echo "claude-settings: failed to install plugin '$id'"
done < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' <<<"$CANONICAL")
{{- else -}}
#!/bin/bash
# Development group not selected — nothing to do
{{- end }}
