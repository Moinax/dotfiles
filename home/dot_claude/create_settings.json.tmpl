{
  "statusLine": {
    "type": "command",
    {{- /* Direct binary, never `npx -y ccstatusline@latest`: npx re-resolves
           @latest and boots a second node process on every refresh (0.44s CPU
           vs 0.15s), which multiplies by the number of live sessions. The fnm
           `default` alias is a stable symlink across node upgrades. */}}
    "command": "~/.local/share/fnm/aliases/default/bin/ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "mbrella@mbrella": true,
    "worktrunk@worktrunk": true,
    "context7@claude-plugins-official": true,
    {{- /* mattpocock-skills also ships in claude-plugins-official, but pinned
           to a catalog SHA — sourcing its own marketplace tracks main instead.
           ponytail is not in the official catalog at all, and only works in
           plugin form: its ruleset arrives through lifecycle hooks, so a bare
           SKILL.md in ~/.claude/skills/ never self-activates. Those hooks need
           `node` on PATH (fnm provides it). Per-repo `/setup-matt-pocock-skills`
           is still a manual step — it writes into each project, not into $HOME. */}}
    "mattpocock-skills@mattpocock": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "mbrella": {
      "source": {
        "source": "directory",
        "path": "/home/moinax/Projects/mbrella/ai-skills"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "auto"
  },
  {{- /* Hooks: vibewatch, one per event, mirroring `vibewatch install`'s merge
         (the CLI subcommand is the kebab-cased event name). PermissionRequest
         is the one sync hook, as vibewatch installs it. */}}
  {{- /* Built as data and serialized, not printed as text: hand-placed commas
         between a variable number of hook objects is the one part of this that
         can emit invalid JSON. This carried a second family (herdr-agent-title,
         on SessionStart and Stop) until herdr was retired, and a second family
         is one more `if` here. */}}
  {{- $vibe_events := list }}
  {{- if .install_vibewatch }}
  {{-   $vibe_events = list "PermissionRequest" "PostToolUse" "PreToolUse" "SessionStart" "Stop" "SubagentStop" "UserPromptSubmit" }}
  {{- end }}
  {{- $hooks := dict }}
  {{- range $event := $vibe_events | uniq | sortAlpha }}
  {{-   $cmds := list }}
  {{-   if has $event $vibe_events }}
  {{-     $vibe := dict "type" "command" "command" (printf "~/.cargo/bin/vibewatch notify %s --agent claude-code" (kebabcase $event)) }}
  {{-     if ne $event "PermissionRequest" }}{{ $vibe = set $vibe "async" true }}{{ end }}
  {{-     $cmds = append $cmds $vibe }}
  {{-   end }}
  {{-   $hooks = set $hooks $event (list (dict "matcher" "" "hooks" $cmds)) }}
  {{- end }}
  "hooks": {{ $hooks | toPrettyJson | indent 2 | trim }}
}
