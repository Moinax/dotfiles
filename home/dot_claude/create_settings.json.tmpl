{
  "statusLine": {
    "type": "command",
    {{- /* Direct binary, never `npx -y ccstatusline@latest`: npx re-resolves
           @latest and boots a second node process on every refresh (0.44s CPU
           vs 0.15s), which multiplies by the number of live sessions. The fnm
           `default` alias is a stable symlink across node upgrades. */}}
    "command": "~/.local/share/fnm/aliases/default/bin/ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "mbrella@mbrella": true,
    "worktrunk@worktrunk": true,
    "context7@claude-plugins-official": true,
    {{- /* ponytail is not in the official catalog at all, and only works in
           plugin form: its ruleset arrives through lifecycle hooks, so a bare
           SKILL.md in ~/.claude/skills/ never self-activates. Those hooks need
           `node` on PATH (fnm provides it). */}}
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "mbrella": {
      "source": {
        "source": "directory",
        "path": "/home/moinax/Projects/mbrella/ai-skills"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": { "instructionFiles": "claude-md-and-agents-md" }
    }
  },
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "auto"
  },
  {{- /* Hooks: vibewatch, one per event, mirroring `vibewatch install`'s merge
         (the CLI subcommand is the kebab-cased event name). PermissionRequest
         is the one sync hook, as vibewatch installs it. */}}
  {{- /* Built as data and serialized, not printed as text: hand-placed commas
         between a variable number of hook objects is the one part of this that
         can emit invalid JSON. A second family — this carried herdr-agent-title
         on SessionStart and Stop until herdr was retired — is one more range
         over the same dict, which is why the shape stays even at one. */}}
  {{- $hooks := dict }}
  {{- if .install_vibewatch }}
  {{-   range $event := list "PermissionRequest" "PostToolUse" "PreToolUse" "SessionStart" "Stop" "SubagentStop" "UserPromptSubmit" }}
  {{-     $vibe := dict "type" "command" "command" (printf "~/.cargo/bin/vibewatch notify %s --agent claude-code" (kebabcase $event)) }}
  {{-     if ne $event "PermissionRequest" }}{{ $vibe = set $vibe "async" true }}{{ end }}
  {{-     $hooks = set $hooks $event (list (dict "matcher" "" "hooks" (list $vibe))) }}
  {{-   end }}
  {{- end }}
  {{- /* The Language rule of ~/.agents/AGENTS.md is loaded once at session start
         and gets outweighed in long English-heavy sessions (code, tool output,
         English tickets), so it is restated on every prompt. No apostrophe in
         the text: run_onchange_configure-claude-settings.sh.tmpl inlines this
         JSON inside a single-quoted bash string. */}}
  {{- $language := dict "type" "command" "command" "echo \"Language: write every piece of prose addressed to the user in the language of the user message above (French or English): the final answer, and also each progress update between tool calls. This holds whatever the language of the code, tool output, skills or earlier replies. Code, identifiers, commit messages and files stay in English (~/.agents/AGENTS.md, Language).\"" }}
  {{- $hooks = set $hooks "UserPromptSubmit" (append (default (list) (get $hooks "UserPromptSubmit")) (dict "matcher" "" "hooks" (list $language))) }}
  "hooks": {{ $hooks | toPrettyJson | indent 2 | trim }}
}
