#!/usr/bin/env bash
# Maintain the local T3 Code fork: rebase our patches onto upstream, then build
# the AppImage and point the desktop at it. This is the only thing that installs
# T3 Code — `dots apps` deliberately tracks no source for it, so nothing else
# ever writes that AppImage.
#
#   t3fork update       take in origin, rebase the fork branch onto upstream,
#                       then offer to publish it (force-with-lease, asks first)
#   t3fork install      build a Linux AppImage, install it as the launcher's
#                       T3 Code, then offer to restart onto it
#     -y, --yes         restart without asking (for unattended runs)
#     -n, --no-restart  install only, leave the running app alone
#   t3fork restart      restart T3 Code onto the installed AppImage as-is
#
# Test changes with `vp run dev:desktop` in the repo before `install` —
# that is the e2e loop; this script only ships what already works.
set -euo pipefail

repo="${T3CODE_REPO:-$HOME/Projects/labs/t3code}"
branch="${T3CODE_FORK_BRANCH:-moinax}"

# $app_name is what `dots apps` slugifies, and the slug is what names every
# file it owns — so "T3 Code" is what makes $target the path it is. The two are
# one decision written twice; change the name and $target has to follow.
app_name="T3 Code"
target="$HOME/.local/share/AppImages/t3-code.AppImage"

[[ -d "$repo" ]] || { echo "t3fork: no repo at $repo" >&2; exit 1; }

# Every process of the running app answers to `t3code`, zygotes and renderers
# included; the one to signal is the root, whose parent is not one of them.
# Signalling that alone lets Electron run its own shutdown (it flushes state on
# before-quit) instead of having its children pulled out from under it.
t3code_root_pids() {
  local all pid parent
  all="$(pgrep -x t3code || true)"
  [[ -n "$all" ]] || return 0
  while read -r pid; do
    parent="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    grep -qx "${parent:-0}" <<<"$all" || printf '%s\n' "$pid"
  done <<<"$all"
}

# Spawn detached from this process tree *and* from its cgroup.
#
# The desktop launches T3 Code into a systemd scope (`app-t3code-N.scope`), and
# everything started from inside it — this script, an agent's shell, whatever
# they spawn — inherits that cgroup. When the app goes down systemd tears the
# scope down and kills every process still in it, so a relauncher started with
# plain `setsid` dies with the app it was waiting for: `setsid` makes a new
# POSIX session, which is not a new cgroup. That is exactly what happened the
# first time this was tried — clean kill, no relaunch.
#
# `systemd-run --user` puts it in a transient unit of its own instead. setsid
# remains the fallback for a machine with no systemd, where nothing tears a
# cgroup down and it is sufficient.
#
# `ELECTRON_RUN_AS_NODE` is dropped on the way out: T3 Code exports it to every
# process it spawns, so an agent shell inside it hands the variable to whatever
# it launches — and an Electron app started with it set runs as plain Node and
# tries to execute its first argument as a script. systemd-run happens to dodge
# this by starting from the user manager's environment rather than ours, but the
# setsid fallback would inherit it, so clear it for both instead of relying on
# which branch ran.
spawn_detached() {
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --user --collect --quiet -- "$@" >/dev/null 2>&1 && return
  fi
  setsid -f env -u ELECTRON_RUN_AS_NODE "$@" >/dev/null 2>&1 </dev/null
}

# Ask, where there is somebody to ask. No terminal is the same answer as
# declining — same outcome, same next step — but not the same *reason*, and the
# three call sites had drifted on saying so: two distinguished them, the third
# reported a decision nobody made. Returns 0 for yes and echoes the reason for a
# no, so a caller can print its own next step after it.
ask_yes() {
  local reply=""
  if [[ ! -t 0 ]]; then
    echo "t3fork: not a terminal; answering no to \"$1\""
    return 1
  fi
  read -r -p "$1 [y/N] " reply || reply=""
  [[ "$reply" =~ ^[Yy]$ ]]
}

# `dots` is resolved, never assumed on PATH: an agent shell inside T3 Code
# replays a PATH snapshot older than ~/.local/bin, and that is the context this
# tool is most often run from. Written once because `install` needs it too, and
# the copy that did not have it answered "dots not found" in exactly the case
# the fallback exists for.
resolve_dots() {
  local d
  for d in "$(command -v dots || true)" "$HOME/.local/bin/dots"; do
    if [[ -x "$d" ]]; then printf '%s\n' "$d"; return 0; fi
  done
  return 1
}

# Restart the installed app. Normally runs *inside* T3 Code — an agent in a
# thread, whose whole process tree hangs off the app being replaced — so the
# relaunch is detached before the signal goes out, never after.
restart_app() {
  local pids
  pids="$(t3code_root_pids)"
  if [[ -z "$pids" ]]; then
    echo "t3fork: T3 Code is not running; launching it"
    spawn_detached "$target"
    return
  fi

  # The waiter polls rather than `wait`s: it is not the parent of what it
  # watches. The ceiling matters because a hung quit must not leave the desktop
  # with no T3 Code at all — after it, relaunch regardless.
  spawn_detached bash -c '
    for _ in $(seq 1 40); do
      pgrep -x t3code >/dev/null || break
      sleep 0.5
    done
    exec "$1"
  ' _ "$target"

  echo "t3fork: restarting T3 Code"
  # shellcheck disable=SC2086
  kill -TERM $pids 2>/dev/null || true
}

cd "$repo"

# Tell `dots update`'s fork check what this fork is, so its report names the
# command that does the whole job rather than a bare rebase that would leave the
# installed AppImage untouched — and measures the drift against the branch that
# actually carries our patches rather than whatever is checked out.
#
# The keys live in this checkout's .git/config, which no backup and no clone
# carries, so re-asserting them is what makes them survive a fresh checkout.
register_fork_config() {
  git config dotfiles.forkUpdate "t3fork update && t3fork install"
  git config dotfiles.forkBranch "$branch"
}

# Outside the case, and non-fatal, deliberately. Registering only in `update`
# made the keys unreachable in practice: they exist to tell you which command to
# run *before* you have run it, so the command they name cannot be the only one
# that writes them — the very first `dots update` after they landed reported a
# bare `git rebase`, since no `t3fork update` had run in between. Every
# subcommand asserts them now, and failing to write one costs a degraded report
# line, never the run the user actually asked for.
register_fork_config || true

# A rebase that stopped on a conflict leaves HEAD detached partway through the
# replay, and *nothing else here notices*: the branch ref is only moved when the
# rebase completes, so `moinax` still points at its old tip and every count taken
# from it — `dots update`'s fork report included — reads exactly as it did before
# the attempt. So each subcommand has to ask.
#
# `--path-format=absolute` rather than bare `--git-path`, which answers relative
# to the repo. This script `cd`s there first so both forms happen to work today,
# and that is exactly why the absolute one is written down — the relative answer
# is right only for as long as nobody moves this call.
rebase_in_progress() {
  local dir
  for dir in rebase-merge rebase-apply; do
    [[ -e "$(git rev-parse --path-format=absolute --git-path "$dir")" ]] && return 0
  done
  return 1
}

# Both subcommands refuse on a half-finished rebase, differing only in the
# sentence that says why — so that sentence is the argument and the rest is
# shared. Writes to stderr: every caller is refusing to do what was asked.
refuse_if_rebasing() {
  rebase_in_progress || return 0
  echo "t3fork: $1" >&2
  say_how_to_finish >&2
  exit 1
}

# Said in one place because both callers need the same three ways out, and a
# half-finished rebase is the one state where the advice is identical whatever
# you were trying to do.
say_how_to_finish() {
  echo "  git add <files> && git rebase --continue"
  echo "  git rebase --abort   # to back out"
  echo "  git rebase --skip    # if upstream merged that patch already"
  echo
  echo "Then: t3fork install   # nothing has rebuilt the AppImage yet"
}

origin_seen=""   # the origin fetch below succeeded
origin_sha=""    # what origin/$branch held at that moment ("" = no such branch)
superseded=""    # commits on origin this checkout's later rebase supersedes

# Take in whatever another machine pushed, before rebasing anything onto it.
#
# Same rule `dots backup create` enforces on the archive, and for the same
# reason: this fork may only move forward. Rebasing from a checkout that is
# behind produces a branch missing the other machine's commits, and the
# force-push that eventually follows would delete them — a loss that leaves no
# trace anywhere, since the push succeeds and the branch looks healthy.
#
# It returns only when `$branch` carries, by patch-id, everything
# `origin/$branch` does — by taking origin in, or not at all. offer_push's
# force-push rests on that postcondition, so state it here and cite it there
# rather than deriving it twice from the mechanism.
#
# The obvious test for it is wrong. A branch rebased here and not yet pushed has
# *already* diverged from origin by construction, so refusing on divergence
# would block every update for anyone who does not push after each one. What
# actually matters is which side holds work the other lacks *by patch-id*, so
# that a locally rewritten commit still counts as present on both.
#
# A missing origin, or a fetch that fails offline, is a warning and not a stop:
# the `git fetch upstream main` that `update` runs *before* calling this has to
# work anyway for this command to do anything at all, so it is that one's job to
# end an offline run — it now runs first, so it already has.
sync_with_origin() {
  git remote get-url origin >/dev/null 2>&1 || {
    echo "t3fork: no origin remote — skipping the check for other machines' work" >&2
    return 0
  }
  # Explicit refspec: this must update refs/remotes/origin/<branch>, which is
  # what every comparison below reads, and what makes a later --force-with-lease
  # lease against something observed rather than something remembered.
  #
  # `origin_sha` is what origin held at the one moment we actually looked, and
  # offer_push leases against it rather than re-reading `origin/$branch` later:
  # the two are the same today and would stop being the same the first time
  # anything else in this script fetches.
  if git fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
    origin_seen=1
    origin_sha=$(git rev-parse --verify --quiet "origin/$branch") || origin_sha=""
  else
    # One probe answers all three reasons a fetch can fail here, through its exit
    # status: 0 the branch is there, 2 the remote answers but has no such branch,
    # anything else unreachable (verified — 128 for both a missing repo and a
    # dead host). Asking "does origin answer?" separately first was the same
    # question twice, at the price of a second round trip.
    #
    # Only status 2 may claim to have observed origin. Saying so anywhere else is
    # what makes everything below wrong at once: the comparison would run against
    # whatever stale `refs/remotes/origin/$branch` an earlier fetch left behind,
    # and offer_push would announce a published branch as never pushed and offer
    # a plain `push -u` for it.
    local rc=0
    git ls-remote --quiet --heads --exit-code origin "refs/heads/$branch" >/dev/null 2>&1 || rc=$?
    case $rc in
      0) echo "t3fork: could not read origin/$branch — continuing without it" >&2 ;;
      2) # Reachable, and the branch really is not on it yet — the state that
         # leaves offer_push a plain `push -u` to offer. Telling it apart from
         # unreachable is what keeps a never-pushed branch from falling through
         # with no offer at all.
         origin_seen=1
         echo "t3fork: $branch is not on origin yet" ;;
      *) echo "t3fork: could not reach origin — continuing without it" >&2 ;;
    esac
    # Every arm stops here. There is nothing on origin to take in, and a
    # `refs/remotes/origin/$branch` left over from before must not be compared
    # against as though it were current.
    return 0
  fi
  # From the variable, not a second rev-parse: origin_sha *is* the record of what
  # was observed, which is the point of capturing it above.
  [[ -n "$origin_sha" ]] || return 0

  # One walk, both sides. `--cherry-pick` drops from each side the commits the
  # other holds a patch-equivalent copy of, so the two counts are exactly what a
  # `git cherry` in each direction would have counted `+` — verified against
  # both. Left of `A...B` is A, so `origin/$branch` first puts origin's count in
  # $foreign.
  local foreign ours
  read -r foreign ours < <(git rev-list --left-right --cherry-pick --count "origin/$branch...$branch")

  # Origin holds nothing this checkout lacks: level, or rebased here and not yet
  # pushed. The postcondition already holds — leave the branch alone, and let
  # offer_push deal with the difference.
  [ "$foreign" -gt 0 ] || return 0

  # Which side was rebased onto the newer upstream, which is the question the
  # counts above cannot answer. Two situations produce the identical shape —
  # origin holds patches we lack and we hold patches it lacks — and they want
  # opposite answers: another machine rebased and pushed (origin wins), or THIS
  # machine rebased and declined the push, leaving on origin the pre-rebase form
  # of every commit the replay re-resolved (this checkout wins). Answering
  # "origin always wins" to both reverted the newer rebase and each conflict
  # resolution in it, then replayed the older form onto upstream. Silently: the
  # reset only moves a ref, so the loss goes to the reflog and the build after it
  # ships the old patch. It also read the upstream commits the rebase had taken
  # in as "our stale iterations" and offered to drop those too.
  #
  # The base is what tells them apart, because it is what a rebase changes:
  # merge-base against upstream/main is the upstream commit each side sits on.
  # That needs upstream/main to be current, which is why `update` fetches it
  # before calling this rather than after.
  local our_base their_base newer=""
  # Global, like origin_sha above and for the same reason: offer_push is the one
  # that needs it, and it runs after this function has returned.
  if our_base=$(git merge-base "$branch" upstream/main 2>/dev/null) \
     && their_base=$(git merge-base "origin/$branch" upstream/main 2>/dev/null); then
    if [ "$our_base" = "$their_base" ]; then
      newer=same
    elif git merge-base --is-ancestor "$their_base" "$our_base"; then
      newer=ours
    elif git merge-base --is-ancestor "$our_base" "$their_base"; then
      newer=theirs
    else
      newer=incomparable
    fi
  fi

  # Two bases that are each other's ancestor in neither direction. Impossible on
  # a linear upstream — the fork's is, measured — and reachable the moment it
  # takes a PR as a merge commit and the two sides land on different parents.
  # Worth its own arm rather than a fall-through: falling through means resetting
  # to origin, which is the one outcome that silently destroys a rebase, and
  # doing that on a question this cannot answer is how the 2026-08-20 incident
  # would come back by a side door.
  if [ "$newer" = incomparable ]; then
    echo "t3fork: origin/$branch and this checkout sit on unrelated upstream bases." >&2
    echo "t3fork: refusing to choose. Compare them, then rebase by hand:" >&2
    echo "  git -C $repo log --oneline --left-right --cherry-pick origin/$branch...$branch" >&2
    exit 1
  fi

  # Equal bases, or no upstream/main to measure against, fall through to the rule
  # below — same base and different patches really is work of origin's own.
  if [ "$newer" = ours ]; then
    # Superseded, not lost: origin's extra patches are the forms these commits
    # had one rebase ago. Named anyway, because the one thing this cannot tell
    # from a supersession is another machine pushing genuinely new work while
    # this one rebased without taking it in — and the subject list settles that
    # in the second it takes to read.
    echo "t3fork: origin/$branch sits on an older upstream — keeping this checkout's rebase."
    echo "        $foreign commit(s) there are superseded by it:"
    superseded="$(git --no-pager log --oneline --cherry-pick --left-only "origin/$branch...$branch")"
    printf '%s\n' "$superseded"
    # Held, not just printed. `update` rebases after this and prints its own
    # commit list before the push prompt, so by the time the question that
    # matters is asked — force-push over those commits? — this list has scrolled
    # away. Telling the reader to "stop" here was worse than useless: the rebase
    # had not happened yet when they read it, and had by the time they could act.
    return 0
  fi

  # Divergence alone is not a conflict, and this is the shape it usually takes:
  # another machine ran this same command, rebasing the same patches onto a
  # newer upstream and force-pushing, so origin carries our work rewritten
  # rather than work of its own. Nothing here to lose, and origin is the better
  # base to rebase from — taking it is what lets the fork be maintained from
  # two machines with no manual step after every update.
  if [ "$ours" -gt 0 ]; then
    # Commits only this checkout holds do not change that answer: origin still
    # wins. Every update ends on the push offer, so by the time another machine
    # has force-pushed, a commit sitting only here is a stale iteration of a
    # patch origin already carries amended or evolved — and an amend is exactly
    # what breaks the patch-id match that would otherwise have paired them up.
    # This case used to refuse and ask for a manual `git rebase origin/$branch`,
    # which failed on every machine switch: the replay hit add/add conflicts on
    # those stale iterations, and the only correct resolution was `--skip` on
    # each — i.e. what taking origin does wholesale. Naming what is dropped,
    # and the sha it lived at, is what keeps a genuinely new never-pushed patch
    # survivable: the reset only moves the ref, the commits stay in the reflog.
    echo "t3fork: this checkout carries $ours commit(s) origin does not — stale iterations"
    echo "        of work another machine already rebased and pushed; taking origin drops them:"
    git --no-pager log --oneline --cherry-pick --right-only "origin/$branch...$branch"
    echo "        If one of those was real unpushed work, it is still in the reflog:"
    echo "  git branch t3fork-rescue $(git rev-parse --short "$branch")"
  fi

  # This is also the plainly-behind case, which is why there is no separate
  # fast-forward arm: `--keep` lands the branch exactly where `merge --ff-only`
  # would. And `--keep`, never `--hard`, is what keeps that true in a dirty
  # tree — it refuses rather than discarding uncommitted work the incoming diff
  # would overwrite. Under `set -e` git's own message ended the run with none of
  # ours, the same way `git switch` did before the rebase guard above.
  echo "t3fork: taking in $foreign commit(s) from origin/$branch"
  git reset --keep "origin/$branch" || {
    echo "t3fork: cannot move to origin/$branch — uncommitted changes are in the way." >&2
    echo "t3fork: commit or stash them, then re-run: t3fork update" >&2
    exit 1
  }
}

# Publish the rebased branch — offered, never done on its own.
#
# A rebase rewrites a branch that is already on GitHub, so the only way to put
# origin back in step is a force-push. That is safe *here specifically* and
# nowhere else in this script — but the guarantee has two arms now, and only the
# first is airtight:
#
#   - sync_with_origin took origin in, or found nothing to take. What the push
#     overwrites is then patch-equivalent to what we hold.
#   - or it established that this checkout is the later rebase, in which case
#     origin carries $foreign commits we do not. Those are the pre-rebase forms
#     of commits we hold re-resolved — unless another machine pushed genuinely
#     new work, which no test can tell from a supersession. So $superseded is
#     printed again immediately below, at the moment the question is actually
#     asked, rather than left to scroll away above the rebase output.
#
# The lease closes the only window left — someone pushing between that fetch and
# this push makes the command fail rather than silently win.
#
# Not automatic, and the reason is not technical. `t3fork update` is the command
# `dots update`'s fork report names, so a routine maintenance line would turn
# into "rewrite the history of a published branch" with nobody having agreed to
# that. The failure modes settle it: not pushing costs an origin that lags and
# that the next run takes in without losing anything, while pushing wrongly
# rewrites a remote.
#
# So it asks where there is somebody to ask, and prints the command everywhere
# else — the same `[ -t 0 ]` reasoning as install's restart prompt, and the same
# default of no.
offer_push() {
  [[ -n "$origin_seen" ]] || return 0

  local head
  head="$(git rev-parse "$branch")"
  [[ "$head" != "$origin_sha" ]] || return 0

  local -a push
  local state
  if [[ -n "$origin_sha" ]]; then
    # <refname>:<expect>, refname being the ref *on the remote*. Pinning the sha
    # rather than the bare --force-with-lease matters: the bare form leases
    # against the local remote-tracking ref, which any later fetch in this
    # process would quietly move underneath it.
    push=(git push "--force-with-lease=$branch:$origin_sha" origin "$branch")
    state="$branch has been rewritten — origin is still at ${origin_sha:0:8}"
  else
    # Never pushed: nothing there to overwrite, so no lease, and -u is what gives
    # the branch an upstream for every later comparison.
    push=(git push -u origin "$branch")
    state="$branch has never been pushed"
  fi

  echo
  echo "t3fork: $state"

  if [[ -n "$superseded" ]]; then
    echo "t3fork: this push DROPS these commits from origin — they are the forms"
    echo "        this checkout re-resolved one rebase ago:"
    printf '%s\n' "$superseded" | sed 's/^/  /'
    echo "t3fork: a subject you do not recognise is another machine's work. Say no."
  fi
  if ! ask_yes "Push it to origin now?"; then
    echo "t3fork: leaving origin alone. To publish it:"
    printf '  %s\n' "${push[*]}"
    return 0
  fi

  # Never fatal: the rebase succeeded and the build is still worth doing, so a
  # rejected lease costs the push and says why, rather than taking the run with
  # it. A rejection here means somebody pushed in the last few seconds — the one
  # case this whole mechanism exists to catch.
  "${push[@]}" || {
    echo "t3fork: push refused — origin moved since we looked. Re-run: t3fork update" >&2
    return 0
  }

  # The droplet builds origin/$branch (docs/adr/0003), so this push is the moment
  # it becomes reachable-and-stale, and nothing over there notices. Offered on the
  # spot rather than printed as a next step: a command to remember at the end of a
  # maintenance run gets remembered once. This is the friction that actually cost
  # something — a declined push left the host a day behind, and the desktop looked
  # fine the whole time.
  #
  # Same default of no as the push above. It is three minutes of remote build,
  # which is why it asks rather than just doing it.
  #
  # It also runs before `t3fork install` has proved the rebased tree builds. That
  # is a cost and not a hazard: phase_fork writes its sentinel and touches the
  # unit only after a successful build, so a broken commit leaves the host on the
  # previous one. What it buys is the loop closing here, where the information is.
  echo
  echo "t3fork: the droplet builds origin/$branch and is now one build behind."
  local dots
  if ! ask_yes "Rebuild it now?"; then
    echo "t3fork: leaving it alone. To bring it along later:"
    echo "  dots droplet fork"
    return 0
  fi
  # A missing `dots`, or a droplet that is off, costs the remote build and
  # nothing else: the push above already succeeded and the desktop half of this
  # command has not run yet.
  if ! dots=$(resolve_dots); then
    echo "t3fork: dots not found — the droplet is still on the previous build" >&2
    return 0
  fi
  "$dots" droplet fork || echo "t3fork: the droplet build failed — re-run: dots droplet fork" >&2
}

case "${1:-}" in
  update)
    # Ahead of the fetch, so the answer comes before several seconds of network.
    # Without this the run died on `git switch` instead — `fatal: cannot switch
    # branch while rebasing`, git's message and none of ours, on the one path
    # where the user most needs telling what to do next.
    refuse_if_rebasing "a rebase is already in progress here — finish it first:"

    git switch "$branch"
    # Before sync_with_origin, which compares the two sides' rebase bases against
    # upstream/main and cannot do that against a stale one. Not free: the paths
    # where sync_with_origin exits — a dirty tree it cannot reset over — now pay
    # this fetch first and throw it away. Worth it, since the alternative is a
    # comparison against a stale ref, which is how the wrong side wins.
    git fetch upstream main
    sync_with_origin
    # A rebase keeps the fork as "upstream plus N patches", which is what makes
    # the next one cheap. Never merge: a merge buries our commits in history and
    # every later conflict has to be re-solved.
    #
    # `--autostash` because the other half of this command dirties the tree:
    # `t3fork install` runs `vp i`, and pnpm rewrites pnpm-lock.yaml with
    # registry metadata. So a plain rebase refused to start on the *next* update,
    # every cycle, over a file the tool itself had touched. Autostash restores it
    # afterwards, so nothing is lost — and unlike the dotfiles' own pull, there is
    # no review in progress here for it to stash out from under.
    if ! git rebase --autostash upstream/main; then
      echo
      # A rebase that stopped on a conflict and one git refused to start are not
      # the same state, and only the first can be continued. Saying "conflicts"
      # for both is how this command answered a dirty tree with `--continue`,
      # `--abort` and `--skip` — three commands that had nothing to act on.
      if rebase_in_progress; then
        echo "t3fork: conflicts — fix them, then:"
        # Ending on the install is the point. The command this is half of is
        # `t3fork update && t3fork install`, and exiting non-zero here is what
        # stops the second half — correctly, since there is nothing coherent to
        # build yet. But finishing the rebase by hand does not bring it back, so
        # without this line you end up rebased and still running the old build.
        say_how_to_finish
      else
        echo "t3fork: the rebase never started — git refused it, for the reason above."
        echo "t3fork: nothing here has changed. Clear it, then re-run:"
        echo "  t3fork update"
      fi
      exit 1
    fi
    git --no-pager log --oneline upstream/main.."$branch"
    offer_push
    ;;

  install)
    # The `&&` in `t3fork update && t3fork install` already stops the chained
    # case, so this is for the run started by hand — which is the dangerous one.
    # Mid-rebase, HEAD is a partially replayed tree, and nothing downstream would
    # have said so: the build succeeds, the version string still reads
    # `…-moinax.<sha>` because the branch name is this script's variable rather
    # than anything git was asked, and the AppImage is installed over the working
    # one. A build that lies about which branch it is, from a state that exists
    # for the length of a conflict.
    refuse_if_rebasing "a rebase is in progress — refusing to build a half-rebased tree. Finish it:"

    restart=ask
    for flag in "${@:2}"; do
      case "$flag" in
        -y|--yes) restart=yes ;;
        -n|--no-restart) restart=no ;;
        *) echo "t3fork: unknown flag $flag" >&2; exit 1 ;;
      esac
    done

    # Resolve vp rather than trusting PATH. The point of this script is to be
    # runnable from inside T3 Code, and an agent shell there replays a snapshot
    # captured before either install location was ever on PATH — so `command -v
    # vp` fails in the one context that matters most. Both locations are stable,
    # so ask PATH first and fall back to them in turn.
    #
    # Prefer the official standalone install. Unlike the npm package's bin/vp,
    # it delegates to this checkout's workspace-pinned vite-plus and therefore
    # keeps Vite/Vitest on one module graph. The ~/.vite-plus path is the legacy
    # monolithic layout; current installers use the XDG data directory.
    for vp in \
      "$HOME/.local/share/vite-plus/bin/vp" \
      "$HOME/.vite-plus/bin/vp" \
      "$(command -v vp || true)"
    do
      if [[ -x "$vp" ]]; then break; fi
    done
    [[ -x "$vp" ]] || {
      echo "t3fork: vp not found — 'dots packages sync' installs it, or:" >&2
      echo "  curl -fsSL https://vite.plus | VP_NODE_MANAGER=no bash" >&2
      exit 1
    }
    "$vp" i

    # Version carries the commit so two builds are never confused for each
    # other; the fork tag also keeps it sorting below upstream's nightlies.
    version="$(node -p "require('./apps/desktop/package.json').version")-$branch.$(git rev-parse --short HEAD)"

    # Clear the output dir rather than predicting electron-builder's file name:
    # whatever single AppImage is left afterwards is this build's.
    rm -f release/*.AppImage
    "$vp" run dist:desktop:artifact --platform linux --target AppImage --arch x64 --build-version "$version"

    built="$(echo release/*.AppImage)"
    [[ -f "$built" ]] || { echo "t3fork: build produced no AppImage" >&2; exit 1; }

    # Install through `dots apps import-appimage` rather than a bare copy: it
    # writes the desktop entry and the icon alongside the AppImage, which a copy
    # does not. Copying alone is what left the fork one launch away from being
    # unreachable — the build landed at $target while every launcher entry, and
    # the t3code:// handler with them, still pointed at a separately installed
    # upstream AppImage. Nothing said so, because `t3fork restart` execs $target
    # directly and looked right; the next launch from the desktop was upstream
    # again, with our patches nowhere in it.
    #
    # --name is not cosmetic. Left off, the importer takes the name embedded in
    # the build, which electron-builder stamps from productName — "T3 Code
    # (Alpha)" — slugging to t3-code-alpha and installing a *second* app beside
    # this one. That is the split above, recreated by the command meant to close
    # it.
    #
    # Resolved like vp above, and for the same reason: an agent shell inside T3
    # Code replays a PATH snapshot older than ~/.local/bin.
    for dots in \
      "$(command -v dots || true)" \
      "$HOME/.local/bin/dots"
    do
      if [[ -x "$dots" ]]; then break; fi
    done
    if [[ -x "$dots" ]]; then
      "$dots" apps import-appimage "$built" --name "$app_name"
    else
      # A missing `dots` costs the launcher entry, never the build. Safe while
      # T3 Code is running: install(1) creates a new file, so the mounted
      # AppImage keeps its own inode until the app is restarted.
      echo "t3fork: dots not found — installing the AppImage, launcher entry left as it is" >&2
      install -Dm755 "$built" "$target"
    fi
    echo "t3fork: installed $version -> $target"

    # Asking needs someone to answer: run from an agent or a hook there is no
    # terminal, and a `read` there would either block forever or read the
    # build's own output. So no tty means no restart unless -y said so.
    if [[ "$restart" == ask ]]; then
      if ask_yes "Restart T3 Code onto it now?"; then
        restart=yes
      else
        restart=no
        # ask_yes has already said *why* it answered no; this is the part that is
        # specific to this call site.
        [[ -t 0 ]] || echo "t3fork: pass -y to restart unattended"
      fi
    fi
    # `if`, not `[[ … ]] && restart_app`: that list is the last command of the
    # case, so declining the restart (or passing -n) made the whole script exit
    # 1 — a successful install reported as a failure to anything chaining off
    # `t3fork install`, which is exactly how this is meant to be run.
    if [[ "$restart" == yes ]]; then
      restart_app
    fi
    ;;

  restart)
    [[ -f "$target" ]] || { echo "t3fork: nothing installed at $target" >&2; exit 1; }
    restart_app
    ;;

  *)
    # Print the header block by asking where it *ends* — the first line that is
    # not a comment — rather than by line number. The number was '2,10' and went
    # stale the moment the header gained a sentence: `restart` and both install
    # flags dropped out of the usage while the block that documents them sat
    # right there, and nothing failed to say so.
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
    exit 1
    ;;
esac
