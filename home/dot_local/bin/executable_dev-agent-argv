#!/usr/bin/env bash
# Resolve an AI-agent provider to its launch argv — the single source of truth
# used by dev-zellij-session.
#
# Each provider has its own CLI shape:
#   claude   -> claude -n NAME [prompt]   (-n = display name; prompt auto-submits)
#   codex    -> codex [prompt]            (prompt positional; no name flag)
#   opencode -> opencode                  (TUI; positional is a PATH not a prompt,
#                                           so no name and no auto-prompt)
#
# Usage:   dev-agent-argv PROVIDER NAME [PROMPT]
# Output:  one argv token per line (first line = command, rest = args).
#          Callers reassemble: zellij needs command + args split; kitty %q-quotes.
set -euo pipefail

provider="${1:-}"; name="${2:-}"; prompt="${3:-}"

case "$provider" in
  claude)
    set -- claude
    [[ -n "$name" ]]   && set -- "$@" -n "$name"
    [[ -n "$prompt" ]] && set -- "$@" "$prompt"
    ;;
  codex)
    set -- codex
    [[ -n "$prompt" ]] && set -- "$@" "$prompt"
    ;;
  opencode)
    # TUI mode: cwd is already the project dir; no name/prompt injection.
    set -- opencode
    ;;
  *)
    echo "dev-agent-argv: unknown provider '$provider' (want: claude|codex|opencode)" >&2
    exit 1
    ;;
esac

printf '%s\n' "$@"
