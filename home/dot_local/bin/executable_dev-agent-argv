#!/usr/bin/env bash
# Resolve an AI-agent provider to its launch argv — the single source of
# truth for launching an agent CLI (used by dev-zellij-session,
# herdr-agent-layout, and herdr-clients revive-panes).
#
# Each provider has its own CLI shape:
#   claude   -> claude -n NAME [prompt]   (-n = display name; prompt auto-submits)
#   claudex  -> claudex -n NAME [prompt]  (wrapper that execs claude against
#                                           claude-code-proxy — same CLI shape)
#   codex    -> codex [prompt]            (prompt positional; no name flag)
#   opencode -> opencode                  (TUI; positional is a PATH not a prompt,
#                                           so no name and no auto-prompt)
#
# Usage:   dev-agent-argv [-q] PROVIDER NAME [PROMPT]
# Output:  one argv token per line (first line = command, rest = args), for
#          callers that need the tokens split (zellij). With -q, one
#          %q-quoted line ready for a shell / herdr `pane run` — the join is
#          owned here so the spawn (herdr-agent-layout) and the revive
#          (herdr-clients) can never drift in how they quote a prompt.
set -euo pipefail

quoted=0
[[ "${1:-}" == -q ]] && { quoted=1; shift; }
provider="${1:-}"; name="${2:-}"; prompt="${3:-}"

case "$provider" in
  claude|claudex)
    set -- "$provider"
    [[ -n "$name" ]]   && set -- "$@" -n "$name"
    [[ -n "$prompt" ]] && set -- "$@" "$prompt"
    ;;
  codex)
    set -- codex
    [[ -n "$prompt" ]] && set -- "$@" "$prompt"
    ;;
  opencode)
    # TUI mode: cwd is already the project dir; no name/prompt injection.
    set -- opencode
    ;;
  *)
    echo "dev-agent-argv: unknown provider '$provider' (want: claude|claudex|codex|opencode)" >&2
    exit 1
    ;;
esac

if (( quoted )); then
  printf '%q ' "$@"
else
  printf '%s\n' "$@"
fi
