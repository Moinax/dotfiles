#!/usr/bin/env bash
# Name a herdr agent tab after what its conversation is actually about — the
# "agent session" identity the desktop agents (Claude, Codex, Cursor) have and
# a pane grid does not. Three claude tabs on one checkout read as
# "remove-lfs-boilerplate", "flaky-updater-tests", "sidebar-agent-rows"
# instead of "claude", "claude 2", "claude 3".
#
# Usage: herdr-agent-title sync              Claude Code hook (Stop /
#                                            SessionStart); hook JSON on stdin
#        herdr-agent-title seed [-s SESSION] PANE KIND NAME
#                                            record the launch label so the
#                                            hook knows what it may replace
#
# Where the name comes from, in order:
#   1. Claude Code's own session title — the `custom-title` record it keeps in
#      the transcript. It is what `/rename` writes, what Claude regenerates as
#      the work drifts, and what it pushes to the terminal title (which is why
#      the sidebar's terminal_title_stripped row already tracks it live).
#   2. A slug of the first user prompt, until (1) says anything other than the
#      launch label — this is what makes a brand-new tab self-name after one
#      exchange instead of sitting on "claude 2" for the first ten minutes.
#
# Seed kinds (written by herdr-agent-layout at launch, one line
# KIND<TAB>NAME<TAB>SEEN under $XDG_RUNTIME_DIR, where SEEN is the raw agent
# title this script last observed on the pane — banked on every write, read
# only to decide whether a `pin` has been overtaken):
#   seed  launched with a generated label (project / provider + number) — the
#         hook is free to replace it
#   pin   launched from a task the user typed, or renamed by hand since. Their
#         words hold against the guess: a pin never takes the opening-prompt
#         slug. It does follow the agent's own title, but only when that title
#         *moves*: no Claude Code hook fires on `/rename`, so a title that has
#         shifted since SEEN was banked is the only sighting of one from out
#         here. SEEN is what makes this a change and not a comparison, so a
#         hand-named tab is not immediately overwritten by a title that was
#         already sitting there when it was named. Following a move flips the
#         entry to `set`.
#   set   written by this script: the last name it applied, and therefore the
#         tab label it expects to find. A different live label means the user
#         renamed the tab by hand, which flips the entry back to `pin`.
# With no entry at all — a pane from before this existed, or after a reboot,
# which reassigns pane ids anyway — the live tab label is adopted as the
# baseline: a name that is already right then costs a re-report, not a rename.
# A `pin` does not survive that (the state is per boot by nature), so a
# hand-named tab can be renamed once after a reboot if the agent's own title
# has moved on since; renaming it again re-pins it.
#
# The settled name goes to three places, always the same one: the tab label, the
# sidebar `$task` token, and vibewatch — whose panel and waybar pill would
# otherwise keep showing Claude's own title after a hand rename.
#
# Nothing here is fatal and every herdr call goes through `h`, which time-boxes
# it: a wedged server must never cost a turn. Cost is ~15ms per turn end on a
# typical transcript and ~25ms on a multi-MB one, and only on a pane that hosts
# an agent inside herdr. A pin pays the transcript read like every other pane —
# that is where a `/rename` shows up — plus a label read and one
# `vibewatch rename` spawn, but stops there, skipping the name formatting, the
# guess and the label adoption below.
set -euo pipefail

usage="usage: herdr-agent-title sync | seed [-s SESSION] PANE KIND NAME"

cache_root="${XDG_RUNTIME_DIR:-/tmp}/herdr-agent-title"

# Every herdr call in this script goes through here, so the time-box the header
# promises is structural and not a thing each new call site has to remember.
h() { timeout 2 herdr "$@"; }

# Pane ids (w8:p48) are unique per session only, so the key carries both.
cache_path() { # $1: session, $2: pane id
  local key="$1.$2"
  printf '%s/%s\n' "$cache_root" "${key//[![:alnum:]._-]/_}"
}

# Session name from the inherited socket path — named sessions live in
# ~/.config/herdr/sessions/<name>/herdr.sock, the default one sits directly in
# ~/.config/herdr (same derivation as herdr-nav quit).
session_from_socket() {
  local dir="$HOME/.config/herdr/sessions" sock="${HERDR_SOCKET_PATH:-}"
  if [[ "$sock" == "$dir"/?*/* ]]; then
    sock="${sock#"$dir/"}"
    printf '%s\n' "${sock%%/*}"
  else
    printf 'default\n'
  fi
}

write_cache() { # $1: file, $2: kind, $3: name, $4: agent title last seen
  [[ -d "$cache_root" ]] || mkdir -p "$cache_root"
  printf '%s\t%s\t%s\n' "$2" "$3" "${4:-}" >"$1"
}

# The tab's current label, empty on any failure.
tab_label() { # $1: tab id
  h tab get "$1" 2>/dev/null | jq -r '.result.tab.label // empty' 2>/dev/null
}

# Display-only metadata: the $task sidebar token and the pane title. The
# semantic agent state stays herdr's own integration's business.
#
# Always the same name the tab label is getting, which is why every caller
# below settles the label question first: a sidebar row reading one name beside
# a tab reading another is worse than either name alone.
#
# vibewatch is told too, for the same reason: its panel and its waybar pill name
# sessions off Claude's own title, so a tab renamed by hand used to leave them
# both showing the old one — the tab said "vibewatch ui" while the bar still read
# "vibewatch on idle". It holds the name until that title moves, which is this
# script's own rule for a pin, so the three stay in step by construction.
report_metadata() { # $1: name
  h pane report-metadata "$HERDR_PANE_ID" \
    --source dots:agent-title --title "$1" --token "task=$1" \
    >/dev/null 2>&1 || true
  tell_vibewatch "$1"
}

# vibewatch's panel and its waybar pill name sessions off Claude's own title, so
# a tab renamed by hand used to leave both showing the old one — the tab read
# "vibewatch ui" while the bar still said "vibewatch on idle". It holds the name
# until that title moves, which is this script's own rule for a pin, so the tab,
# the sidebar and the bar stay in step by construction.
#
# Told unconditionally on the held-pin path too, not just when a name is settled:
# vibewatch keeps the override in memory, so its own restart drops it, and out
# here there is no way to notice that happened. Idempotent, so re-sending costs
# nothing but the spawn (~4ms, measured) — the one thing the pin fast path did
# not previously pay. Time-boxed like every herdr call here, and skipped outright
# when vibewatch is not installed: a name must never cost a turn.
tell_vibewatch() { # $1: name
  [[ -n "${session_id:-}" && -n "${1:-}" ]] || return 0
  command -v vibewatch >/dev/null 2>&1 || return 0
  timeout 2 vibewatch rename "$session_id" "$1" >/dev/null 2>&1 || true
}

# Both readers below run in a subshell with pipefail off on purpose: their
# bounded greps exit early, which kills the upstream `tac`/`grep` with SIGPIPE
# — a failure this script must not see. They also re-check the record type in
# jq, because a transcript quotes these very strings inside tool output (any
# turn that read a transcript, this script's own runs included), and they end
# on a single slurping jq so nothing has to early-exit a second time.

# The title Claude Code maintains for the session, newest record first. `tac`
# streams from the end and `grep -m20` cuts it short with SIGPIPE — but only
# where there are 20 records to find, and most transcripts hold fewer, so
# budget for a full read (~15ms on 16MB) rather than the early exit.
# The length filter keeps a multi-MB tool-result line out of jq; a real
# record is ~120 bytes.
claude_title() { # $1: transcript
  ( set +o pipefail
    tac "$1" 2>/dev/null \
      | grep -m20 -E '"type": ?"custom-title"' \
      | awk 'length < 400' \
      | jq -R -s -r 'split("\n")
          | map(fromjson? | select(.type == "custom-title") | .customTitle // empty)
          | map(select(length > 0)) | first // empty' 2>/dev/null )
}

# The opening prompt. A few user records, not just the first: a session opened
# with a slash command leads with a <local-command-caveat> block. Only records
# with a promptId count — that is what a typed prompt has and a tool result or
# an injected command body does not — and text that opens with a tag is
# scaffolding (<command-name>, <local-command-caveat>), never the prompt.
# The length filter is the same guard claude_title uses, just looser: the grep
# also matches tool-result records, and one 800KB line among the first eight
# would otherwise be slurped whole into jq.
first_prompt() { # $1: transcript
  ( set +o pipefail
    grep -m8 -E '"type": ?"user"' "$1" 2>/dev/null \
      | awk 'length < 8000' \
      | jq -R -s -r 'split("\n")
          | map(fromjson? | select(.type == "user")
                | select(.promptId != null)
                | select((.isSidechain // false) | not)
                | [.message.content?] | flatten
                | map(if type == "object" then (.text // "") else . end)
                | map(select(type == "string" and length > 0
                             and (test("^\\s*<") | not)))
                | first // empty)
          | first // empty' 2>/dev/null )
}

case "${1:-sync}" in
  seed)
    shift
    # Without -s the session is the one this call inherited (herdr-agent-layout
    # runs inside a pane for the agent-tab path); dev-herdr passes it
    # explicitly because it can create a workspace in another session than the
    # pane it was launched from.
    session="$(session_from_socket)"
    [[ "${1:-}" == -s ]] && { session="${2:?$usage}"; shift 2; }
    pane="${1:?$usage}"; kind="${2:?$usage}"; name="${3:?$usage}"
    [[ "$kind" == seed || "$kind" == pin ]] || { echo "$usage" >&2; exit 2; }
    write_cache "$(cache_path "$session" "$pane")" "$kind" "$name"
    ;;

  sync)
    # Outside a herdr pane there is nothing to label. This is also the fast
    # exit for every agent the hook fires in that herdr never spawned.
    [[ "${HERDR_ENV:-}" == 1 && -n "${HERDR_PANE_ID:-}" && -n "${HERDR_SOCKET_PATH:-}" ]] \
      || exit 0
    command -v jq >/dev/null 2>&1 || exit 0

    # Cache first: it decides how much of the rest is allowed to run. Reading
    # it costs no process at all, and a third field on old two-field lines just
    # reads back empty (handled where `seen` is used).
    cache="$(cache_path "$(session_from_socket)" "$HERDR_PANE_ID")"
    kind=""; applied=""; seen=""
    if [[ -r "$cache" ]]; then
      IFS=$'\t' read -r kind applied seen <"$cache" || true
    fi

    # All three payload fields in one jq: the hook JSON is a handful of lines
    # and this runs at every turn end, on every pane. The session id is what
    # vibewatch keys its own sessions on, so it is how the name reaches the
    # panel and the bar (see report_metadata).
    IFS=$'\t' read -r transcript event session_id \
      < <(jq -r '[.transcript_path // "", .hook_event_name // "",
                  .session_id // ""] | @tsv' 2>/dev/null) || true
    [[ -n "$transcript" && -r "$transcript" ]] || exit 0

    if [[ -z "$kind" && -n "${HERDR_TAB_ID:-}" ]]; then
      # No entry: this pane predates the cache, or the machine rebooted (pane
      # ids are reassigned on restore anyway, so the cache cannot outlive a
      # boot). Adopt whatever the tab is called as the baseline, so a name
      # that is already right costs a re-report and not a rename.
      applied="$(tab_label "$HERDR_TAB_ID")" || applied=""
    fi

    task_name="${0%/*}/herdr-task-name"
    [[ -x "$task_name" ]] || task_name=herdr-task-name

    # Claude writes its title as a slug ("workspace-pane-agent-labeling"). The
    # slug is what SEEN banks and what `moved` compares, so it stays raw here
    # and the herdr-task-name spawn that reads it back as words waits until
    # past the pin gate — a held pin is the common case and never needs them.
    title="$(claude_title "$transcript")" || title=""

    # Has the agent's own title moved since this pane was pinned (see header)?
    moved=0
    [[ -n "$title" && -n "$seen" && "$title" != "$seen" ]] && moved=1

    # A pin holds the name the user chose against the guess, not against the
    # agent's own account of the work — so it stops here unless the title moved.
    if [[ "$kind" == pin && "$moved" == 0 ]]; then
      # The label, not $applied. This path exits before the `live != applied`
      # check below, so a tab renamed by hand while pinned leaves $applied
      # stale — and pushing that outwards would actively overwrite the user's
      # name with the one they replaced.
      pinned="$(tab_label "${HERDR_TAB_ID:-}")" || pinned=""
      [[ -n "$pinned" ]] || pinned="$applied"

      # A label that has drifted from the last reported name is a hand rename,
      # and this path is the only one that can see it: the `live != applied`
      # check further down is past the gate we are about to exit through. The
      # pane title and the sidebar token have to follow it too — a pane header
      # reading the name the user just replaced is the same defect as a stale
      # bar, one surface over.
      #
      # A server restart drops reported metadata while keeping labels, hence the
      # SessionStart arm as well. Otherwise only vibewatch is pinged, every turn:
      # it holds the name in memory only, so its own restart drops it and nothing
      # out here can tell when that happened. `report_metadata` covers it too,
      # hence the else rather than both.
      if [[ -n "$pinned" ]] && [[ "$pinned" != "$applied" || "$event" == SessionStart ]]; then
        report_metadata "$pinned"
      else
        tell_vibewatch "$pinned"
      fi

      # Banked only now: the entry records what has been reported, so writing it
      # before the report above would erase the very drift that triggers it and
      # leave the stale name in place for good.
      banked="${seen:-$title}"
      [[ "$pinned" != "$applied" || "$banked" != "$seen" ]] \
        && write_cache "$cache" pin "$pinned" "$banked"
      exit 0
    fi

    # Past the gate the title, if any, becomes a name: herdr-task-name applies
    # the same length cap every other name goes through, so the cached value and
    # the tab label always compare like with like. Kept apart from $title, which
    # stays the raw slug SEEN is written from and $name may not survive — the
    # guess below can overwrite it.
    name="$title"
    [[ -n "$name" ]] && name="$("$task_name" "$name" 2>/dev/null || true)"

    # Nothing better than the launch label yet — no title at all, or still the
    # one we passed as `claude -n`: name it after the opening prompt instead.
    # Every gate here is narrow on purpose. Once a real name has been applied a
    # stale first prompt must not undo a title Claude has since sharpened, and
    # a title that merely matches an adopted tab label is not a seed. `pin` is
    # named rather than left to fall out of the branch above: a pin never
    # guesses is an invariant, and it should read as one.
    if [[ "$kind" != set && "$kind" != pin ]] \
       && [[ -z "$name" || ( "$kind" == seed && "$name" == "$applied" ) ]]; then
      first="$(first_prompt "$transcript")" || first=""
      [[ -n "$first" ]] && name="$("$task_name" "$first" 2>/dev/null || true)"
    fi
    [[ -n "$name" ]] || exit 0

    # Whether the tab is still ours to name, settled before anything is
    # reported — and before the no-op exit below, which would otherwise hide a
    # hand rename entirely: a label that has drifted from what we last applied
    # was typed by the user, and their name has to reach the sidebar and
    # vibewatch too, not just survive on the tab.
    live=""
    if [[ -n "${HERDR_TAB_ID:-}" && ( "$kind" == set || "$kind" == pin ) ]]; then
      live="$(tab_label "$HERDR_TAB_ID")" || live=""
    fi

    # Nothing to do: the name has not moved, and neither has the label. A server
    # restart wipes reported metadata (herdr only persists labels), so
    # SessionStart re-reports even then.
    [[ "$name" == "$applied" && "$kind" == set && "$event" != SessionStart \
       && ( -z "$live" || "$live" == "$applied" ) ]] && exit 0
    if [[ -n "$live" && "$live" != "$applied" ]]; then
      # Renamed by hand since our last write — hand the tab back, and report the
      # name it is actually wearing. The title goes in as SEEN, spending the
      # move that got us this far: a fresh pin must not be undone on the next
      # turn by the change that preceded it.
      report_metadata "$live"
      write_cache "$cache" pin "$live" "$title"
      exit 0
    fi

    report_metadata "$name"

    # Deliberately NOT `herdr agent rename`: that replaces the value behind
    # the sidebar's `agent` token, so the row loses the one short thing it had
    # ("claude") and repeats the long name instead. The tab label is where the
    # name belongs; the agent stays its provider.

    [[ -n "${HERDR_TAB_ID:-}" ]] \
      && { h tab rename "$HERDR_TAB_ID" "$name" >/dev/null 2>&1 || true; }

    # `set` from here even if we arrived pinned: the tab now carries the agent's
    # own name, so the ordinary follow-and-watch rules apply — the guess stays
    # shut out, and a hand rename pins it again.
    write_cache "$cache" set "$name" "$title"
    ;;

  *)
    echo "$usage" >&2
    exit 2
    ;;
esac
