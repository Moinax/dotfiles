#!/usr/bin/env bash
# Navigation helper for herdr shell keybindings (~/.config/herdr/config.toml).
# Shell bindings run detached from any pane, so the target is resolved
# explicitly from the `focused` flags instead of relying on pane env.
#
# Usage: herdr-nav tab N            focus the Nth tab of the focused workspace
#        herdr-nav resize DIR       resize the focused pane (left|right|up|down)
#        herdr-nav agent-picker     pick an agent provider, then add it as a
#                                   tab to the focused workspace
#        herdr-nav agent-tab [PROV] add another agent tab to the focused
#                                   workspace; PROV overrides the inherited
#                                   provider (e.g. claudex for a GPT tab)
#        herdr-nav quit             stop the current session and close its
#                                   client window (the in-herdr `hss`)
set -euo pipefail

die() { echo "herdr-nav: $*" >&2; exit 1; }

# Call a herdr socket API method not exposed on the CLI (e.g. tab.move).
# Uses the same socket the CLI resolves: the session inherited via
# HERDR_SOCKET_PATH (shell binds run inside a pane), else the default session.
# Prints the JSON response; non-fatal on failure.
api() {
  # NB: don't default params with ${2:-{}} — the first } closes the expansion
  # and a literal } gets appended to $2, producing invalid JSON.
  local method="$1" params="${2:-}"
  [[ -n "$params" ]] || params='{}'
  local sock="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
  [[ -S "$sock" ]] || return 1
  printf '{"id":"1","method":"%s","params":%s}\n' "$method" "$params" \
    | socat - "UNIX-CONNECT:$sock" 2>/dev/null
}

focused_workspace() {
  herdr workspace list \
    | jq -re '.result.workspaces[] | select(.focused) | .workspace_id' \
    || die "no focused workspace"
}

# Known agent providers — one list serves the agent-picker menu, agent-tab's
# fail-fast check, and its tab-family regex; the per-provider CLI shape still
# lives in dev-agent-argv.
providers="claude claudex codex opencode"

case "${1:-}" in
  tab)
    n="${2:?usage: herdr-nav tab N}"
    ws="$(focused_workspace)"
    tab="$(herdr tab list --workspace "$ws" \
      | jq -re --argjson n "$n" \
          '.result.tabs[] | select(.number == $n) | .tab_id')" \
      || exit 0  # no Nth tab — ignore, like zellij's GoToTab
    herdr tab focus "$tab" >/dev/null
    ;;
  resize)
    dir="${2:?usage: herdr-nav resize left|right|up|down}"
    ws="$(focused_workspace)"
    pane="$(herdr pane list --workspace "$ws" \
      | jq -re '.result.panes[] | select(.focused) | .pane_id')" \
      || die "no focused pane"
    herdr pane resize --direction "$dir" --pane "$pane" >/dev/null
    ;;
  agent-picker)
    command -v tv >/dev/null 2>&1 || die "agent-picker: television is not installed"
    provider="$(tv --source-command "printf '%s\\n' $providers" \
      --no-status-bar --input-header "New agent" < /dev/tty)" || exit 0
    [[ -n "$provider" ]] || exit 0
    exec "$0" agent-tab "$provider"
    ;;
  agent-tab)
    # Clone the dev-herdr "agent" tab layout into a new tab of the focused
    # workspace (agent + hunk review top row, dev/logs bottom row) so several
    # agents can share one checkout — no worktree needed. Provider and
    # project dir come from the workspace's existing agent pane; an explicit
    # PROVIDER argument overrides it (the ctrl+alt+a picker passes the chosen
    # agent). Tabs are labeled by provider, so mixed tabs stay tellable apart.
    provider_override="${2:-}"
    [[ -z "$provider_override" || " $providers " == *" $provider_override "* ]] \
      || die "agent-tab: unknown provider '$provider_override'"
    # Workspace id + label in one `workspace list` call.
    IFS=$'\t' read -r ws ws_label < <(herdr workspace list \
      | jq -re '.result.workspaces[] | select(.focused) | [.workspace_id, .label] | @tsv') \
      || die "no focused workspace"
    panes="$(herdr pane list --workspace "$ws")"
    src="$(jq -c '[.result.panes[] | select((.agent // "") != "")][0] // empty' <<<"$panes")"
    if [[ -n "$src" ]]; then
      provider="$(jq -r '.agent' <<<"$src")"
      dir="$(jq -r '.cwd' <<<"$src")"
    else
      provider="claude"
      dir="$(jq -re '.result.panes[] | select(.focused) | .cwd' <<<"$panes")" \
        || die "no focused pane"
    fi
    [[ -n "$provider_override" ]] && provider="$provider_override"
    # Tabs are labeled by provider — "claude", "claude 2", "claudex", ... —
    # one numbered family per provider. One pass over the tab labels finds
    # the next free suffix and the insertion point. Insert immediately after
    # the last agent tab so the agent block stays contiguous and lands before
    # the "git" and "nvim" tabs. If no agent tab exists, insert before the
    # first shared utility tab, or at the end if neither exists.
    read -r num insert_index < <(herdr tab list --workspace "$ws" \
      | jq -r --arg base "$provider" --arg fam "^(agent|${providers// /|})(?: [0-9]+)?\$" '
          [.result.tabs[].label] as $ls
          | ([$ls[] | capture("^\($base)(?: (?<n>[0-9]+))?$")
              | ((.n // "1") | tonumber)] | (max // 0) + 1) as $num
          | ([range(0; $ls | length) | select($ls[.] | test($fam))]
              | max // -1) as $last_agent
          | ([$ls | index("git"), index("nvim")] | map(select(. != null))
              | min // ($ls | length)) as $first_utility
          | (if $last_agent >= 0 then $last_agent + 1
             else $first_utility end) as $insert
          | "\($num) \($insert)"')
    label="$provider"; [[ "$num" -gt 1 ]] && label="$provider $num"

    tab_json="$(herdr tab create --workspace "$ws" --label "$label" --cwd "$dir")"
    t_new="$(jq -r '.result.tab.tab_id' <<<"$tab_json")"
    p_agent="$(jq -r '.result.root_pane.pane_id' <<<"$tab_json")"
    # tab create appends at the end (after nvim); move it up next to the other
    # agent tabs. tab.move is socket-only (no CLI verb); non-fatal.
    api tab.move "{\"tab_id\":\"$t_new\",\"insert_index\":$insert_index}" >/dev/null || true

    # Panes (agent + hunk review top row, dev/logs bottom row) are built by
    # herdr-agent-layout, shared with dev-herdr's create path. No -s: the
    # session comes from the inherited HERDR_SOCKET_PATH, like every other
    # herdr call in this script. The agent display name carries the tab
    # label: "ws (claude 2)".
    herdr-agent-layout "$p_agent" "$dir" "$provider" "$ws_label ($label)"

    # tab create does not switch the workspace's active tab — land on the
    # new agent explicitly.
    herdr tab focus "$t_new" >/dev/null
    ;;
  quit)
    # Stop the current session — detach its client window, then stop its
    # server (kills the agents; session.json survives). The session name
    # comes from the inherited socket path: named sessions live in
    # ~/.config/herdr/sessions/<name>/herdr.sock, the default session's
    # socket sits directly in ~/.config/herdr.
    session="default"
    sessions_dir="$HOME/.config/herdr/sessions"
    if [[ "${HERDR_SOCKET_PATH:-}" == "$sessions_dir"/?*/* ]]; then
      session="${HERDR_SOCKET_PATH#"$sessions_dir/"}"
      session="${session%%/*}"
    fi
    # herdr-clients stop tears down this very process's ancestors (the
    # client window, then the server that ran this shell bind) — detach
    # fully so the stop sequence survives its own teardown.
    setsid -f herdr-clients stop "$session" >/dev/null 2>&1 </dev/null
    ;;
  *)
    die "unknown command: ${1:-<none>} (expected: tab | resize | agent-picker | agent-tab | quit)"
    ;;
esac
