#!/usr/bin/env bash
# Navigation helper for herdr shell keybindings (~/.config/herdr/config.toml).
# Shell bindings run detached from any pane, so the target is resolved
# explicitly from the `focused` flags instead of relying on pane env.
#
# Usage: herdr-nav tab N            focus the Nth tab of the focused workspace
#        herdr-nav resize DIR       resize the focused pane (left|right|up|down)
#        herdr-nav agent-picker     pick an agent provider and name it, then
#                                   add it as a tab to the focused workspace
#        herdr-nav agent-tab [PROV [NAME]]
#                                   add another agent tab to the focused
#                                   workspace; PROV overrides the inherited
#                                   provider (e.g. codex for a GPT tab), NAME
#                                   labels the tab and the agent
#        herdr-nav files|git|review focus this workspace's tool tab — yazi,
#                                   lazygit, tuicr — creating it on the focused
#                                   pane's cwd when it has none (the
#                                   ctrl+alt+f/g/r binds; ctrl+alt+w closes
#                                   one again). See tool_tab.
#        herdr-nav review-run       tuicr on the cwd, or its commit selector
#                                   when the tree is clean — the review tab's
#                                   pane command, via herdr-pane-cmd tuicr
#        herdr-nav quit             stop the current session and close its
#                                   client window (the in-herdr `hss`)
set -euo pipefail

die() { echo "herdr-nav: $*" >&2; exit 1; }

# Call a herdr socket API method not exposed on the CLI (e.g. tab.move).
# Uses the same socket the CLI resolves: the session inherited via
# HERDR_SOCKET_PATH (shell binds run inside a pane), else the default session.
# Prints the JSON response; non-fatal on failure.
api() {
  # NB: don't default params with ${2:-{}} — the first } closes the expansion
  # and a literal } gets appended to $2, producing invalid JSON.
  local method="$1" params="${2:-}"
  [[ -n "$params" ]] || params='{}'
  local sock="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
  [[ -S "$sock" ]] || return 1
  printf '{"id":"1","method":"%s","params":%s}\n' "$method" "$params" \
    | socat - "UNIX-CONNECT:$sock" 2>/dev/null
}

focused_workspace() {
  herdr workspace list \
    | jq -re '.result.workspaces[] | select(.focused) | .workspace_id' \
    || die "no focused workspace"
}

# Focus the focused workspace's TAB_LABEL tab, creating it on the focused
# pane's cwd if it has none. Backs the ctrl+alt+f/g/r tool binds (yazi,
# lazygit, tuicr), which were popups until they all grew the same two
# problems: a popup is session-modal, so the sidebar and tab bar keep
# rendering while silently swallowing clicks (it reads as a hung UI), and it
# forgets its cwd, filters and selection the moment you look away. A tab keeps
# its state while you work in other tabs, and ctrl+alt+w disposes of it.
# On demand rather than in herdr-pane-cmd --util-tabs, which would give one to
# every workspace: idle, yazi is 28MB and ~0.4% of a core (it never fully
# idles), lazygit 17MB and tuicr 26MB at 0 measurable CPU — but ~15 workspaces
# turns even the free-looking ones into hundreds of MB standing by. Created by
# keypress, the cost follows actual use.
# PANE_LABEL defaults to TAB_LABEL and is worth overriding only because pane
# labels are a global command map, not decoration: herdr-clients revive-panes
# feeds them to herdr-pane-cmd to rebuild the command after a server restart.
# "review" is already taken there by the agent tab's hunk pane, so the review
# tab's pane is labeled "tuicr" while the tab itself still reads "review" —
# the one call below passing two words is flagging exactly that.
# Usage: tool_tab TAB_LABEL [PANE_LABEL]
tool_tab() {
  local tab_label="$1" pane_label="${2:-$1}" ws tab dir tab_json t_new p_new
  ws="$(focused_workspace)"
  # Reuse before create, like dev-herdr's reattach path: a second press should
  # return to the tool you left, not stack up another copy of it.
  tab="$(herdr tab list --workspace "$ws" \
    | jq -r --arg l "$tab_label" \
        '.result.tabs[] | select(.label == $l) | .tab_id' | head -n1)"
  if [[ -n "$tab" ]]; then
    herdr tab focus "$tab" >/dev/null
    return
  fi
  # Open on the checkout being worked in, not the workspace root — these tools
  # are all about the current repo.
  dir="$(herdr pane list --workspace "$ws" \
    | jq -re '.result.panes[] | select(.focused) | .cwd')" \
    || die "no focused pane"
  # create → label the root pane → run, dev-herdr's util_tab sequence.
  # Appending puts these after the nvim tab, keeping utility tabs at the end;
  # agent-tab inserts before them and is unaffected, since it counts agent and
  # provider-labeled panes and these are neither.
  tab_json="$(herdr tab create --workspace "$ws" --label "$tab_label" \
    --cwd "$dir" --no-focus)"
  t_new="$(jq -r '.result.tab.tab_id' <<<"$tab_json")"
  p_new="$(jq -r '.result.root_pane.pane_id' <<<"$tab_json")"
  [[ -n "$p_new" && "$p_new" != null ]] ||
    die "tab create returned no pane id: $tab_json"
  herdr pane rename "$p_new" "$pane_label" >/dev/null
  herdr pane run "$p_new" "$(herdr-pane-cmd "$pane_label")" >/dev/null
  # --no-focus above, then focus explicitly: same order as dev-herdr, so the
  # pane is labeled and running before it is looked at.
  herdr tab focus "$t_new" >/dev/null
}

# Known agent providers — one list serves the agent-picker menu, agent-tab's
# fail-fast check, and its tab-family regex; the per-provider CLI shape still
# lives in dev-agent-argv.
providers="claude codex opencode"

case "${1:-}" in
  tab)
    n="${2:?usage: herdr-nav tab N}"
    ws="$(focused_workspace)"
    tab="$(herdr tab list --workspace "$ws" \
      | jq -re --argjson n "$n" \
          '.result.tabs[] | select(.number == $n) | .tab_id')" \
      || exit 0  # no Nth tab — ignore rather than error
    herdr tab focus "$tab" >/dev/null
    ;;
  resize)
    dir="${2:?usage: herdr-nav resize left|right|up|down}"
    ws="$(focused_workspace)"
    pane="$(herdr pane list --workspace "$ws" \
      | jq -re '.result.panes[] | select(.focused) | .pane_id')" \
      || die "no focused pane"
    herdr pane resize --direction "$dir" --pane "$pane" >/dev/null
    ;;
  agent-picker)
    command -v tv >/dev/null 2>&1 || die "agent-picker: television is not installed"
    provider="$(tv --source-command "printf '%s\\n' $providers" \
      --no-status-bar --input-header "New agent" < /dev/tty)" || exit 0
    [[ -n "$provider" ]] || exit 0
    # A name for the tab, nothing else — it is not typed into the agent (a
    # name is not a prompt, and having it submitted is a surprise). It also
    # becomes the agent's display name (claude -n, so its resume picker and
    # terminal title agree with the tab). Enter on an empty input keeps the
    # numbered tab — herdr-agent-title renames it after the first exchange
    # instead. Esc cancels the whole thing.
    name=""
    if command -v gum >/dev/null 2>&1; then
      name="$(gum input --header "$provider" --char-limit 0 \
        --placeholder "Name this agent (optional)" </dev/tty)" || exit 0
    fi
    exec "$0" agent-tab "$provider" "$name"
    ;;
  agent-tab)
    # Clone the dev-herdr "agent" tab layout into a new tab of the focused
    # workspace (agent + hunk review top row, dev/logs bottom row) so several
    # agents can share one checkout — no worktree needed. Provider and
    # project dir come from the workspace's existing agent pane; an explicit
    # PROVIDER argument overrides it (the ctrl+alt+a picker passes the chosen
    # agent). Tabs are labeled by NAME when one was given, by provider (+
    # number) otherwise, so several agents on one checkout stay tellable
    # apart. NAME labels the tab and names the agent; it is never typed into
    # the agent, which starts on an empty prompt like any other tab.
    provider_override="${2:-}"; name="${3:-}"
    [[ -z "$provider_override" || " $providers " == *" $provider_override "* ]] \
      || die "agent-tab: unknown provider '$provider_override'"
    # Workspace id + label in one `workspace list` call.
    IFS=$'\t' read -r ws ws_label < <(herdr workspace list \
      | jq -re '.result.workspaces[] | select(.focused) | [.workspace_id, .label] | @tsv') \
      || die "no focused workspace"
    panes="$(herdr pane list --workspace "$ws")"
    src="$(jq -c '[.result.panes[] | select((.agent // "") != "")][0] // empty' <<<"$panes")"
    if [[ -n "$src" ]]; then
      provider="$(jq -r '.agent' <<<"$src")"
      dir="$(jq -r '.cwd' <<<"$src")"
    else
      provider="claude"
      dir="$(jq -re '.result.panes[] | select(.focused) | .cwd' <<<"$panes")" \
        || die "no focused pane"
    fi
    [[ -n "$provider_override" ]] && provider="$provider_override"
    # Where to insert, and what to call it. Agent tabs are found through their
    # panes — a pane herdr detected an agent in, or one labeled with a
    # provider (herdr-agent-layout labels the agent pane, and revive-panes
    # needs that label to stay a provider name). Tab labels cannot answer
    # this any more: they carry task names now, not "claude 2".
    # Insert right after the last agent tab so the agent block stays
    # contiguous and lands before the shared utility tabs (nvim); with no
    # agent tab, insert at the front.
    # The number is still needed for an unnamed tab, and it is per provider —
    # "claude", "claude 2", "codex" — so it comes from the labels that still
    # look like that. Renamed tabs drop out of the family and free their
    # number, which is fine: it is a placeholder, not an identity.
    read -r num insert_index < <(herdr tab list --workspace "$ws" \
      | jq -r --arg base "$provider" --arg provs "$providers" --argjson panes "$panes" '
          ($provs | split(" ")) as $ps
          | [$panes.result.panes[]?
             | select(((.agent // "") != "") or IN(.label; $ps[]))
             | .tab_id] as $agent_tabs
          | ([.result.tabs[].label | capture("^\($base)(?: (?<n>[0-9]+))?$")
              | ((.n // "1") | tonumber)] | (max // 0) + 1) as $num
          | ([.result.tabs | to_entries[]
              | select(IN(.value.tab_id; $agent_tabs[])) | .key] | max // -1) as $last_agent
          | "\($num) \($last_agent + 1)"')
    # A name the user typed wins over the numbered placeholder: it labels the
    # tab, it is the agent's display name (so Claude's own resume picker and
    # terminal title agree with the tab), and -k pin tells herdr-agent-title to
    # hold it against the name it would otherwise guess.
    kind=seed; label=""
    [[ -n "$name" ]] && label="$(herdr-task-name "$name" || true)"
    if [[ -n "$label" ]]; then
      kind=pin
      display="$label"
    else
      label="$provider"; [[ "$num" -gt 1 ]] && label="$provider $num"
      display="$ws_label ($label)"
    fi

    tab_json="$(herdr tab create --workspace "$ws" --label "$label" --cwd "$dir")"
    t_new="$(jq -r '.result.tab.tab_id' <<<"$tab_json")"
    p_agent="$(jq -r '.result.root_pane.pane_id' <<<"$tab_json")"
    # tab create appends at the end (after nvim); move it up next to the other
    # agent tabs. tab.move is socket-only (no CLI verb); non-fatal.
    api tab.move "{\"tab_id\":\"$t_new\",\"insert_index\":$insert_index}" >/dev/null || true

    # Panes (agent + hunk review top row, dev/logs bottom row) are built by
    # herdr-agent-layout, shared with dev-herdr's create path. No -s: the
    # session comes from the inherited HERDR_SOCKET_PATH, like every other
    # herdr call in this script. Unnamed tabs keep the old display name
    # ("ws (claude 2)") until the agent has a title of its own.
    herdr-agent-layout -k "$kind" "$p_agent" "$dir" "$provider" "$display"

    # tab create does not switch the workspace's active tab — land on the
    # new agent explicitly.
    herdr tab focus "$t_new" >/dev/null
    ;;
  files)  tool_tab files ;;
  git)    tool_tab git ;;
  review) tool_tab review tuicr ;;
  review-run)
    # tuicr as the review tab's pane command (herdr-pane-cmd tuicr), so
    # revive-panes rebuilds it after a server restart. No cd: the pane already
    # opened on the checkout tool_tab resolved. The passive live diff stays in
    # the agent tab's hunk pane; tuicr is the typed-comments tool (export with
    # y/:clip, or read back via `tuicr review comments`).
    # -w alone skips the commit selector, so on a clean tree tuicr has nothing
    # to show and exits — as a popup that flashed and closed; in a tab it drops
    # to a bare shell. Fall back to the selector (plain tuicr) when nothing is
    # dirty. The probes mirror tuicr's own "anything to show" test (git backend
    # only — a tuicr upgrade may obsolete this) and stop at the first hit,
    # where a `git status --porcelain` would scan the whole tree ahead of tuicr
    # scanning it again.
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null \
        || [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null | head -c1)" ]]; then
      exec tuicr -w
    fi
    exec tuicr
    ;;
  detach|quit)
    # Resolve the current session from the inherited socket path: named
    # sessions live in ~/.config/herdr/sessions/<name>/herdr.sock, while the
    # default session's socket sits directly in ~/.config/herdr.
    session="default"
    sessions_dir="$HOME/.config/herdr/sessions"
    if [[ "${HERDR_SOCKET_PATH:-}" == "$sessions_dir"/?*/* ]]; then
      session="${HERDR_SOCKET_PATH#"$sessions_dir/"}"
      session="${session%%/*}"
    fi
    # Both operations tear down this process's client-window ancestors; quit
    # also stops the server that ran this shell bind. Fully detach the helper
    # so the sequence survives its own teardown.
    action="$1"
    [[ "$action" == quit ]] && action=stop
    setsid -f herdr-clients "$action" "$session" >/dev/null 2>&1 </dev/null
    ;;
  *)
    die "unknown command: ${1:-<none>} (expected: tab | resize | agent-picker | agent-tab | files | git | review | review-run | detach | quit)"
    ;;
esac
