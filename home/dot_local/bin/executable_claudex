#!/usr/bin/env bash
# Claude Code on the ChatGPT subscription: start the local claude-code-proxy
# (Anthropic-compatible translator, github.com/raine/claude-code-proxy) if
# needed, point this one process at it via env, and exec the regular `claude`
# CLI. Env is per-process, so plain `claude` sessions keep talking to
# Anthropic, and exec-ing `claude` keeps the resume shim and herdr's agent
# detection working.
#
# One-time setup: claude-code-proxy codex auth login
# Models can be overridden per call: ANTHROPIC_MODEL=gpt-5.5 claudex
set -euo pipefail

command -v claude-code-proxy >/dev/null 2>&1 || {
  echo "claudex: claude-code-proxy not installed (packages/groups/development.yaml custom_install)" >&2
  exit 127
}

# Refuse to enter Claude Code's retry loop with a missing or locally expired
# Codex credential. A live request below also catches credentials that look
# current locally but are rejected upstream.
if ! auth_status="$(claude-code-proxy codex auth status 2>&1)"; then
  echo "claudex: ChatGPT authentication is unavailable" >&2
  echo "$auth_status" >&2
  echo "Run: claude-code-proxy codex auth login" >&2
  exit 1
fi

unit=claude-code-proxy.service
if ! systemctl --user is-active --quiet "$unit"; then
  # A unit freshly placed by `chezmoi apply` is unknown until a daemon-reload.
  systemctl --user start "$unit" 2>/dev/null || {
    systemctl --user daemon-reload
    systemctl --user start "$unit"
  }
  # Wait for the proxy to listen so claude's first request doesn't race it.
  proxy_ready=false
  for _ in $(seq 1 50); do
    if (exec 3<>/dev/tcp/127.0.0.1/18765) 2>/dev/null; then
      proxy_ready=true
      break
    fi
    sleep 0.1
  done
  if ! $proxy_ready; then
    echo "claudex: proxy did not become ready on 127.0.0.1:18765" >&2
    echo "Check: journalctl --user -u $unit -n 50" >&2
    exit 1
  fi
fi

export ANTHROPIC_BASE_URL="http://127.0.0.1:18765"
export ANTHROPIC_AUTH_TOKEN="unused"
# [1m] hints the larger Codex context window to Claude Code without changing
# the upstream model; auto-compact is raised to match (GPT-5.6 = 272k).
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-gpt-5.6-sol[1m]}"
export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-gpt-5.6-luna[1m]}"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-272000}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
# Match the guarded Claude Code setup used successfully with GPT: make the
# subagent route explicit, bound parallel tool fan-out, retain effort controls,
# and avoid dynamic tool discovery expanding an ordinary request.
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-${ANTHROPIC_MODEL%\[1m\]}}"
export CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY="${CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY:-3}"
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT="${CLAUDE_CODE_ALWAYS_ENABLE_EFFORT:-1}"
export ENABLE_TOOL_SEARCH="${ENABLE_TOOL_SEARCH:-false}"

# Exercise the authenticated upstream once before Claude Code can fan a failed
# request out to plugins and subagents. This spends only a one-token response.
command -v curl >/dev/null 2>&1 || {
  echo "claudex: curl is required for the proxy authentication preflight" >&2
  exit 127
}
preflight_response="$(curl --silent --show-error --max-time 20 \
  --header 'content-type: application/json' \
  --header "x-api-key: $ANTHROPIC_AUTH_TOKEN" \
  --data "{\"model\":\"$ANTHROPIC_MODEL\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"OK\"}]}" \
  --write-out $'\n%{http_code}' \
  "$ANTHROPIC_BASE_URL/v1/messages")" || {
    echo "claudex: proxy authentication preflight could not reach the upstream" >&2
    exit 1
  }
preflight_status="${preflight_response##*$'\n'}"
if [[ "$preflight_status" != 2* ]]; then
  preflight_body="${preflight_response%$'\n'*}"
  echo "claudex: proxy authentication preflight failed (HTTP $preflight_status)" >&2
  [[ -n "$preflight_body" ]] && echo "$preflight_body" >&2
  echo "Run: claude-code-proxy codex auth login" >&2
  exit 1
fi

exec claude --no-chrome "$@"
