#!/bin/bash
set -euo pipefail

# hypr-keybindings — parse the Hyprland keybindings out of binds.lua.
#
# Prints one tab-separated row per binding: <section>\t<combo>\t<description>.
# It renders nothing: the vicinae Keybindings command is the frontend, and this
# is only the parser. It used to be `rofi-keybindings` and carried a nerd-font
# icon map plus a dmenu invocation; both went with rofi.
#
# The awk below stays the only thing in the repo that understands binds.lua —
# 200 lines of Lua-aware string walking, with balanced parens, long strings and
# the `for i = 1, 7` expansion. A second copy in TypeScript would be wrong about
# a different subset of the config within a month.

# ── Compositor detection ──────────────────────────────────────────

. "$HOME/.local/lib/compositor.sh"

if ! is_hyprland; then
    notify-send -u critical "hypr-keybindings" "No supported compositor detected"
    exit 1
fi

# ── Section icons (Nerd Font) ─────────────────────────────────────



# ── Shared awk: XF86 key descriptions ─────────────────────────────

XF86_AWK='
function xf86(k) {
    if (k == "XF86AudioRaiseVolume") return "Volume up"
    if (k == "XF86AudioLowerVolume") return "Volume down"
    if (k == "XF86AudioMute")        return "Mute toggle"
    if (k == "XF86AudioMicMute")     return "Mic mute toggle"
    if (k == "XF86AudioPlay")        return "Play / Pause"
    if (k == "XF86AudioStop")        return "Stop playback"
    if (k == "XF86AudioPrev")        return "Previous track"
    if (k == "XF86AudioNext")        return "Next track"
    if (k == "XF86MonBrightnessUp")  return "Brightness up"
    if (k == "XF86MonBrightnessDown") return "Brightness down"
    return ""
}
'

# ── Hyprland parser (Lua config, Hyprland 0.55+) ──────────────────

parse_hyprland() {
    local config="$HOME/.config/hypr/conf/binds.lua"
    [ -f "$config" ] || { echo "Config not found: $config" >&2; return 1; }

    awk "$XF86_AWK"'
    function dir_name(d) {
        if (d == "r") return "right"
        if (d == "l") return "left"
        if (d == "u") return "up"
        if (d == "d") return "down"
        return d
    }

    function ws_name(w) {
        if (w == "r-1") return "prev"
        if (w == "r+1") return "next"
        if (w == "e-1") return "prev (non-empty)"
        if (w == "e+1") return "next (non-empty)"
        if (w == "special") return "scratchpad"
        return w
    }

    # Humanize an hl.dsp.* dispatcher expression when no trailing -- comment.
    function humanize(disp,    m, val, silent, cmd, x, y, v) {
        sub(/^[ \t]+/, "", disp)

        if (match(disp, /hl\.dsp\.focus\([^)]*direction[ \t]*=[ \t]*"[^"]+"/)) {
            m = substr(disp, RSTART, RLENGTH)
            match(m, /"[^"]+"/); val = substr(m, RSTART+1, RLENGTH-2)
            return "Focus " dir_name(val)
        }
        if (match(disp, /hl\.dsp\.focus\([^)]*workspace[ \t]*=/)) {
            if (match(disp, /workspace[ \t]*=[ \t]*tostring\(i\)/)) return "Workspace <I>"
            if (match(disp, /workspace[ \t]*=[ \t]*"[^"]+"/)) {
                m = substr(disp, RSTART, RLENGTH); match(m, /"[^"]+"/)
                val = substr(m, RSTART+1, RLENGTH-2)
                return "Workspace " ws_name(val)
            }
            return "Workspace"
        }
        if (match(disp, /hl\.dsp\.window\.move\([^)]*workspace[ \t]*=/)) {
            silent = (disp ~ /follow[ \t]*=[ \t]*false/) ? " (silent)" : ""
            if (match(disp, /workspace[ \t]*=[ \t]*tostring\(i\)/)) return "Move to workspace <I>" silent
            if (match(disp, /workspace[ \t]*=[ \t]*"[^"]+"/)) {
                m = substr(disp, RSTART, RLENGTH); match(m, /"[^"]+"/)
                val = substr(m, RSTART+1, RLENGTH-2)
                return "Move to workspace " ws_name(val) silent
            }
            return "Move to workspace" silent
        }
        if (match(disp, /hl\.dsp\.window\.move\([^)]*direction[ \t]*=[ \t]*"[^"]+"/)) {
            m = substr(disp, RSTART, RLENGTH)
            match(m, /direction[ \t]*=[ \t]*"[^"]+"/); val = substr(m, RSTART, RLENGTH)
            match(val, /"[^"]+"/); val = substr(val, RSTART+1, RLENGTH-2)
            return "Move window " dir_name(val)
        }
        if (match(disp, /hl\.dsp\.window\.resize\(/)) {
            x = 0; y = 0
            if (match(disp, /x[ \t]*=[ \t]*-?[0-9]+/)) {
                v = substr(disp, RSTART, RLENGTH); sub(/.*=[ \t]*/, "", v); x = v + 0
            }
            if (match(disp, /y[ \t]*=[ \t]*-?[0-9]+/)) {
                v = substr(disp, RSTART, RLENGTH); sub(/.*=[ \t]*/, "", v); y = v + 0
            }
            if (x > 0) return "Resize right"
            if (x < 0) return "Resize left"
            if (y > 0) return "Resize down"
            if (y < 0) return "Resize up"
            return "Resize"
        }
        if (match(disp, /hl\.dsp\.window\.tag\(/))   return "Toggle opacity"
        if (match(disp, /hl\.dsp\.window\.drag\(/))  return "Drag window"
        if (match(disp, /hl\.dsp\.window\.close\(/)) return "Close window"
        if (match(disp, /hl\.dsp\.window\.pin\(/))   return "Pin window"
        if (match(disp, /hl\.dsp\.group\.toggle\(/)) return "Toggle group"
        if (match(disp, /hl\.dsp\.group\.next\(/))   return "Group next"
        if (match(disp, /hl\.dsp\.group\.prev\(/))   return "Group prev"
        if (match(disp, /hl\.dsp\.exit\(/))          return "Exit Hyprland"

        if (match(disp, /hl\.dsp\.exec_cmd\(/)) {
            cmd = substr(disp, RSTART + RLENGTH)
            sub(/^[ \t]*home[ \t]*\.\.[ \t]*"/, "\"", cmd)
            if (match(cmd, /"[^"]+"/)) {
                v = substr(cmd, RSTART + 1, RLENGTH - 2)
                sub(/[ \t].*/, "", v)
                sub(/.*\//, "", v)
                sub(/\.[a-zA-Z0-9]+$/, "", v)
                gsub(/-/, " ", v)
                if (v != "") return toupper(substr(v, 1, 1)) substr(v, 2)
            }
            return "Run command"
        }
        return ""
    }

    function build_combo(expr,    s, n, i, p, out, parts) {
        s = expr
        gsub(/^[ \t]+|[ \t]+$/, "", s)
        gsub(/\<mod\>/, "\"Mod\"", s)
        gsub(/\<key\>/, "\"<I>\"", s)
        gsub(/tostring\(i\)/, "\"<I>\"", s)
        while (gsub(/"[ \t]*\.\.[ \t]*"/, "", s)) {}
        gsub(/"/, "", s)
        gsub(/[ \t]*\+[ \t]*/, "+", s)
        n = split(s, parts, "+")
        out = ""
        for (i = 1; i <= n; i++) {
            p = parts[i]
            if (p == "SUPER")        p = "Mod"
            else if (p == "ALT")     p = "Alt"
            else if (p == "CTRL")    p = "Ctrl"
            else if (p == "SHIFT")   p = "Shift"
            else if (p == "RETURN")  p = "Return"
            else if (p == "SPACE")   p = "Space"
            else if (p == "TAB")     p = "Tab"
            else if (p == "PRINT")   p = "Print"
            else if (p == "left" || p == "right" || p == "up" || p == "down")
                p = toupper(substr(p, 1, 1)) substr(p, 2)
            out = (i == 1) ? p : out "+" p
        }
        return out
    }

    BEGIN { section = ""; in_for_i = 0 }

    # Section headers: -- ── N. Name ─────
    /^-- ── [0-9]+[a-z]?\./ {
        s = $0
        sub(/^-- ── [0-9]+[a-z]?\. /, "", s)
        sub(/ ─+$/, "", s)
        sub(/ \(.*\)$/, "", s)
        section = s; next
    }

    # Physical number-row loop: show its AZERTY symbols as workspace 1..7.
    /for i, key in ipairs\(workspace_keys\) do/ { in_for_i = 1; next }

    /^[ \t]*end[ \t]*$/ {
        if (in_for_i) in_for_i = 0
        next
    }

    /^[ \t]*--/            { next }
    /^[ \t]*$/             { next }

    /hl\.bind\(/ {
        line = $0

        # Trailing -- comment (description)
        comment = ""
        if (match(line, /\)[ \t]+-- /)) {
            comment = substr(line, RSTART + RLENGTH)
            sub(/[ \t]+$/, "", comment)
        }

        # Parse hl.bind(arg1, arg2 ...): extract first and second top-level args.
        # Handle "..." strings, [[...]] long strings, and nested parens.
        if (!match(line, /hl\.bind\(/)) next
        rest = substr(line, RSTART + RLENGTH)
        depth = 0; in_str = 0; in_lstr = 0; arg = ""; nn = length(rest); split_at = 0
        for (k = 1; k <= nn; k++) {
            c = substr(rest, k, 1); c2 = substr(rest, k, 2)
            if (in_lstr) {
                arg = arg c
                if (c2 == "]]") { in_lstr = 0; arg = arg "]"; k++ }
                continue
            }
            if (in_str) {
                arg = arg c
                if (c == "\\") { arg = arg substr(rest, k+1, 1); k++; continue }
                if (c == "\"") in_str = 0
                continue
            }
            if (c2 == "[[") { in_lstr = 1; arg = arg "[["; k++; continue }
            if (c == "\"") { in_str = 1; arg = arg c; continue }
            if (c == "(") { depth++; arg = arg c; continue }
            if (c == ")") { if (depth == 0) break; depth--; arg = arg c; continue }
            if (c == "," && depth == 0) { split_at = k; break }
            arg = arg c
        }

        second = ""
        if (split_at > 0) {
            rest2 = substr(rest, split_at + 1)
            depth = 0; in_str = 0; in_lstr = 0; nn2 = length(rest2)
            for (k = 1; k <= nn2; k++) {
                c = substr(rest2, k, 1); c2 = substr(rest2, k, 2)
                if (in_lstr) {
                    second = second c
                    if (c2 == "]]") { in_lstr = 0; second = second "]"; k++ }
                    continue
                }
                if (in_str) {
                    second = second c
                    if (c == "\\") { second = second substr(rest2, k+1, 1); k++; continue }
                    if (c == "\"") in_str = 0
                    continue
                }
                if (c2 == "[[") { in_lstr = 1; second = second "[["; k++; continue }
                if (c == "\"") { in_str = 1; second = second c; continue }
                if (c == "(") { depth++; second = second c; continue }
                if (c == ")") { if (depth == 0) break; depth--; second = second c; continue }
                if (c == "," && depth == 0) break
                second = second c
            }
        }

        combo = build_combo(arg)

        desc = comment
        if (desc == "") desc = humanize(second)
        if (desc == "" && combo ~ /XF86/) {
            xfk = combo; sub(/.*\+/, "", xfk)
            desc = xf86(xfk); if (desc == "") desc = xfk
        }
        if (desc == "") desc = "(no description)"

        # Tab-separated fields: <section>\t<combo>\t<description>.
        if (in_for_i && combo ~ /<I>/) {
            for (j = 1; j <= 7; j++) {
                c2 = combo; gsub(/<I>/, j, c2)
                d2 = desc;  gsub(/<I>/, j, d2)
                printf "%s\t%s\t%s\n", section, c2, d2
            }
        } else {
            printf "%s\t%s\t%s\n", section, combo, desc
        }
    }
    ' "$config"
}

# ── Main ──────────────────────────────────────────────────────────

# One mode, so no argument. `--list` existed only to mean "do not open rofi".
parse_hyprland
