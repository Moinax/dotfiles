#!/bin/sh
# wtype wrapper.
#
# Why: on this Hyprland + AZERTY (fr) setup, /usr/bin/wtype's character-by-
# character typing drops spaces (verified: hyprvoice calls `wtype -- <text>`
# with spaces, wtype types them out without). Upstream regression (libxkbcommon
# 1.13.2 / Hyprland 0.55.4 — "it worked before"). So for plain-text typing we
# inject the text by other means instead of synthesizing each character.
#
# Real flag/modifier calls (`wtype -M ctrl v` for an actual paste) MUST pass
# straight through, or we'd recurse.

# hyprvoice calls `wtype -- <text>`; drop the leading `--` so $1 becomes text.
[ "$1" = "--" ] && shift

# `wtype -` (stdin) is how the clipboard picker feeds us the selected entry
# (`cliphist decode | wtype -`). Read it and inject it like any other text:
# replaying it keystroke by keystroke turns every newline into Enter, so a
# multi-line entry reaches a TUI as one submitted line after another (Claude
# Code saw N messages instead of one paste).
if [ "$1" = "-" ] && [ $# -eq 1 ]; then
    text=$(cat)                       # command substitution drops the trailing
    [ -n "$text" ] || exit 0          # newline, which would submit on its own
else
    case "$1" in
        -* | '')
            exec /usr/bin/wtype "$@"
            ;;
    esac
    text=$*
fi

# Inspect the focused window once — and parse it once: two `jq` runs over the
# same object cost a second fork to answer half a question, and on the kitty path
# below (which exits) $class is never read at all.
info=$(hyprctl activewindow -j 2>/dev/null)
IFS='	' read -r class pid <<EOF
$(printf '%s' "$info" | jq -r '[.class // "", .pid // ""] | @tsv' 2>/dev/null)
EOF

# kitty: a paste shortcut would be consumed by whatever runs inside (herdr
# rebinds keys of its own), so use kitty's remote control (allow_remote_control
# + listen_on unix:/tmp/kitty-{pid}) to inject the text directly into the
# focused window. No clipboard, no shortcut. Matched on the socket, not the
# class — herdr-clients launches kitty as `--class herdr` / `herdr-labs`.
# `--bracketed-paste auto` wraps the text in ESC[200~ …201~ when the program
# has bracketed paste on (herdr does, and forwards the paste to its focused
# pane), so multi-line text arrives as one block instead of a line per Enter.
if [ -S "/tmp/kitty-$pid" ] && printf '%s' "$text" | kitty @ \
    --to "unix:/tmp/kitty-$pid" send-text --stdin --bracketed-paste auto 2>/dev/null; then
    exit 0
fi

# Everything else: copy + paste (reliable here — same path as the emoji picker).
# `-k v` sends the V *key* (not the character, which mistypes under Shift).
printf '%s' "$text" | wl-copy
# `*[Tt]erm*` is the catch-all and subsumes the wezterm/Terminal spellings this
# used to list beside it (verified against both sets); only the classes with no
# "term" in them need naming.
case "$class" in
    foot | Alacritty | kitty | herdr* | *[Tt]erm*)
        exec /usr/bin/wtype -M ctrl -M shift -k v -m shift -m ctrl
        ;;
    *)
        exec /usr/bin/wtype -M ctrl -k v -m ctrl
        ;;
esac
