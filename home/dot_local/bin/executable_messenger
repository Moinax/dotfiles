#!/usr/bin/env python3
"""Launch Facebook Messenger in the shared Qt WebEngine chat shell."""

# The exec bit comes from chezmoi's executable_ prefix at apply time.
# ruff: noqa: EXE001

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from chat_shell import EXTERNAL, ChatApp, run

AUTH_PATH_PREFIXES = (
    "/login",
    "/two_step_verification",
    "/checkpoint",
    "/authentication",
    "/captcha",
    "/recover",
    "/common/referer_frame.php",
    "/privacy/consent",
    "/cookie",
)


def rewrite_facebook_navigation(host, path, user_initiated):
    """Keep Messenger's post-authentication redirects out of full Facebook.

    A Facebook link the user clicked (a shared post, a profile) is content,
    not a redirect: it opens in the default browser instead of being folded
    back onto the Messenger home page, which reads as the app reloading.
    """
    if not (host == "facebook.com" or host.endswith(".facebook.com")):
        return None
    if path.startswith(AUTH_PATH_PREFIXES):
        return None
    match = re.match(r"^/messages/t/(\w+)", path)
    if match:
        return f"https://www.messenger.com/t/{match.group(1)}/"
    return EXTERNAL if user_initiated else "https://www.messenger.com/"


CONFIG = ChatApp(
    app_id="messenger",
    title="Messenger",
    url="https://www.messenger.com/?locale=fr_FR",
    domains=("messenger.com", "facebook.com", "fbsbx.com", "fbcdn.net"),
    notification_origins=(
        "https://www.messenger.com",
        "https://www.facebook.com",
    ),
    debug_variable="MESSENGER_DEBUG",
    # The regular favicon is too small for notifications.
    fixed_icon_size=512,
    rewrite_navigation=rewrite_facebook_navigation,
)


if __name__ == "__main__":
    sys.exit(run(CONFIG))
