#!/usr/bin/env bash
# Create — or focus — a Herdr workspace for a project:
#   tab "agent":   agent (top-left) + lazygit (top-right); bottom
#                  row = "dev" + "logs" terminals (both plain shells)
#   tab "nvim":    full-window nvim
#
# Workspaces are grouped into one Herdr session per ~/Projects subdirectory
# (labs, mbrella, o27, ...): each group gets its own server + client window
# (kitty class "herdr-<group>") showing only that group's workspaces in the
# agent-status sidebar. Projects outside ~/Projects land in the default
# session (class "herdr"). All sessions share ~/.config/herdr/config.toml.
# Reattaching = focusing the existing workspace; Herdr itself keeps agents
# alive and (with the claude integration) restores their sessions.
#
# Usage: dev-herdr -n NAME -d DIR -p PROVIDER [-- PROMPT]
# HERDR_DEV_SESSION=<name> overrides the path-derived session.
set -euo pipefail

die() { echo "dev-herdr: $*" >&2; exit 1; }
command -v herdr >/dev/null 2>&1 || die "herdr not installed (paru -S herdr-bin)"
command -v jq    >/dev/null 2>&1 || die "jq is required"

name=""; dir="$PWD"; provider="claude"; prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) name="$2"; shift 2 ;;
    -d) dir="$2"; shift 2 ;;
    -p) provider="$2"; shift 2 ;;
    --) shift; prompt="${1:-}"; break ;;
    *)  shift ;;
  esac
done
dir="$(cd "$dir" && pwd)"
[[ -z "$name" ]] && name="$(basename "$dir")"
[[ "$provider" != claude ]] && name="$name ($provider)"

# --- session --------------------------------------------------------------
# Session = first path component under ~/Projects (labs, mbrella, o27, ...);
# anything else (including projects sitting directly in ~/Projects) uses the
# default session. "default" is herdr's reserved alias for it, so --session
# can be passed uniformly. Explicit --session on every call also beats the
# HERDR_SOCKET_PATH env inherited when launched from inside a herdr pane
# (e.g. the dev-pick popup), which would otherwise pin the current session.
session="${HERDR_DEV_SESSION:-}"
if [[ -z "$session" ]]; then
  case "$dir" in
    "$HOME/Projects"/*/*) session="${dir#"$HOME/Projects/"}"; session="${session%%/*}" ;;
    *) session="default" ;;
  esac
fi
session="${session//[^[:alnum:]_.-]/_}"
h() { herdr --session "$session" "$@"; }

# --- server ---------------------------------------------------------------
# The CLI does not auto-start the server, so bring it up headless if needed.
# The boot-and-poll dance is owned by herdr-clients (shared with the desktop
# show / open-all keybinds); it dies with its own message on failure.
herdr-clients ensure-server "$session"

# --- client window (one per session; kitty class "herdr" / "herdr-<name>") -
# Focus-or-launch lives in herdr-clients (shared with the desktop open-all /
# detach-all keybinds); it also scrubs inherited HERDR_* vars.
show_client() {
  herdr-clients show "$session"
}

# --- reattach path: workspace already exists ------------------------------
existing="$(h workspace list \
  | jq -r --arg l "$name" '.result.workspaces[]? | select(.label == $l) | .workspace_id' \
  | head -n1)"
if [[ -n "$existing" ]]; then
  h workspace focus "$existing" >/dev/null
  show_client
  exit 0
fi

# --- create path ----------------------------------------------------------
ws_json="$(h workspace create --cwd "$dir" --label "$name" --no-focus)"
ws="$(jq -r '.result.workspace.workspace_id' <<<"$ws_json")"
p_agent="$(jq -r '.result.root_pane.pane_id' <<<"$ws_json")"
t_agent="$(jq -r '.result.tab.tab_id' <<<"$ws_json")"
[[ -n "$ws" && "$ws" != null ]] || die "workspace create returned no id: $ws_json"

h tab rename "$t_agent" agent >/dev/null
# Label the agent pane with its provider (claude, codex, opencode), like the
# dev/logs/git panes are labeled.
h pane rename "$p_agent" "$provider" >/dev/null

# Bottom row FIRST (splitting down before any right-split keeps it spanning
# the full width), then lazygit right of the agent.
# --ratio is the share the ORIGINAL pane keeps, so 0.72 leaves a 28% bottom.
p_bottom="$(h pane split "$p_agent" --direction down --ratio 0.72 \
  --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')"

# lazygit fills the top-right slot; it lives in the agent tab instead of a
# dedicated "git" tab, so a diff is one glance away from the agent.
p_git="$(h pane split "$p_agent" --direction right \
  --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')"
h pane rename "$p_git" git >/dev/null
h pane run "$p_git" "lazygit" >/dev/null

# Agent argv comes from dev-agent-argv (single source of truth); %q-quote it
# into the pane's shell so prompts with spaces/quotes survive. The installed
# herdr integration hooks the agent CLI itself, so detection and session
# restore work no matter how the agent is launched.
mapfile -t agent_argv < <(dev-agent-argv "$provider" "$name" "$prompt")
h pane run "$p_agent" "$(printf '%q ' "${agent_argv[@]}")" >/dev/null

# Bottom row: two plain terminals — "dev" (run your dev server by hand)
# and "logs" (tail logs, one-off commands). No auto-typed dev command.
p_logs="$(h pane split "$p_bottom" --direction right --ratio 0.5 \
  --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')"
h pane rename "$p_bottom" dev >/dev/null
h pane rename "$p_logs" logs >/dev/null

# nvim tab (lazygit is now a pane in the agent tab, so there is no git tab).
p_nvim="$(h tab create --workspace "$ws" --label nvim --cwd "$dir" --no-focus \
  | jq -r '.result.root_pane.pane_id')"
h pane run "$p_nvim" "nvim" >/dev/null

h workspace focus "$ws" >/dev/null
show_client
