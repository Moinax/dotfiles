#!/usr/bin/env bash
# Create — or focus — a Herdr workspace for a project:
#   agent tab (labeled by task when a prompt came with it, else by provider:
#                  "claude", "codex", ...):
#                  agent (top-left) + hunk review (top-right); bottom
#                  row = "dev" + "logs" terminals (both plain shells)
#   tab "nvim":    full-window nvim
# No git/review/files tab is created up front: those are the on-demand tool
# tabs, opened where wanted by ctrl+alt+g / ctrl+alt+r / ctrl+alt+f
# (herdr-nav's tool_tab) and closed with ctrl+alt+w.
#
# Workspaces are grouped into one Herdr session per ~/Projects subdirectory
# (labs, mbrella, o27, ...): each group gets its own server + client window
# (kitty class "herdr-<group>") showing only that group's workspaces in the
# agent-status sidebar. Projects outside ~/Projects land in the default
# session (class "herdr"). All sessions share ~/.config/herdr/config.toml.
# Reattaching = focusing the existing workspace; Herdr itself keeps agents
# alive and (with the claude integration) restores their sessions.
#
# Usage: dev-herdr -n NAME -d DIR -p PROVIDER [-- PROMPT]
# HERDR_DEV_SESSION=<name> overrides the path-derived session.
set -euo pipefail

die() { echo "dev-herdr: $*" >&2; exit 1; }
command -v herdr >/dev/null 2>&1 || die "herdr not installed (paru -S herdr-bin)"
command -v jq    >/dev/null 2>&1 || die "jq is required"

name=""; dir="$PWD"; provider="claude"; prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n) name="$2"; shift 2 ;;
    -d) dir="$2"; shift 2 ;;
    -p) provider="$2"; shift 2 ;;
    --) shift; prompt="${1:-}"; break ;;
    *)  shift ;;
  esac
done
dir="$(cd "$dir" && pwd)"
[[ -z "$name" ]] && name="$(basename "$dir")"
[[ "$provider" != claude ]] && name="$name ($provider)"

# --- session --------------------------------------------------------------
# Session = first path component under ~/Projects (labs, mbrella, o27, ...);
# anything else (including projects sitting directly in ~/Projects) uses the
# default session. "default" is herdr's reserved alias for it, so --session
# can be passed uniformly. Explicit --session on every call also beats the
# HERDR_SOCKET_PATH env inherited when launched from inside a herdr pane
# (e.g. the dev-pick popup), which would otherwise pin the current session.
session="${HERDR_DEV_SESSION:-}"
if [[ -z "$session" ]]; then
  projects_root="$(dev-projects root)"
  case "$dir" in
    "$projects_root"/*/*) session="${dir#"$projects_root/"}"; session="${session%%/*}" ;;
    *) session="default" ;;
  esac
fi
session="${session//[^[:alnum:]_.-]/_}"
h() { herdr --session "$session" "$@"; }

# Register linked checkouts through Herdr's worktree API rather than as plain
# workspaces. WorkTrunk still owns creation/hooks; this call adds the native
# parent/child provenance used by the sidebar and `worktree remove`.
linked_worktree_main() {
  local common git_dir main
  git_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 1
  common="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [[ "$git_dir" != "$common" ]] || return 1
  main="$(git -C "$dir" worktree list --porcelain 2>/dev/null \
    | awk '$1 == "worktree" { print substr($0, 10); exit }')"
  [[ -n "$main" && -d "$main" ]] || return 1
  printf '%s\n' "$main"
}

# --- server ---------------------------------------------------------------
# The CLI does not auto-start the server, so bring it up headless if needed.
# The boot-and-poll dance is owned by herdr-clients (shared with the desktop
# show / open-all keybinds); it dies with its own message on failure.
herdr-clients ensure-server "$session"

# --- client window (one per session; kitty class "herdr" / "herdr-<name>") -
# Focus-or-launch lives in herdr-clients (shared with the desktop open-all /
# detach-all keybinds); it also scrubs inherited HERDR_* vars.
show_client() {
  herdr-clients show "$session"
}

# --- reattach path: workspace already exists ------------------------------
existing="$(h workspace list \
  | jq -r --arg l "$name" '.result.workspaces[]? | select(.label == $l) | .workspace_id' \
  | head -n1)"
if [[ -n "$existing" ]]; then
  # `worktree open` reuses an already-open checkout and upgrades its
  # provenance in place, preserving every tab, pane and running agent.
  if main_dir="$(linked_worktree_main)"; then
    h worktree open --cwd "$main_dir" --path "$dir" --label "$name" --focus >/dev/null
  else
    h workspace focus "$existing" >/dev/null
  fi

  # Native worktree grouping may have created a minimal parent workspace for
  # a main checkout that was not open yet. A normal dev workspace always has
  # more than its single initial tab/pane; hydrate only that unmistakable
  # placeholder on first `dev`, while ordinary reattaches remain untouched.
  tabs_json="$(h tab list --workspace "$existing")"
  panes_json="$(h pane list --workspace "$existing")"
  tab_count="$(jq '.result.tabs | length' <<<"$tabs_json")"
  pane_count="$(jq '.result.panes | length' <<<"$panes_json")"
  if [[ "$tab_count" -ne 1 || "$pane_count" -ne 1 ]]; then
    show_client
    exit 0
  fi
  ws="$existing"
  t_agent="$(jq -r '.result.tabs[0].tab_id' <<<"$tabs_json")"
  p_agent="$(jq -r '.result.panes[0].pane_id' <<<"$panes_json")"
else
  # --- create path --------------------------------------------------------
  if main_dir="$(linked_worktree_main)"; then
    ws_json="$(h worktree open --cwd "$main_dir" --path "$dir" \
      --label "$name" --no-focus)"
  else
    ws_json="$(h workspace create --cwd "$dir" --label "$name" --no-focus)"
  fi
  ws="$(jq -r '.result.workspace.workspace_id' <<<"$ws_json")"
  p_agent="$(jq -r '.result.root_pane.pane_id' <<<"$ws_json")"
  t_agent="$(jq -r '.result.tab.tab_id' <<<"$ws_json")"
  [[ -n "$ws" && "$ws" != null ]] || die "workspace create returned no id: $ws_json"
fi

# The workspace keeps the project name (revive-panes and the reattach path
# above both match on it), but the agent tab can say what this run is for when
# a prompt came with it: "fix the flaky updater tests" beats "claude". Slash
# commands are excluded — `wtstart -s` sends "/start <branch>", which is an
# instruction, not a description of the work. It stays a seed, not a pin: the
# opening prompt is a first approximation, and herdr-agent-title should be
# free to replace it once the agent has titled the session itself. Only a name
# typed in the ctrl+alt+a picker is pinned.
tab_label="$provider"; agent_name="$name"
if [[ -n "$prompt" && "$prompt" != /* ]]; then
  prompt_label="$(herdr-task-name "$prompt" || true)"
  [[ -n "$prompt_label" ]] && { tab_label="$prompt_label"; agent_name="$prompt_label"; }
fi

h tab rename "$t_agent" "$tab_label" >/dev/null
# Panes (agent + hunk review top row, dev/logs bottom row) are built by
# herdr-agent-layout, shared with herdr-nav's agent-tab keybind.
herdr-agent-layout -s "$session" "$p_agent" "$dir" "$provider" \
  "$agent_name" "$prompt"

# Full-window utility tabs — currently just "nvim", the one tool wanted in
# every workspace; git/review/files are opened on demand instead (see the
# header). One of each is shared by all agent tabs in this workspace.
# The root pane gets the tab's label so herdr-clients revive-panes can match
# it after a server restart; herdr-pane-cmd owns the label→command map.
util_tab() {
  local pane
  pane="$(h tab create --workspace "$ws" --label "$1" --cwd "$dir" --no-focus \
    | jq -r '.result.root_pane.pane_id')"
  h pane rename "$pane" "$1" >/dev/null
  h pane run "$pane" "$(herdr-pane-cmd "$1")" >/dev/null
}
while read -r tab; do util_tab "$tab"; done < <(herdr-pane-cmd --util-tabs)

h workspace focus "$ws" >/dev/null
show_client
