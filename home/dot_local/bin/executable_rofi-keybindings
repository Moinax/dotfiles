#!/bin/bash
set -euo pipefail

# rofi-keybindings — searchable keybinding menu for Hyprland and Niri
# Parses the active compositor config and displays bindings in rofi dmenu.

# ── Compositor detection ──────────────────────────────────────────

. "$HOME/.local/lib/compositor.sh"

if is_hyprland; then
    COMPOSITOR="hyprland"
elif is_niri; then
    COMPOSITOR="niri"
else
    notify-send -u critical "rofi-keybindings" "No supported compositor detected"
    exit 1
fi

# ── Section icons (Nerd Font) ─────────────────────────────────────

declare -A SECTION_ICON=(
    ["Application Shortcuts"]=$'\uf135'       #
    ["Window Management"]=$'\uf2d0'           #
    ["Focus Navigation"]=$'\uf05b'            #
    ["Move Window / Column"]=$'\uf0b2'        #
    ["Resize"]=$'\uf065'                      #
    ["Column / Group Operations"]=$'\uf0db'   #
    ["Workspace Navigation"]=$'\uf009'        #
    ["Move to Workspace"]=$'\uf009'           #
    ["Monitor Navigation"]=$'\uf108'          #
    ["Scratchpad"]=$'\uf24d'                  #
    ["Reload Configs"]=$'\uf021'              #
    ["Screenshots"]=$'\uf030'                 #
    ["Media & Volume"]=$'\uf028'              #
    ["Session & System"]=$'\uf011'            #
    ["Mouse & Scroll"]=$'\uf245'              #
    ["Opacity"]=$'\uf042'                     #
    ["Window Switching"]=$'\uf074'            #
)

format_icons() {
    while IFS= read -r line; do
        local section="${line%%\]*}"
        section="${section#\[}"
        local icon="${SECTION_ICON[$section]:-·}"
        local rest="${line#*\]  }"
        printf '%s    %s\n' "$icon" "$rest"
    done
}

# ── Shared awk: XF86 key descriptions ─────────────────────────────

XF86_AWK='
function xf86(k) {
    if (k == "XF86AudioRaiseVolume") return "Volume up"
    if (k == "XF86AudioLowerVolume") return "Volume down"
    if (k == "XF86AudioMute")        return "Mute toggle"
    if (k == "XF86AudioMicMute")     return "Mic mute toggle"
    if (k == "XF86AudioPlay")        return "Play / Pause"
    if (k == "XF86AudioStop")        return "Stop playback"
    if (k == "XF86AudioPrev")        return "Previous track"
    if (k == "XF86AudioNext")        return "Next track"
    if (k == "XF86MonBrightnessUp")  return "Brightness up"
    if (k == "XF86MonBrightnessDown") return "Brightness down"
    return ""
}
'

# ── Hyprland parser ───────────────────────────────────────────────
# Two source formats coexist (see hyprland.conf vs hyprland.lua): older
# Hyprland releases (e.g. shipped by Fedora) only understand the .conf
# syntax; newer releases use the Lua plugin and load binds.lua. Pick the
# one selected by Hyprland's active entrypoint.

parse_hyprland() {
    if [ -f "$HOME/.config/hypr/hyprland.lua" ]; then
        parse_hyprland_lua
    elif [ -f "$HOME/.config/hypr/hyprland.conf" ]; then
        parse_hyprland_conf
    elif [ -f "$HOME/.config/hypr/conf/binds.lua" ]; then
        parse_hyprland_lua
    elif [ -f "$HOME/.config/hypr/conf/binds.conf" ]; then
        parse_hyprland_conf
    else
        echo "No Hyprland config found at hyprland.{lua,conf} or conf/binds.{lua,conf}" >&2
        return 1
    fi
}

parse_hyprland_lua() {
    local config="$HOME/.config/hypr/conf/binds.lua"
    [ -f "$config" ] || { echo "Config not found: $config" >&2; return 1; }

    awk "$XF86_AWK"'
    function dir_name(d) {
        if (d == "r") return "right"
        if (d == "l") return "left"
        if (d == "u") return "up"
        if (d == "d") return "down"
        return d
    }

    function ws_name(w) {
        if (w == "r-1") return "prev"
        if (w == "r+1") return "next"
        if (w == "e-1") return "prev (non-empty)"
        if (w == "e+1") return "next (non-empty)"
        if (w == "special") return "scratchpad"
        return w
    }

    # Humanize an hl.dsp.* dispatcher expression when no trailing -- comment.
    function humanize(disp,    m, val, silent, cmd, x, y, v) {
        sub(/^[ \t]+/, "", disp)

        if (match(disp, /hl\.dsp\.focus\([^)]*direction[ \t]*=[ \t]*"[^"]+"/)) {
            m = substr(disp, RSTART, RLENGTH)
            match(m, /"[^"]+"/); val = substr(m, RSTART+1, RLENGTH-2)
            return "Focus " dir_name(val)
        }
        if (match(disp, /hl\.dsp\.focus\([^)]*workspace[ \t]*=/)) {
            if (match(disp, /workspace[ \t]*=[ \t]*tostring\(i\)/)) return "Workspace <I>"
            if (match(disp, /workspace[ \t]*=[ \t]*"[^"]+"/)) {
                m = substr(disp, RSTART, RLENGTH); match(m, /"[^"]+"/)
                val = substr(m, RSTART+1, RLENGTH-2)
                return "Workspace " ws_name(val)
            }
            return "Workspace"
        }
        if (match(disp, /hl\.dsp\.window\.move\([^)]*workspace[ \t]*=/)) {
            silent = (disp ~ /follow[ \t]*=[ \t]*false/) ? " (silent)" : ""
            if (match(disp, /workspace[ \t]*=[ \t]*tostring\(i\)/)) return "Move to workspace <I>" silent
            if (match(disp, /workspace[ \t]*=[ \t]*"[^"]+"/)) {
                m = substr(disp, RSTART, RLENGTH); match(m, /"[^"]+"/)
                val = substr(m, RSTART+1, RLENGTH-2)
                return "Move to workspace " ws_name(val) silent
            }
            return "Move to workspace" silent
        }
        if (match(disp, /hl\.dsp\.window\.move\([^)]*direction[ \t]*=[ \t]*"[^"]+"/)) {
            m = substr(disp, RSTART, RLENGTH)
            match(m, /direction[ \t]*=[ \t]*"[^"]+"/); val = substr(m, RSTART, RLENGTH)
            match(val, /"[^"]+"/); val = substr(val, RSTART+1, RLENGTH-2)
            return "Move window " dir_name(val)
        }
        if (match(disp, /hl\.dsp\.window\.resize\(/)) {
            x = 0; y = 0
            if (match(disp, /x[ \t]*=[ \t]*-?[0-9]+/)) {
                v = substr(disp, RSTART, RLENGTH); sub(/.*=[ \t]*/, "", v); x = v + 0
            }
            if (match(disp, /y[ \t]*=[ \t]*-?[0-9]+/)) {
                v = substr(disp, RSTART, RLENGTH); sub(/.*=[ \t]*/, "", v); y = v + 0
            }
            if (x > 0) return "Resize right"
            if (x < 0) return "Resize left"
            if (y > 0) return "Resize down"
            if (y < 0) return "Resize up"
            return "Resize"
        }
        if (match(disp, /hl\.dsp\.window\.tag\(/))   return "Toggle opacity"
        if (match(disp, /hl\.dsp\.window\.drag\(/))  return "Drag window"
        if (match(disp, /hl\.dsp\.window\.close\(/)) return "Close window"
        if (match(disp, /hl\.dsp\.window\.pin\(/))   return "Pin window"
        if (match(disp, /hl\.dsp\.group\.toggle\(/)) return "Toggle group"
        if (match(disp, /hl\.dsp\.group\.next\(/))   return "Group next"
        if (match(disp, /hl\.dsp\.group\.prev\(/))   return "Group prev"
        if (match(disp, /hl\.dsp\.exit\(/))          return "Exit Hyprland"

        if (match(disp, /hl\.dsp\.exec_cmd\(/)) {
            cmd = substr(disp, RSTART + RLENGTH)
            sub(/^[ \t]*home[ \t]*\.\.[ \t]*"/, "\"", cmd)
            if (match(cmd, /"[^"]+"/)) {
                v = substr(cmd, RSTART + 1, RLENGTH - 2)
                sub(/[ \t].*/, "", v)
                sub(/.*\//, "", v)
                sub(/\.[a-zA-Z0-9]+$/, "", v)
                gsub(/-/, " ", v)
                if (v != "") return toupper(substr(v, 1, 1)) substr(v, 2)
            }
            return "Run command"
        }
        return ""
    }

    function build_combo(expr,    s, n, i, p, out, parts) {
        s = expr
        gsub(/^[ \t]+|[ \t]+$/, "", s)
        gsub(/\<mod\>/, "\"Mod\"", s)
        gsub(/tostring\(i\)/, "\"<I>\"", s)
        while (gsub(/"[ \t]*\.\.[ \t]*"/, "", s)) {}
        gsub(/"/, "", s)
        gsub(/[ \t]*\+[ \t]*/, "+", s)
        n = split(s, parts, "+")
        out = ""
        for (i = 1; i <= n; i++) {
            p = parts[i]
            if (p == "SUPER")        p = "Mod"
            else if (p == "ALT")     p = "Alt"
            else if (p == "CTRL")    p = "Ctrl"
            else if (p == "SHIFT")   p = "Shift"
            else if (p == "RETURN")  p = "Return"
            else if (p == "SPACE")   p = "Space"
            else if (p == "TAB")     p = "Tab"
            else if (p == "PRINT")   p = "Print"
            else if (p == "left" || p == "right" || p == "up" || p == "down")
                p = toupper(substr(p, 1, 1)) substr(p, 2)
            out = (i == 1) ? p : out "+" p
        }
        return out
    }

    BEGIN { section = ""; skip_block = 0; in_for_i = 0 }

    # Section headers: -- ── N. Name ─────
    /^-- ── [0-9]+[a-z]?\./ {
        s = $0
        sub(/^-- ── [0-9]+[a-z]?\. /, "", s)
        sub(/ ─+$/, "", s)
        sub(/ \(.*\)$/, "", s)
        section = s; next
    }

    # AZERTY loop: skip its bindings (they duplicate the QWERTY layer)
    /for ws, key in pairs\(azerty_top_row\) do/ { skip_block = 1; next }

    # Numeric QWERTY loop: expand <I> placeholder over 1..7
    /for i = 1, 7 do/ { in_for_i = 1; next }

    /^[ \t]*end[ \t]*$/ {
        if (skip_block) skip_block = 0
        else if (in_for_i) in_for_i = 0
        next
    }

    skip_block             { next }
    /^[ \t]*--/            { next }
    /^[ \t]*$/             { next }

    /hl\.bind\(/ {
        line = $0

        # Trailing -- comment (description)
        comment = ""
        if (match(line, /\)[ \t]+-- /)) {
            comment = substr(line, RSTART + RLENGTH)
            sub(/[ \t]+$/, "", comment)
        }

        # Parse hl.bind(arg1, arg2 ...): extract first and second top-level args.
        # Handle "..." strings, [[...]] long strings, and nested parens.
        if (!match(line, /hl\.bind\(/)) next
        rest = substr(line, RSTART + RLENGTH)
        depth = 0; in_str = 0; in_lstr = 0; arg = ""; nn = length(rest); split_at = 0
        for (k = 1; k <= nn; k++) {
            c = substr(rest, k, 1); c2 = substr(rest, k, 2)
            if (in_lstr) {
                arg = arg c
                if (c2 == "]]") { in_lstr = 0; arg = arg "]"; k++ }
                continue
            }
            if (in_str) {
                arg = arg c
                if (c == "\\") { arg = arg substr(rest, k+1, 1); k++; continue }
                if (c == "\"") in_str = 0
                continue
            }
            if (c2 == "[[") { in_lstr = 1; arg = arg "[["; k++; continue }
            if (c == "\"") { in_str = 1; arg = arg c; continue }
            if (c == "(") { depth++; arg = arg c; continue }
            if (c == ")") { if (depth == 0) break; depth--; arg = arg c; continue }
            if (c == "," && depth == 0) { split_at = k; break }
            arg = arg c
        }

        second = ""
        if (split_at > 0) {
            rest2 = substr(rest, split_at + 1)
            depth = 0; in_str = 0; in_lstr = 0; nn2 = length(rest2)
            for (k = 1; k <= nn2; k++) {
                c = substr(rest2, k, 1); c2 = substr(rest2, k, 2)
                if (in_lstr) {
                    second = second c
                    if (c2 == "]]") { in_lstr = 0; second = second "]"; k++ }
                    continue
                }
                if (in_str) {
                    second = second c
                    if (c == "\\") { second = second substr(rest2, k+1, 1); k++; continue }
                    if (c == "\"") in_str = 0
                    continue
                }
                if (c2 == "[[") { in_lstr = 1; second = second "[["; k++; continue }
                if (c == "\"") { in_str = 1; second = second c; continue }
                if (c == "(") { depth++; second = second c; continue }
                if (c == ")") { if (depth == 0) break; depth--; second = second c; continue }
                if (c == "," && depth == 0) break
                second = second c
            }
        }

        combo = build_combo(arg)

        desc = comment
        if (desc == "") desc = humanize(second)
        if (desc == "" && combo ~ /XF86/) {
            xfk = combo; sub(/.*\+/, "", xfk)
            desc = xf86(xfk); if (desc == "") desc = xfk
        }
        if (desc == "") desc = "(no description)"

        if (in_for_i && combo ~ /<I>/) {
            for (j = 1; j <= 7; j++) {
                c2 = combo; gsub(/<I>/, j, c2)
                d2 = desc;  gsub(/<I>/, j, d2)
                printf "[%s]  %s  →  %s\n", section, c2, d2
            }
        } else {
            printf "[%s]  %s  →  %s\n", section, combo, desc
        }
    }
    ' "$config"
}

parse_hyprland_conf() {
    local config="$HOME/.config/hypr/conf/binds.conf"
    [ -f "$config" ] || { echo "Config not found: $config" >&2; return 1; }

    awk "$XF86_AWK"'
    function norm_key(k) {
        if (k ~ /^[a-z]+$/)
            return toupper(substr(k, 1, 1)) substr(k, 2)
        if (k ~ /^[A-Z]+$/ && length(k) > 1)
            return toupper(substr(k, 1, 1)) tolower(substr(k, 2))
        return k
    }

    function dir(d) {
        if (d == "r") return "right"
        if (d == "l") return "left"
        if (d == "u") return "up"
        if (d == "d") return "down"
        return d
    }

    BEGIN { section = ""; skip = 0 }

    /^# ── [0-9]+\./ {
        s = $0; sub(/^# ── [0-9]+\. /, "", s); sub(/ ─+$/, "", s)
        section = s; skip = 0; next
    }

    /^# AZERTY/ || /^# Silent move/ { skip = 1; next }
    /^# QWERTY/                      { skip = 0; next }
    /^#/ || /^$/                      { next }
    skip                              { next }
    /^bindm/ || /^windowrule/         { next }

    /^binde? = / {
        line = $0; sub(/^binde? = /, "", line)

        comment = ""
        if (match(line, /[ \t]# /)) {
            comment = substr(line, RSTART + 3)
            line = substr(line, 1, RSTART - 1)
            sub(/[ \t]+$/, "", line)
        }

        n = split(line, p, ",")
        if (n < 3) next
        for (i = 1; i <= n; i++) gsub(/^[ \t]+|[ \t]+$/, "", p[i])

        mods = p[1]; key = p[2]; action = p[3]
        args = ""
        for (i = 4; i <= n; i++) {
            a = p[i]; gsub(/^[ \t]+|[ \t]+$/, "", a)
            if (a != "") { if (args != "") args = args " "; args = args a }
        }

        if (mods != "") {
            gsub(/SUPER/, "Mod", mods)
            gsub(/ +ALT/, "+Alt", mods);   gsub(/^ALT/, "Alt", mods)
            gsub(/ +CTRL/, "+Ctrl", mods); gsub(/^CTRL/, "Ctrl", mods)
            gsub(/ +SHIFT/, "+Shift", mods); gsub(/^SHIFT/, "Shift", mods)
            combo = mods "+" norm_key(key)
        } else {
            combo = norm_key(key)
        }

        desc = comment
        if (desc == "" && key ~ /^XF86/) desc = xf86(key)
        if (desc == "") {
            if (action == "movewindoworgroup")     desc = "Move window/group " dir(args)
            else if (action == "swapwindow")       desc = "Swap window " dir(args)
            else if (action == "movefocus")        desc = "Focus " dir(args)
            else if (action == "cyclenext")        desc = "Cycle window " args
            else if (action == "resizeactive") {
                split(args, r, " ")
                if (r[1]+0 > 0) desc = "Resize right"
                else if (r[1]+0 < 0) desc = "Resize left"
                else if (r[2]+0 > 0) desc = "Resize down"
                else desc = "Resize up"
            }
            else if (action == "workspace")        desc = "Workspace " args
            else if (action == "movetoworkspace") {
                if (args == "special") desc = "Move to scratchpad"
                else desc = "Move to workspace " args
            }
            else if (action == "movetoworkspacesilent") {
                if (args == "special") desc = "Move to scratchpad (silent)"
                else desc = "Move to workspace " args " (silent)"
            }
            else if (action == "tagwindow")        desc = "Toggle opacity"
            else if (action == "exec") {
                desc = args; sub(/.*\//, "", desc)
            }
            else { desc = action; if (args != "") desc = desc " " args }
        }

        printf "[%s]  %s  →  %s\n", section, combo, desc
    }
    ' "$config"
}

# ── Niri parser ───────────────────────────────────────────────────

parse_niri() {
    local config="$HOME/.config/niri/config.kdl"
    [ -f "$config" ] || { echo "Config not found: $config" >&2; return 1; }

    awk "$XF86_AWK"'
    BEGIN { section = ""; skip = 0 }

    # Section headers
    /\/\/ ── [0-9]+\./ {
        s = $0; sub(/.*\/\/ ── [0-9]+\. /, "", s); sub(/ ─+$/, "", s)
        section = s; skip = 0; next
    }

    # recent-windows block → treat as a section
    /recent-windows \{/ { section = "Window Switching"; next }

    # AZERTY skip control
    /\/\/ AZERTY/ { skip = 1; next }
    /\/\/ QWERTY/ || /\/\/ Directional/ { skip = 0; next }
    /^[ \t]*\/\// || /^[ \t]*$/ { next }
    skip { next }
    /WheelScroll/ { next }

    # Keybinding lines: KeyCombo [attrs] { action [args]; }
    # Must start with a key combo pattern and contain { ... ; ... }
    /^[ \t]*(Mod\+|XF86|Print|Ctrl\+|Alt\+)/ && /\{[^}]*;[^}]*\}/ {
        line = $0; gsub(/^[ \t]+/, "", line)

        # Key combo: first token
        combo = line; sub(/[ \t{].*/, "", combo)

        # hotkey-overlay-title="..."
        desc = ""
        if (match(line, /hotkey-overlay-title="/)) {
            rest = substr(line, RSTART + 22)
            sub(/".*/, "", rest)
            desc = rest
        }

        # XF86 key lookup
        if (desc == "" && combo ~ /^XF86/) desc = xf86(combo)

        # Humanize action name
        if (desc == "") {
            act = line
            sub(/.*\{[ \t]*/, "", act)
            sub(/[ \t]*;.*/, "", act)

            aname = act; aargs = ""
            if (match(act, / /)) {
                aname = substr(act, 1, RSTART - 1)
                aargs = substr(act, RSTART + 1)
                gsub(/"/, "", aargs)
            }

            if (aname == "spawn" || aname == "spawn-sh") {
                desc = aargs; sub(/.*\//, "", desc)
            } else {
                desc = aname; gsub(/-/, " ", desc)
                desc = toupper(substr(desc, 1, 1)) substr(desc, 2)
                if (aargs != "") desc = desc " " aargs
            }
        }

        printf "[%s]  %s  →  %s\n", section, combo, desc
    }
    ' "$config"
}

# ── Main ──────────────────────────────────────────────────────────

if [ "$COMPOSITOR" = "hyprland" ]; then
    parse_hyprland
else
    parse_niri
fi | format_icons | rofi -dmenu -i -p "Keybindings" -no-custom > /dev/null || true
