#!/bin/bash
# Emit kitty session config for the `dev -k`/`wts -k` dev layout.
# Usage: dev-kitty-session [extra-claude-args...]
#
# Args are re-quoted with printf %q: kitty re-tokenizes every `launch` line
# with shell-style splitting, so an unquoted `-n "my name"` would split into
# separate words and the trailing words would leak into claude's positional
# [prompt] -- launching claude with that text as an initial prompt.
claude_args=""
for arg in "$@"; do
  claude_args+=" $(printf '%q' "$arg")"
done

cat <<EOF
new_tab Claude
layout splits
launch --title dev-claude claude$claude_args
# Split the terminal off first so it spans the full width along the bottom;
# only then vsplit the top region into claude (left) + lazygit (right).
launch --title dev-term --location=hsplit --bias=25
focus_matching_window title:dev-claude
launch --title dev-lazygit --location=vsplit lazygit
focus_matching_window title:dev-claude

new_tab Neovim
launch nvim
EOF
