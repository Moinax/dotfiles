#!/usr/bin/env bash
# Transparent `claude` wrapper — graceful --resume.
#
# herdr's agent-resume replays `claude --resume <id>` into a pane's shell when
# it restores a session (config `resume_agents_on_restore`). After a reboot the
# id herdr recorded often points to a transcript that was never persisted (a
# pane where Claude was opened but not messaged — see the herdr-reboot-behavior
# note), so the bare replay errors with "No conversation found" and leaves a
# dead prompt. This shim checks the transcript exists first; if it does not, it
# drops the --resume so Claude starts a fresh session instead. Everything else
# passes straight through. Also rescues manual `claude --resume <typo>`.
#
# Installed ahead of the real claude via PATH (~/.local/bin/shims, prepended in
# .zshenv). The real binary is the native install symlink at ~/.local/bin/claude
# — called by absolute path so the shim never recurses into itself.
set -euo pipefail

real="$HOME/.local/bin/claude"
# If the real binary is missing (or somehow points back here), fall back to the
# next `claude` on PATH that is not this shim. -ef compares device+inode after
# following symlinks, so no readlink canonicalization is needed.
if [[ ! -x "$real" || "$real" -ef "$0" ]]; then
  real=""
  while IFS= read -r cand; do
    [[ "$cand" -ef "$0" ]] && continue
    real="$cand"; break
  done < <(type -aP claude 2>/dev/null)
fi
[[ -n "$real" ]] || { echo "claude shim: real claude not found" >&2; exit 127; }

# One pass: pull the session id out of --resume <id> / --resume=<id> / -r <id>
# while building an argv with the flag (and its id) stripped — used only if
# the transcript turns out to be missing. A bare --resume/-r with no id
# (interactive picker) has nothing to validate and is kept as-is.
resume_id=""
new_args=()
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --resume=*)
      resume_id="${args[i]#--resume=}"
      ;;
    --resume|-r)
      # The value is optional; only treat the next token as an id if it is
      # not another flag.
      if [[ -n "${args[i+1]:-}" && "${args[i+1]}" != -* ]]; then
        resume_id="${args[i+1]}"
        i=$((i + 1))                     # skip the id too
      else
        new_args+=("${args[i]}")
      fi
      ;;
    *) new_args+=("${args[i]}") ;;
  esac
done

# No id to check, or its transcript exists → run claude unchanged.
if [[ -z "$resume_id" ]] \
   || compgen -G "$HOME/.claude/projects/*/$resume_id.jsonl" >/dev/null 2>&1; then
  exec "$real" "$@"
fi

# Transcript missing: start fresh with the resume flag stripped.
echo "claude shim: session $resume_id has no saved transcript — starting a fresh session" >&2
exec "$real" "${new_args[@]}"
