#!/usr/bin/env bash
# Dispatch a dev-environment launch to the configured multiplexer backend.
# Same interface as dev-zellij/dev-herdr:
#   dev-mux -n NAME -d DIR -p PROVIDER [-- PROMPT]
# Backend comes from the chezmoi data flag `use_herdr` (toggle via
# `manage.sh reconfig` + apply); DEV_MUX=herdr|zellij overrides per
# invocation for A/B testing without re-applying.
#
# The dispatch owns window spawning because the backends differ: zellij
# wants a fresh kitty window per project; herdr creates a workspace and
# focuses one shared client window itself. Callers background + disown
# this script, so both branches exec.
set -euo pipefail

mux="${DEV_MUX:-{{ if and (hasKey . "use_herdr") .use_herdr }}herdr{{ else }}zellij{{ end }}}"

case "$mux" in
  zellij)
    # Peek at -d for kitty's --directory without consuming the arg list.
    dir="$PWD"
    args=("$@")
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -d) dir="$2"; shift 2 ;;
        --) break ;;
        *)  shift ;;
      esac
    done
    exec kitty --directory "$dir" -e dev-zellij "${args[@]}"
    ;;
  herdr)
    exec dev-herdr "$@"
    ;;
  *)
    echo "dev-mux: unknown backend '$mux' (want: zellij|herdr)" >&2
    exit 1
    ;;
esac
