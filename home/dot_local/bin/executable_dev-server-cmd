#!/usr/bin/env bash
# Print the dev-server command for a project directory (or nothing).
# Prefer a justfile `dev` recipe (usually the project's own orchestrator,
# e.g. frontend + backend + worker), then fall back to a package.json
# "dev" script (package manager chosen from the lockfile).
# Used by dev-zellij-session.
#
# Usage: dev-server-cmd [DIR]   (defaults to $PWD)
set -euo pipefail
dir="${1:-$PWD}"

justfile=""
for f in justfile Justfile .justfile; do
  [[ -f "$dir/$f" ]] && { justfile="$dir/$f"; break; }
done
# `^dev([[:space:]]|:)` matches the `dev` recipe (`dev:` or `dev arg=...:`)
# without matching siblings like `dev-backend:` / `dev-frontend:`.
if [[ -n "$justfile" ]] && grep -Eq '^dev([[:space:]]|:)' "$justfile"; then
  echo "just dev"
elif [[ -f "$dir/package.json" ]] && grep -Eq '"dev"[[:space:]]*:' "$dir/package.json"; then
  if   [[ -f "$dir/bun.lockb" || -f "$dir/bun.lock" ]]; then echo "bun run dev"
  elif [[ -f "$dir/pnpm-lock.yaml" ]];                  then echo "pnpm dev"
  elif [[ -f "$dir/yarn.lock" ]];                       then echo "yarn dev"
  else                                                       echo "npm run dev"
  fi
fi
