#!/usr/bin/env bash
# Remove all worktrees whose branches are already merged into main.
#
# A branch counts as merged when either:
#   * worktrunk reports its main_state as "integrated" or "empty"
#     (true merge / fast-forward / no commits beyond main), or
#   * worktrunk reports "would_conflict" or "diverged" AND GitHub has a
#     merged PR whose merged head commit still matches the branch tip.
#     This is the squash-merge case: the squashed commit lives on main, but
#     the branch's original commits never became ancestors of main, so
#     worktrunk can't see the merge from the commit graph alone and flags
#     the branch as conflicting or diverged instead. The head-SHA check
#     guards against deleting a branch that merely reuses a merged PR's name,
#     or that has gained new commits since its PR was merged.
#
# Usage: wtclean [-y|--yes]   detect, confirm, remove
#        wtclean --plan       print BRANCH<TAB>graph|squash<TAB>HERDR_STATUS,
#                             remove nothing
#        wtclean --apply      read that same TSV on stdin and remove exactly
#                             those worktrees, without redoing the merge
#                             detection — which is what makes `dev-clean` cheap:
#                             neither the GitHub probe nor worktrunk's
#                             per-worktree status pass runs a second time.
#                             The Herdr check *is* redone here, because an agent
#                             can start between the plan and the "y".
set -euo pipefail

assume_yes=false
mode=remove
while (( $# > 0 )); do
  case "$1" in
    -y|--yes) assume_yes=true ;;
    --plan) mode=plan ;;
    --apply) mode=apply; assume_yes=true ;;
    *) echo "usage: wtclean [-y|--yes] [--plan] [--apply]" >&2; exit 2 ;;
  esac
  shift
done

# Self-heal stale worktrees: if a worktree's directory has vanished (e.g. the
# repo or a parent folder was moved/deleted), git flags it as "prunable" with
# no main_state, so the merge filters below skip it entirely. Prune those admin
# records first — it only drops registrations whose dir is already gone and
# leaves the branches intact.
#
# `prune -v` reports on *stderr* ("Removing worktrees/<name>: <reason>"), so the
# notice has to be captured from there: reading stdout left $pruned empty every
# time and this block never fired once. It is re-emitted on stderr as well,
# never on stdout — under --plan, stdout is the TSV dev-clean parses, and prose
# on it would come back as phantom branches in the confirmation table.
pruned=$(git worktree prune -v 2>&1 >/dev/null || true)
if [[ -n "$pruned" ]]; then
  {
    echo "Pruned stale worktree records (directory no longer exists):"
    printf '%s\n' "$pruned" | sed 's/^Removing worktrees\// - /'
    echo
  } >&2
fi

# --- what to remove -------------------------------------------------------
# Either detected here, or handed back by a caller that already detected it.
# Both routes owe the Herdr lookup below every branch's checkout path, and a
# branch's kind is simply which of the two buckets it landed in.
declare -A path_of=()
graph_merged=""
squash_merged=""

# The two buckets joined into one sorted list, blank lines dropped. A function
# because it is needed before and after the Herdr filter, and the two calls must
# not drift: a bucket carries a trailing newline while it is being accumulated
# and loses it once a `$(...)` has been through it, so a bare `printf` is wrong
# for one of those two cases whichever way it is written.
merge_lists() { printf '%s\n%s\n' "$1" "$2" | grep -v '^[[:space:]]*$' | sort -u || true; }

if [[ "$mode" == apply ]]; then
  # Only the paths are wanted here, and `git worktree list` carries the very same
  # ones for a fraction of what `wt list` costs: worktrunk runs a status pass per
  # worktree, and every merge verdict it computes would be thrown away in favour
  # of the caller's plan.
  wt_path=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)          wt_path="${line#worktree }" ;;
      "branch refs/heads/"*) path_of["${line#branch refs/heads/}"]="$wt_path" ;;
    esac
  done < <(git worktree list --porcelain)

  while IFS=$'\t' read -r branch kind _rest; do
    [[ -n "$branch" ]] || continue
    case "$kind" in
      graph)  graph_merged+="$branch"$'\n' ;;
      squash) squash_merged+="$branch"$'\n' ;;
    esac
  done
else
  # One pass over the worktree list for everything downstream: each branch's
  # checkout path, and which merge bucket it falls in. A dirty worktree is never
  # a candidate, so it reports no bucket at all.
  #
  # Separated by US (0x1f) rather than tabs: the state field is empty for a
  # worktree git still lists as prunable (a locked one survives the prune above),
  # and `read` cannot see an empty field delimited by tabs — tab is IFS
  # *whitespace*, so a leading one is stripped and every field shifts left,
  # binding the branch name to a path that is really the next branch's. Handed to
  # jq as $us so the separator has one spelling in this file rather than two.
  readonly US=$'\x1f'
  candidates=""
  while IFS="$US" read -r state branch path; do
    [[ -n "$branch" ]] || continue
    path_of["$branch"]="$path"
    case "$state" in
      integrated|empty)        graph_merged+="$branch"$'\n' ;;
      would_conflict|diverged) candidates+="$branch"$'\n' ;;
    esac
  done < <(wt list --format=json 2>/dev/null | jq -r --arg us "$US" '
    .[]? | select(.is_main != true) | select(.branch)
    | [ (if ([.working_tree.staged, .working_tree.modified, .working_tree.untracked,
              .working_tree.renamed, .working_tree.deleted] | any)
         then "dirty" else (.main_state // "") end),
        .branch, (.path // "") ] | join($us)' || true)

  if [[ -n "$candidates" ]]; then
    if command -v gh >/dev/null 2>&1; then
      while IFS= read -r branch; do
        [[ -n "$branch" ]] || continue
        pr_sha=$(gh pr list --head "$branch" --state merged --json headRefOid \
          --jq '.[0].headRefOid // ""' --limit 1 2>/dev/null || true)
        local_sha=$(git rev-parse --verify --quiet "refs/heads/$branch" || true)
        # Only a branch still pointing at the exact commit GitHub merged is
        # safe to drop. A divergent tip means a reused name or commits added
        # since the PR merged — force-deleting either would lose real work.
        if [[ -n "$pr_sha" && "$pr_sha" == "$local_sha" ]]; then
          squash_merged+="$branch"$'\n'
        fi
      done <<< "$candidates"
    else
      echo "warning: 'gh' not found — skipping squash-merge detection." >&2
      echo "         Branches merged via squash will not be cleaned." >&2
    fi
  fi
fi

branches=$(merge_lists "$graph_merged" "$squash_merged")

# --- Herdr occupancy -----------------------------------------------------
# Which workspace, if any, is living in each checkout we might remove.
# Resolved in one batch up front for two reasons: herdr-workspace queries each
# session once that way, and the session it derives comes from a path that has
# to still exist — after `wt remove` there would be nothing left to ask about.
declare -A herdr_session=() herdr_ws=() herdr_status=() herdr_verdict=()
if [[ -n "$branches" ]] && command -v herdr-workspace >/dev/null 2>&1; then
  while IFS=$'\t' read -r path session ws status verdict; do
    [[ -n "$path" ]] || continue
    herdr_session["$path"]="$session"
    herdr_ws["$path"]="$ws"
    herdr_status["$path"]="$status"
    herdr_verdict["$path"]="$verdict"
  done < <(
    while IFS= read -r branch; do
      [[ -n "$branch" ]] || continue
      printf '%s\n' "${path_of[$branch]:-}"
    done <<< "$branches" | herdr-workspace for-paths || true
  )
fi

# Drop the occupied checkouts once, here, so every consumer below — the plan, the
# confirmation list and the removal itself — works from the same set and cannot
# disagree. Filtering at the point of removal instead left the prompt offering
# branches it would then refuse ("Worktrees to remove: prot", then "skipping
# prot"), which is the one list that has to be exactly what happens.
#
# herdr-workspace owns which statuses count as busy; this only reads its verdict.
# `--apply` re-runs this whole pass against a freshly resolved verdict, which is
# what catches an agent that started between the plan and the "y".
#
# Every lookup here is keyed by checkout path and guarded on it being non-empty:
# an unknown branch would index these arrays with the empty string, which bash
# treats as a hard "bad array subscript" error rather than a miss. `--apply` can
# be handed a plan row whose worktree has since vanished, so that is a reachable
# input, not a theoretical one — it reads as unoccupied and falls through to
# `wt remove`, which reports the stale row properly.
keep_free() { # $1: newline-separated branches; prints those that may go
  local branch path
  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    path="${path_of[$branch]:-}"
    if [[ -n "$path" && "${herdr_verdict[$path]:-free}" == busy ]]; then
      echo "warning: '$branch' has a Herdr agent that is ${herdr_status[$path]}; skipping" >&2
      continue
    fi
    printf '%s\n' "$branch"
  done <<< "$1"
}

graph_merged=$(keep_free "$graph_merged")
squash_merged=$(keep_free "$squash_merged")
branches=$(merge_lists "$graph_merged" "$squash_merged")

close_herdr_workspace() { # $1: branch
  local path="${path_of[$1]:-}"
  [[ -n "$path" ]] || return 0
  local ws="${herdr_ws[$path]:-}"
  [[ -n "$ws" ]] || return 0
  herdr-workspace close "${herdr_session[$path]}" "$ws" 2>/dev/null \
    || echo "warning: worktree removed but Herdr workspace '$ws' could not be closed" >&2
}

if [[ "$mode" == plan ]]; then
  # The kind is the bucket, so it is passed in rather than looked up: nothing
  # here has to keep a parallel branch→kind map in step with the buckets.
  plan_rows() { # $1: graph|squash; $2: newline-separated branches
    local branch path status
    while IFS= read -r branch; do
      [[ -n "$branch" ]] || continue
      path="${path_of[$branch]:-}"
      status=closed
      [[ -z "$path" ]] || status="${herdr_status[$path]:-closed}"
      printf '%s\t%s\t%s\n' "$branch" "$1" "$status"
    done <<< "$2"
  }
  # Branch names are unique across the buckets, so sorting whole lines sorts by
  # branch — the order `branches` would have given.
  { plan_rows graph "$graph_merged"; plan_rows squash "$squash_merged"; } | sort
  exit 0
fi

if [[ -z "$branches" ]]; then
  echo "No merged worktrees to clean up."
  exit 0
fi

if [[ "$mode" != apply ]]; then
  echo "Worktrees to remove:"
  echo "$branches" | sed 's/^/  - /'
  echo
fi
if [[ "$assume_yes" != true ]]; then
  read -r -p "Remove all? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || exit 0
fi

# Remove each worktree on its own so one stuck worktree can't abort the rest.
remove_worktrees() { # $1: newline-separated branches; remaining args: wt remove options
  local list="$1" branch
  shift
  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    if wt remove -y --foreground "$@" "$branch"; then
      close_herdr_workspace "$branch"
    else
      echo "warning: could not remove worktree '$branch'" >&2
    fi
  done <<< "$list"
}

# Graph-merged branches are deleted normally. Squash-merged branches need -D
# because their original commits are not ancestors of main.
remove_worktrees "$graph_merged"
remove_worktrees "$squash_merged" -D
