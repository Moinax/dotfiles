#!/usr/bin/env bash
# Post-switch half of wtstart, shared by the fish and zsh functions (which
# keep only the `wt switch` calls — those need shell integration): resolve
# the "<project>.<branch>" title and launch the dev environment.
#   -d DIR       the worktree to launch in (required)
#   -b BRANCH    branch name as typed; defaults to the checked-out branch
#   -n NAME      append " - <name>" after the "<project>.<branch>" title
#   -p PROVIDER  AI agent provider: claude (default), codex, opencode
#   -s           auto-run `/start <branch>` in the agent pane (claude only)
#
# Gitignored files are copied by a wt pre-start hook (~/.config/worktrunk/
# config.toml), not here — they are already in place by the time this runs.
set -euo pipefail

dir="" branch="" name_override="" provider="claude" send_start=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d) dir="$2"; shift 2 ;;
    -b) branch="$2"; shift 2 ;;
    -n) name_override="$2"; shift 2 ;;
    -p)
      # Validated by dev-agent-argv, which owns the provider list and prints its
      # own "unknown provider (want: …)" message — see the same check in `dev`.
      dev-agent-argv "${2:-}" >/dev/null || exit 1
      provider="$2"; shift 2 ;;
    -s) send_start=true; shift ;;
    *) echo "wtstart-launch: unknown option $1" >&2; exit 1 ;;
  esac
done
[[ -n "$dir" ]] || { echo "wtstart-launch: -d DIR is required" >&2; exit 1; }
cd "$dir"

resolved_branch="${branch:-$(git branch --show-current)}"

# Project name = main repo dir name (`--git-common-dir` resolves to the main
# repo's .git even from a worktree). Used to prefix the title as
# "<project>.<branch>".
git_common="$(git rev-parse --git-common-dir 2>/dev/null)" || git_common=""
if [[ -n "$git_common" ]]; then
  project="$(basename "$(cd "$(dirname "$git_common")" && pwd)")"
else
  project="$(basename "$dir")"
fi

# Always lead with "<project>.<branch>"; -n appends " - <name>" after it.
name="$project.$resolved_branch"
[[ -n "$name_override" ]] && name="$name - $name_override"

# A non-empty prompt is auto-submitted to the agent on launch; -s uses that to
# make Claude run `/start <branch>`. `/start` is a Claude command and only
# claude auto-submits from the CLI, so -s is gated to that provider.
prompt=""
if $send_start; then
  if [[ "$provider" != claude ]]; then
    echo "wtstart: -s only applies to claude (/start is a Claude command); skipping" >&2
  elif [[ -n "$resolved_branch" ]]; then
    prompt="/start $resolved_branch"
  else
    echo "wtstart: -s set but no branch resolved; skipping /start" >&2
  fi
fi

# dev-herdr creates the workspace and owns its own window spawning (the
# retired dev-mux only existed to pick between herdr and zellij); setsid
# fully detaches it from this short-lived script.
setsid -f dev-herdr -n "$name" -d "$dir" -p "$provider" -- "$prompt" >/dev/null 2>&1 </dev/null
