#!/usr/bin/env bash
# rofi-wts — rofi worktree launcher: pick a main project, then create or
# reopen a worktree for it and launch its dev environment. The rofi analog of
# the wts/wtstart shell function; the launch half (title, copy-ignored,
# detached dev-herdr) is the shared wtstart-launch. Bound to Mod+Ctrl+Return;
# also reachable from rofi-dev via Ctrl+Enter with the project preselected
# as $1. Runs without a terminal, so `wt switch` gets --no-cd (nothing to cd)
# and errors surface as notifications instead of stderr.
#
# Worktree menu: existing worktrees first, then local branches without one
# (newest commits first); typed text creates a new branch. Enter only opens
# the worktree — a task is never auto-started, not even for a brand-new
# branch; Ctrl+Enter is the explicit opt-in that sends /start. Shift+Enter
# submits the typed text even when the list highlights a match (rofi's
# accept-custom, moved off its default Ctrl+Enter binding to free it for
# /start).
set -euo pipefail

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a rofi-wts "$@" || true; }
fail() { notify -u critical "rofi-wts" "$1"; exit 1; }

for cmd in rofi wt git dev-projects wtstart-launch wt-switch-args; do
  command -v "$cmd" >/dev/null 2>&1 || fail "$cmd not found"
done

entry="${1:-}"
if [[ -z "$entry" ]]; then
  entry=$(dev-projects list --main-only 2>/dev/null |
    rofi -dmenu -i -p "Worktree" -kb-accept-custom "") || exit 0
fi
[[ -z "$entry" ]] && exit 0

dir="$(dev-projects resolve "$entry")"
[[ -d "$dir/.git" ]] || fail "$entry is not a git repository"
cd "$dir"

# Worktree branches (skipping the main worktree itself — reopening it is just
# `dev`), remembering all of them so the branch list below excludes them.
declare -A has_wt=()
wt_branches=()
cur_path=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) cur_path="${line#worktree }" ;;
    "branch "*)
      b="${line#branch refs/heads/}"
      has_wt[$b]=1
      if [[ "$cur_path" != "$dir" ]]; then wt_branches+=("$b"); fi
      ;;
  esac
done < <(git worktree list --porcelain)

declare -A is_local=()
local_branches=()
while IFS= read -r b; do
  is_local[$b]=1
  if [[ -z "${has_wt[$b]:-}" ]]; then local_branches+=("$b"); fi
done < <(git for-each-ref refs/heads --sort=-committerdate --format='%(refname:short)')

# Branches that exist only on origin. They belong in the menu because they are
# just as openable as a local one — the switch below checks them out tracking
# origin/<branch> — and listing them is what makes a colleague's branch
# reachable without having to type it blind.
# lstrip=3 drops the refs/remotes/origin/ prefix, which %(refname:short) cannot
# be trusted to do here: it shortens refs/remotes/origin/HEAD to a bare "origin",
# so trimming the prefix by hand left that symref in the menu as a branch named
# "origin" that nothing could ever check out.
remote_branches=()
while IFS= read -r b; do
  [[ "$b" == HEAD ]] && continue
  if [[ -z "${is_local[$b]:-}" ]]; then remote_branches+=("$b"); fi
done < <(git for-each-ref refs/remotes/origin --sort=-committerdate --format='%(refname:lstrip=3)')

# Rows carry rofi's dmenu icon metadata — the same `\0icon\x1f…` protocol
# rofi-killwindow uses — so the icon is metadata rather than text: rofi still
# returns the bare branch name, leaving nothing to strip and no interaction
# with the whitespace squeeze below. Passing an icon *name* is also what keeps
# this away from inline nerd-font glyphs, which degrade to spaces on the way
# into a file. One icon family for the three states so they read as a set.
rows() { # $1: icon name; $2+: branches
  local icon="$1" b
  shift
  for b in "$@"; do printf '%s\0icon\x1f%s\n' "$b" "$icon"; done
}

ret=0
branch=$({
  rows folder-open "${wt_branches[@]}"
  rows folder "${local_branches[@]}"
  rows folder-remote "${remote_branches[@]}"
} |
  rofi -dmenu -i -p "Worktree: ${dir##*/}" \
    -mesg "Enter: open · Ctrl+Enter: open + /start · Shift+Enter: force typed text" \
    -kb-accept-alt "" -kb-accept-custom "Shift+Return" -kb-custom-1 "Control+Return") || ret=$?

branch="${branch//[[:space:]]/}"
[[ -z "$branch" ]] && exit 0
case "$ret" in 0 | 10) ;; *) exit 0 ;; esac

# A branch picked from the menu is already known, but Shift+Enter forces the
# typed text through, so this may still be a name git has never seen.
# wt-switch-args (shared with wtstart) fetches origin when the branch is
# unknown and prints --create only when it is genuinely new, so a remote-only
# branch checks out tracking origin/<branch>. -n reports the fetch via
# notify-send: there is no terminal here for stderr to reach.
mapfile -t switch_args < <(wt-switch-args -n "$branch")

# Creation (worktree, copy-ignored, pre/post-start hooks) takes a few
# seconds; without a notification the keypress feels swallowed. Any branch
# without a worktree gets one here, whichever way the switch below goes.
if [[ -z "${has_wt[$branch]:-}" ]]; then
  notify -h int:transient:1 "rofi-wts" "Creating worktree for $branch…"
fi

# Project hooks from .config/wt.toml need a one-time approval per repo, and
# there is no terminal here to answer the prompt in — point at the fix rather
# than surfacing wt's "cannot prompt in non-interactive environment".
out=$(wt switch "${switch_args[@]}" "$branch" --no-cd 2>&1) || {
  case "$out" in
    *approval*) fail "$entry has unapproved hooks. Run: wt config approvals add -C $dir" ;;
    *) fail "wt switch ${switch_args[*]} $branch failed: $out" ;;
  esac
}

wt_path=$(git worktree list --porcelain | awk -v want="refs/heads/$branch" '
  $1 == "worktree" { path = substr($0, 10) }
  $1 == "branch" && $2 == want { print path; exit }')
[[ -n "$wt_path" && -d "$wt_path" ]] || fail "could not locate the worktree for $branch"

# /start is never implicit — a task always has to be asked for, so only
# Ctrl+Enter (10) sends it. A brand-new branch is no exception.
send_start=false
if [[ "$ret" -eq 10 ]]; then send_start=true; fi

launch_args=(-d "$wt_path" -b "$branch")
if $send_start; then launch_args+=(-s); fi
wtstart-launch "${launch_args[@]}"
