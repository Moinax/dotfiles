#!/usr/bin/env bash
# Build the standard "agent" tab layout inside an existing tab's root pane:
# agent (top-left) + hunk review (top-right); bottom row = "dev" + "logs"
# terminals (both plain shells). Single source of truth shared by dev-herdr
# (workspace create) and herdr-nav agent-tab — layout tweaks happen here only.
# hunk here is review-only; real git ops (stage/commit/push) live in the
# ctrl+alt+g lazygit popup (herdr-nav git).
#
# Usage: herdr-agent-layout [-s SESSION] [-k seed|pin] PANE_ID DIR PROVIDER LABEL [PROMPT]
#        Without -s the CLI resolves the session itself (default session, or
#        the one inherited via HERDR_SOCKET_PATH when run from inside a pane).
#        -k pin marks LABEL as the user's own wording (a task they typed), so
#        herdr-agent-title holds it against the name it would otherwise guess;
#        the default (seed) is a generated label — project name, provider +
#        number — and is free to be replaced. That script's header owns what a
#        pin does and does not survive; don't restate it here.
set -euo pipefail

usage="usage: herdr-agent-layout [-s SESSION] [-k seed|pin] [-l TAB_LABEL] PANE_ID DIR PROVIDER LABEL [PROMPT]"
session=""; kind=seed; tab_label=""
while [[ "${1:-}" == -[skl] ]]; do
  case "$1" in
    -s) session="${2:?$usage}" ;;
    -k) kind="${2:?$usage}" ;;
    # What the tab wears, when the caller gave it something shorter than the
    # name going on the border. Passed straight to `seed`, which owns why the
    # recorded name has to be the tab's and not the border's.
    -l) tab_label="${2:?$usage}" ;;
  esac
  shift 2
done
p_agent="${1:?$usage}"
dir="${2:?$usage}"
provider="${3:?$usage}"
label="${4:?$usage}"
prompt="${5:-}"
# Checked here and not left to herdr-agent-title: the pane's title now comes
# from that call and nothing else, so a bad -k would exit it before the report
# and leave the border reading a bare "claude" with no way to tell why.
[[ "$kind" == seed || "$kind" == pin ]] || { echo "$usage" >&2; exit 2; }

h() {
  if [[ -n "$session" ]]; then herdr --session "$session" "$@"; else herdr "$@"; fi
}

# The same -s pass-through for the sibling scripts that take one (herdr-agent-
# title, herdr-pane-role): empty when this runs against the default session.
sess=()
if [[ -n "$session" ]]; then sess=(-s "$session"); fi

# Two names, two slots, on purpose — they are not interchangeable:
#   label  the provider. Durable (herdr persists it to session.json), and so
#          the slot revive-panes rebuilds the launch command from and the one
#          herdr-nav agent-tab counts to find where the agent block ends.
#   title  the task. Display-only reported metadata, wiped by a server restart,
#          which the pane border renders in preference to the label — so the
#          header reads the work and not "codex" without the durable slot
#          losing the provider.
# .claude/rules/herdr-layout.md owns the contract, what it cost the two times
# the task was written into the label instead, and the probe behind "the title
# wins on the border".
h pane rename "$p_agent" "$provider" >/dev/null

# Bottom row FIRST (splitting down before any right-split keeps it spanning
# the full width), then hunk right of the agent.
# --ratio is the share the ORIGINAL pane keeps, so 0.72 leaves a 28% bottom.
p_bottom="$(h pane split "$p_agent" --direction down --ratio 0.72 \
  --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')"

# hunk fills the top-right slot with a live, auto-reloading review of whatever
# the agent writes. Real git operations live in the ctrl+alt+g lazygit popup.
# The command comes from herdr-pane-cmd (shared with revive-panes).
p_review="$(h pane split "$p_agent" --direction right \
  --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')"
h pane rename "$p_review" review >/dev/null
h pane run "$p_review" "$(herdr-pane-cmd review)" >/dev/null

# Put the launch label on the border and record it before the agent can report a
# better one, so the Claude Code hook (herdr-agent-title) knows what it is
# allowed to replace: a generated "dotfiles (claude 2)" freely, a task the user
# typed only once the agent's own title moves. Both writes in one call, in the
# script that owns them — the `title` slot described above is filled here.
# Non-fatal, because a name must never break a tab; not silent, because this is
# now the only thing that fills that slot and a pane stuck on its bare provider
# is otherwise indistinguishable from one that simply has no task yet.
lbl=()
[[ -n "$tab_label" ]] && lbl=(-l "$tab_label")
herdr-agent-title seed "${sess[@]}" "${lbl[@]}" "$p_agent" "$kind" "$label" \
  || echo "herdr-agent-layout: could not name pane $p_agent" >&2

# `-n` carries only what a human wrote — the one rule that keeps the naming
# machine honest, and the reason this passes $agent_name and not $label.
#
# `claude -n NAME` is not a decoration: Claude Code persists NAME as the
# session's own `custom-title`, which is the exact record herdr-agent-title reads
# back as "the title the agent chose for its work". Handing it a generated label
# closed a loop — launch label -> custom-title -> read back as evidence ->
# re-applied to the tab -> re-read at the next relaunch. A wtstart run launched
# `socle.OCT-719` therefore re-titled itself `socle.OCT 719` at every turn end,
# overwrote any name typed on the tab, and came back as the worktree name after
# a restart. Worse, Claude never titled the work at all: it does not overwrite a
# custom title that already exists, so `/rename` was the only way out.
#
# So: a `pin` (the words the user typed in the ctrl+alt+a picker) is worth
# pushing into Claude's resume picker and terminal title, and cannot poison
# anything — it *is* the name meant to hold. A `seed` (project, worktree, or
# provider + number) launches nameless and lets the agent title itself after the
# first exchange; the border still reads the seed until then, from the call
# above. codex and opencode take no name flag at all and never had the problem.
agent_name=""
[[ "$kind" == pin ]] && agent_name="$label"

# Agent command comes from dev-agent-argv (single source of truth; -q emits
# it %q-quoted so prompts with spaces/quotes survive the pane's shell). The
# installed herdr integration hooks the agent CLI itself, so detection and
# session restore work no matter how the agent is launched.
h pane run "$p_agent" "$(dev-agent-argv -q "$provider" "$agent_name" "$prompt")" >/dev/null

# Bottom row: two plain terminals — "dev" (run your dev server by hand)
# and "logs" (tail logs, one-off commands). No auto-typed dev command.
p_logs="$(h pane split "$p_bottom" --direction right --ratio 0.5 \
  --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')"
h pane rename "$p_bottom" dev >/dev/null
h pane rename "$p_logs" logs >/dev/null

# What each pane is FOR, in the one slot that is neither displayed nor
# user-editable — herdr-pane-role owns why the labels above cannot carry this.
# All four in a single call: one lock, one rewrite. dev/logs are recorded as
# `shell` rather than left out, so revive-panes knows they are meant to be bare
# and does not have to guess.
herdr-pane-role set "${sess[@]}" \
  "$p_agent=agent:$provider" "$p_review=review" \
  "$p_bottom=shell" "$p_logs=shell"
