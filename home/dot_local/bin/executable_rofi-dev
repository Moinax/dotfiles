#!/usr/bin/env bash
# rofi-dev — fuzzy directory picker that launches the dev layout.
# Candidates come from dev-projects (shared with dev-pick); `dev` owns the
# detached launch, so rofi can close immediately after selection.

selection=$(dev-projects list 2>/dev/null | rofi -dmenu -i -p "Dev")

if [ -n "$selection" ]; then
    dev "$(dev-projects root)/$selection"
fi
