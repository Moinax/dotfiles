#!/usr/bin/env bash
# Emit a Zellij layout for the dev/wts dev environment (persistent, detachable).
#
# Layout:
#   tab "agent": claude (top-left) + lazygit (top-right), terminal across the bottom
#   tab "nvim":  a full-window nvim
# For web projects (a package.json with a "dev" script) the bottom terminal is
# replaced by a *suspended* dev-server pane — press Enter in it to start the
# server (use a floating pane, Alt+f, for throwaway commands). It is suspended
# rather than auto-run so reattaching/resurrecting a session never silently
# double-binds a port.
#
# Usage: dev-zellij-session -d DIR -p PROVIDER -n NAME [-- PROMPT]
set -euo pipefail

dir="$PWD"; provider="claude"; name=""; prompt=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d) dir="$2"; shift 2 ;;
    -p) provider="$2"; shift 2 ;;
    -n) name="$2"; shift 2 ;;
    --) shift; prompt="${1:-}"; break ;;
    *)  shift ;;
  esac
done
dir="$(cd "$dir" && pwd)"

# --- KDL string escaping -------------------------------------------------
kdl_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }

# Resolve provider -> argv (first line = command, rest = args).
mapfile -t agent_argv < <(dev-agent-argv "$provider" "$name" "$prompt")
agent_cmd="${agent_argv[0]}"
agent_args_kdl=""
for a in "${agent_argv[@]:1}"; do
  agent_args_kdl+=" \"$(kdl_escape "$a")\""
done

# --- detect a dev-server command -----------------------------------------
# Detection lives in dev-server-cmd.
devcmd=()
devcmd_str="$(dev-server-cmd "$dir")"
[[ -n "$devcmd_str" ]] && read -ra devcmd <<< "$devcmd_str"

# --- agent pane (block only when there are args) -------------------------
# No size: agent + lazygit split the top region 50/50 (like the kitty vsplit).
# Pane name = provider so the frame reads claude/codex/opencode at a glance.
pane_name="$(kdl_escape "$provider")"
if [[ -n "$agent_args_kdl" ]]; then
  agent_pane="                pane name=\"$pane_name\" command=\"$(kdl_escape "$agent_cmd")\" {
                    args$agent_args_kdl
                }"
else
  agent_pane="                pane name=\"$pane_name\" command=\"$(kdl_escape "$agent_cmd")\""
fi

# --- bottom row: terminal, or a dev-server pane that replaces it ----------
# For web projects the *suspended* dev-server pane takes the whole bottom row
# (no separate terminal) — run throwaway commands in a floating pane (Alt+f).
if [[ ${#devcmd[@]} -gt 0 ]]; then
  cmd="${devcmd[0]}"; dev_args_kdl=""
  for w in "${devcmd[@]:1}"; do dev_args_kdl+=" \"$(kdl_escape "$w")\""; done
  bottom_row="            pane name=\"dev\" command=\"$cmd\" size=\"28%\" {
                args$dev_args_kdl
                start_suspended true
            }"
else
  bottom_row='            pane name="terminal" size="28%"'
fi

cat <<KDL
layout {
    cwd "$dir"
    // A custom --new-session-with-layout replaces the default layout entirely,
    // so re-add Zellij's tab bar (top) and status bar (bottom) around every tab.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="agent" focus=true {
        pane split_direction="horizontal" {
            pane split_direction="vertical" size="72%" {
$agent_pane
                pane name="git" command="lazygit"
            }
$bottom_row
        }
    }
    tab name="nvim" {
        pane command="nvim"
    }
}
KDL
