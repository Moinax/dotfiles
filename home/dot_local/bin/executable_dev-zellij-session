#!/usr/bin/env bash
# Emit a Zellij layout for the dev/wts dev environment — the persistent,
# detachable counterpart to dev-kitty-session's kitty splits.
#
# Layout mirrors the kitty version:
#   tab "agent": claude (top-left) + lazygit (top-right), terminal across the bottom
#   tab "nvim":  a full-window nvim
# For web projects (a package.json with a "dev" script) the bottom terminal is
# replaced by a *suspended* dev-server pane — press Enter in it to start the
# server (use a floating pane, Alt+f, for throwaway commands). It is suspended
# rather than auto-run so reattaching/resurrecting a session never silently
# double-binds a port.
#
# Usage: dev-zellij-session -d DIR [extra-claude-args...]
set -euo pipefail

dir="$PWD"
if [[ "${1:-}" == "-d" ]]; then
  dir="$2"; shift 2
fi
dir="$(cd "$dir" && pwd)"

# --- KDL string escaping -------------------------------------------------
kdl_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }

# claude args -> KDL `args "a" "b"`
claude_args_kdl=""
for a in "$@"; do
  claude_args_kdl+=" \"$(kdl_escape "$a")\""
done

# --- detect a web dev-server command (package manager from lockfile) -----
devcmd=()
if [[ -f "$dir/package.json" ]] && grep -Eq '"dev"[[:space:]]*:' "$dir/package.json"; then
  if   [[ -f "$dir/bun.lockb" || -f "$dir/bun.lock" ]]; then devcmd=(bun run dev)
  elif [[ -f "$dir/pnpm-lock.yaml" ]];                  then devcmd=(pnpm dev)
  elif [[ -f "$dir/yarn.lock" ]];                       then devcmd=(yarn dev)
  else                                                       devcmd=(npm run dev)
  fi
fi

# --- claude pane (block only when there are args) ------------------------
# No size: claude + lazygit split the top region 50/50 (like the kitty vsplit).
if [[ -n "$claude_args_kdl" ]]; then
  claude_pane="                pane name=\"claude\" command=\"claude\" {
                    args$claude_args_kdl
                }"
else
  claude_pane='                pane name="claude" command="claude"'
fi

# --- bottom row: terminal, or a dev-server pane that replaces it ----------
# For web projects the *suspended* dev-server pane takes the whole bottom row
# (no separate terminal) — run throwaway commands in a floating pane (Alt+f).
if [[ ${#devcmd[@]} -gt 0 ]]; then
  cmd="${devcmd[0]}"; dev_args_kdl=""
  for w in "${devcmd[@]:1}"; do dev_args_kdl+=" \"$(kdl_escape "$w")\""; done
  bottom_row="            pane name=\"dev\" command=\"$cmd\" size=\"28%\" {
                args$dev_args_kdl
                start_suspended true
            }"
else
  bottom_row='            pane name="terminal" size="28%"'
fi

cat <<KDL
layout {
    cwd "$dir"
    // A custom --new-session-with-layout replaces the default layout entirely,
    // so re-add Zellij's tab bar (top) and status bar (bottom) around every tab.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="agent" focus=true {
        pane split_direction="horizontal" {
            pane split_direction="vertical" size="72%" {
$claude_pane
                pane name="git" command="lazygit"
            }
$bottom_row
        }
    }
    tab name="nvim" {
        pane command="nvim"
    }
}
KDL
