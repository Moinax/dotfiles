#!/usr/bin/env bash
# Fuzzy-pick a project and open its dev environment. Bound to a herdr popup
# (prefix+o, see ~/.config/herdr/config.toml) — the popup closes when this
# exits — but works from any terminal. Candidates come from dev-projects
# (shared with rofi-dev); `dev` owns the detached launch, which is what lets
# this exit immediately without killing the spawned environment.
set -euo pipefail

for cmd in tv dev-projects dev; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "dev-pick: $cmd not found" >&2; exit 1; }
done

sel="$(tv --source-command "dev-projects list" \
  --no-status-bar --input-header "Dev project" < /dev/tty)" || exit 0
[[ -z "$sel" ]] && exit 0

dev "$(dev-projects root)/$sel"
