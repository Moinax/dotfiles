#!/usr/bin/env bash
# Fuzzy-pick a project under ~/Projects and open its dev environment.
# Bound to a herdr popup (prefix+o, see ~/.config/herdr/config.toml) — the
# popup closes when this exits — but works from any terminal. Same source
# as rofi-dev: directories two levels deep under ~/Projects.
#
# dev-mux is backgrounded like the other call sites: the zellij backend
# execs a long-lived kitty window, which would otherwise hold the popup open.
set -euo pipefail

for cmd in fd tv dev-mux; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "dev-pick: $cmd not found" >&2; exit 1; }
done

sel="$(tv --source-command "fd --type d --max-depth 2 --base-directory $HOME/Projects --strip-cwd-prefix" \
  --no-status-bar --input-header "Dev project" < /dev/tty)" || exit 0
[[ -z "$sel" ]] && exit 0

dir="$HOME/Projects/$sel"
dev-mux -n "$(basename "$dir")" -d "$dir" >/dev/null 2>&1 & disown
