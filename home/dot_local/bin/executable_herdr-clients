#!/usr/bin/env bash
# Manage Herdr client windows (kitty class "herdr" / "herdr-<session>") from
# desktop keybindings. Herdr servers run detached (setsid, one per session —
# see dev-herdr), so closing a client window only detaches: agents keep
# running and reattaching restores everything.
#
# Usage: herdr-clients show SESSION           focus the session's client window, opening it if needed (alias: open)
#        herdr-clients detach SESSION         close the session's client window (server/agents keep running)
#        herdr-clients stop SESSION           detach, then stop the session's server (kills its agents)
#        herdr-clients list                   persisted sessions, one NAME<TAB>RUNNING<TAB>ATTACHED line each (1/0 flags)
#        herdr-clients ensure-server SESSION  boot the session's server if down, wait for it
#        herdr-clients open-all               open a client window for every persisted session that holds a workspace
#        herdr-clients detach-all             close every client window (servers/agents keep running)
#        herdr-clients stop-all               detach-all, then stop every running server (kills agents)
#        herdr-clients revive-panes SESSION   rerun utility/agent pane commands in restored panes left as bare shells
#        herdr-clients migrate-layout [SESSION ...]  reconcile persisted workspaces with the current dev-herdr layout (default: every session)
#        herdr-clients migrate-worktrees [SESSION ...]  attach existing linked-checkout spaces to native Herdr worktree groups
#        herdr-clients reload-config [SESSION ...]   reload config.toml in running servers (default: every running one)
set -euo pipefail

die() { echo "herdr-clients: $*" >&2; exit 1; }
command -v herdr >/dev/null 2>&1 || die "herdr not installed (paru -S herdr-bin)"
command -v jq    >/dev/null 2>&1 || die "jq is required"

# Transient desktop feedback for the keybind-driven *-all commands, whose
# spawns have no terminal to show success or failure. int:transient:1 keeps
# the popups out of the notification center (same pattern as
# toggle-monitors.sh).
notify() { # $1: urgency, rest: body
  notify-send -u "$1" -h int:transient:1 -t 3000 "Herdr" "${*:2}" 2>/dev/null || true
}

# Ack before taking the lock, so a press queued behind a slow invocation
# still gives immediate feedback instead of silence until the lock frees.
case "${1:-}" in
  open-all)   notify low "Opening all sessions…" ;;
  detach-all) notify low "Detaching all clients…" ;;
  stop-all)   notify low "Stopping all servers…" ;;
esac

# Serialize invocations. stop-all takes a few seconds (one serial `session
# stop` per server); an open-all racing it sees half-stopped sessions —
# clients attach to a dying server (empty kitty that closes itself) or open
# fine and then get killed by the still-running stop loop. The lock makes the
# second keypress wait for the first to finish instead.
# Long-lived spawns (servers, kitty clients) MUST close fd 9 (`9>&-`, owned
# by the spawn_* helpers): flock belongs to the open file description, so an
# inherited fd keeps the lock held after this script exits and every later
# invocation hangs forever. The bounded wait turns any residual deadlock into
# an error instead of a silent pile-up of queued keypresses.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/herdr-clients.lock"
flock -w 30 9 || {
  notify critical "Busy: another herdr-clients invocation is holding the lock"
  die "timed out waiting for another herdr-clients invocation"
}

# "default" is herdr's reserved alias for the unnamed session; its client
# window keeps the bare "herdr" class (matches dev-herdr).
class_for() {
  [[ "$1" == default ]] && echo "herdr" || echo "herdr-$1"
}

window_exists() {
  hyprctl clients -j 2>/dev/null \
    | jq -e --arg c "$1" 'any(.[]; .class == $c)' >/dev/null
}

# Run a command with the caller's context markers scrubbed — for long-lived
# herdr processes (servers, clients) whose environment outlives and leaks
# into every pane shell. HERDR_* (set inside a herdr pane) makes a client
# refuse to start ("nested herdr is disabled") and pins the CLI to the
# spawning session; CLAUDECODE/CLAUDE_* (set in Claude Code's shells) marks
# the tree as a claude child session, so agents launched in the panes of a
# server that was booted from such a shell silently stop saving transcripts.
# Add new context-marker families here as agent CLIs grow them (codex,
# opencode) — a missed one fails silently, the way CLAUDE_* did.
scrub_env() {
  # env -u on an unset name is a no-op, so the exact name needs no guard.
  local -a scrub=(-u CLAUDECODE)
  local v
  for v in "${!HERDR_@}" "${!CLAUDE_@}"; do
    scrub+=(-u "$v")
  done
  env "${scrub[@]}" "$@"
}

# Fully detach a long-lived spawn (server, kitty client): scrub context
# markers, fork it into its own session, drop stdio, and close the flock fd.
# -f is load-bearing: setsid(2) only implies a fork when the caller is a
# process-group leader, which a script's child never is — without it the
# spawn gets its own session but stays a child of this shell for its whole
# life, and a never-exiting child keeps bash's bare `wait` (revive_panes)
# blocked in waitpid(-1) forever while it holds the flock (observed: a wedged
# open-all starving every later `dev` against the lock). With -f the setsid
# parent returns immediately, so callers need no `&`/disown.
spawn_detached() {
  scrub_env setsid -f "$@" >/dev/null 2>&1 </dev/null 9>&-
}

# Background an in-process shell function: drop stdio and close the flock fd
# (same fd-9 discipline as spawn_detached) so the job never holds the lock
# past this invocation. Unlike spawn_detached it stays a child of this shell,
# so it runs with the script's functions and current state.
spawn_bg() {
  ( exec 9>&-; "$@" ) >/dev/null 2>&1 &
}

launch_client() {
  local session="$1"
  # kitty -T permanently fixes the OS window title (herdr's own OSC title —
  # a bare "herdr" — can't overwrite it), so the Hyprland window shows which
  # session/group it is.
  local class title="herdr — $session"
  class="$(class_for "$session")"
  spawn_detached kitty --class "$class" --title "$title" \
    -e herdr --session "$session"
}

running_sessions() {
  herdr session list --json 2>/dev/null \
    | jq -r '.sessions[]? | select(.running) | .name'
}

# Machine-readable session table for wrapper UIs (herdr-session): one line
# per persisted session, NAME<TAB>RUNNING<TAB>ATTACHED with 1/0 flags.
list_sessions() {
  local classes name running attached
  classes="$(hyprctl clients -j 2>/dev/null | jq -r '.[].class')"
  while IFS=$'\t' read -r name running; do
    attached=0
    grep -qxF "$(class_for "$name")" <<<"$classes" && attached=1
    printf '%s\t%s\t%s\n' "$name" "$running" "$attached"
  done < <(herdr session list --json 2>/dev/null \
    | jq -r '.sessions[]? | [.name, (if .running then 1 else 0 end)] | @tsv')
}

# Herdr restores workspaces/panes from session.json when a server boots, but
# panes come back as bare shells — commands started via `pane run` are not
# relaunched. Agents are the exception since 0.7.5: a pane with a recorded
# agent_session gets its `claude --resume <id>` replayed by herdr itself (the
# claude shim rescues ids whose transcript was never persisted), so those
# panes MUST be left alone — racing herdr's replay lands our command as typed
# text inside the resumed agent's chat (observed: "claude -n dotfiles" posted
# as a message). Rerun the rest ourselves, from the role herdr-pane-role
# recorded when the pane was created: herdr-pane-cmd resolves a utility role to
# its command, dev-agent-argv an agent role to a fresh conversation (not a
# resume — herdr owns those). The role, not the pane label, is what makes this
# survive: labels are display names the user can rename or clear from the UI,
# and keying off them is what silently turned agent panes into bare shells
# twice. Only panes whose foreground process is still a plain shell are
# touched, so this is idempotent and safe on a session that never went down.
# Classify a pane's foreground state: "starting" (no foreground process yet),
# "shell" (a single plain shell), "busy" (anything else). Fails when the pane
# can't be inspected.
pane_state() { # $1: session, $2: pane
  herdr --session "$1" pane process-info --pane "$2" 2>/dev/null \
    | jq -r --arg re '^(zsh|bash|fish|sh)$' '
        .result.process_info.foreground_processes
        | if length == 0 then "starting"
          elif length == 1 and (.[0].name | test($re)) then "shell"
          else "busy" end' 2>/dev/null
}

revive_pane_cmd() {
  local session="$1" pane="$2" cmd="$3" i state
  # Right after a boot the pane's shell may still be initializing (no
  # foreground process yet) — wait for it. A pane already running a non-shell
  # command (it survived, or the user started one) is left alone immediately
  # instead of burning the whole timeout.
  for ((i = 0; i < 10; i++)); do
    state="$(pane_state "$session" "$pane")" || state=""
    case "$state" in
      shell) herdr --session "$session" pane run "$pane" "$cmd" >/dev/null 2>&1 || true
             return 0 ;;
      busy)  return 0 ;;
      *)     sleep 0.3 ;;
    esac
  done
}

# Work out a role for a pane that has none recorded — one that predates
# herdr-pane-role, or whose entry was lost. This is the old label-matching
# ladder, kept only as a bootstrap: whatever it decides is written back, so any
# given pane is inferred at most once and every later boot reads the file.
# `slot`/`util` come from the tab shape rather than the label, which is what
# lets it still name an agent pane whose label was renamed or cleared.
# Prints nothing (and returns 1) for a pane it cannot place — a pane the user
# split themselves, which has nothing for us to run.
#
# The two vocabularies it tests against stay owned by dev-agent-argv and
# herdr-pane-cmd; asking them is a subprocess, so the answers are memoized for
# the run. infer_role runs once per unrecorded pane (~120 across a full
# desktop) over a handful of distinct labels, and a pane it cannot place
# records nothing — so that pane re-pays its lookups at every boot, forever.
declare -A KNOWN_LABEL=()
label_known() { # $1: owning command, $2: label
  local key="$1/$2"
  [[ -n "$2" ]] || return 1
  if [[ -z "${KNOWN_LABEL[$key]:-}" ]]; then
    if "$1" "$2" >/dev/null 2>&1; then KNOWN_LABEL[$key]=1; else KNOWN_LABEL[$key]=0; fi
  fi
  [[ "${KNOWN_LABEL[$key]}" == 1 ]]
}
is_provider()   { label_known dev-agent-argv "$1"; }
is_util_label() { label_known herdr-pane-cmd "$1"; }

infer_role() { # $1: label, $2: detected agent, $3: is-agent-slot, $4: tab label, $5: single-pane tab
  local label="$1" agent="$2" slot="$3" tab_label="$4" single="$5"
  if [[ "$slot" == 1 ]]; then
    # Structure already says this is the agent slot, so the label only gets to
    # say *which* provider, and only if it still names one. Otherwise herdr's
    # live detection, else the same default herdr-nav's agent-tab falls back to:
    # a wrong provider is one relaunch away from right, a pane left unplaced is
    # a bare shell on every boot. Deliberately ahead of the label rules — a pane
    # hand-renamed to "review" is still the agent slot.
    if is_provider "$label"; then
      printf 'agent:%s\n' "$label"
    else
      printf 'agent:%s\n' "${agent:-claude}"
    fi
  elif is_util_label "$label"; then
    printf '%s\n' "$label"                     # utility pane, label intact
  elif is_provider "$label"; then
    printf 'agent:%s\n' "$label"               # agent pane outside a full agent tab
  elif [[ "$slot" == 0 ]]; then
    printf 'shell\n'                           # dev/logs, or a sibling renamed
  elif [[ "$single" == 1 ]] && is_util_label "$tab_label"; then
    printf '%s\n' "$tab_label"                 # utility tab whose root pane was never labeled
  else
    return 1
  fi
}

revive_panes() {
  local session="$1" panes tabs workspaces
  local pane label ws_label tab_label agent has_session slot single role name cmd
  local -a learned=() live=()
  local -A roles=()
  panes="$(herdr --session "$session" pane list 2>/dev/null \
    | jq -c '.result.panes // []')" || return 0
  tabs="$(herdr --session "$session" tab list 2>/dev/null \
    | jq -c '.result.tabs // []')" || return 0
  workspaces="$(herdr --session "$session" workspace list 2>/dev/null \
    | jq -c '.result.workspaces // []')" || return 0

  # What each pane is for comes from herdr-pane-role, not from its label: the
  # label is a display name the user can rename or clear from the UI, and using
  # it as the machine slot is what silently turned agent panes into bare shells
  # twice. One read for the whole session.
  while IFS=$'\t' read -r pane role; do
    [[ -n "$pane" ]] && roles["$pane"]="$role"
  done < <(herdr-pane-role list -s "$session")

  # Agent panes with a recorded agent_session are skipped: herdr resumes those
  # itself (see the note above), so only agents it never registered get a fresh
  # conversation. The agent's display name is the tab label when that says
  # something — tabs carry task names ("fix-flaky-updater-tests"), and a fresh
  # conversation in that tab is still about that task — and the workspace label
  # otherwise, matching how dev-herdr launched it. "Says something" means
  # anything but the generated "<provider>[ N]" placeholder.
  # Panes revive concurrently: each waits up to ~3s for its shell, so serial
  # cost would grow with pane count.
  # Fields are \x1f-separated, NOT tab: tab is an IFS *whitespace* character, so
  # bash collapses a run of them into one delimiter and an empty middle field
  # (a pane with no detected agent, a workspace with no label) silently shifts
  # every later field left — has_session was reading `single` and utility panes
  # were being skipped as if herdr were resuming them. A non-whitespace
  # separator preserves empty fields; jq strips control characters from the
  # values so none of them can contain one.
  while IFS=$'\x1f' read -r pane label ws_label tab_label agent has_session slot single; do
    [[ -n "$pane" ]] || continue
    live+=("$pane")   # every pane, session or not — this is what prune keeps
    role="${roles[$pane]:-}"
    if [[ -z "$role" ]]; then
      role="$(infer_role "$label" "$agent" "$slot" "$tab_label" "$single")" || role=""
      [[ -n "$role" ]] && learned+=("$pane=$role")
    fi
    [[ "$has_session" == 1 ]] && continue
    case "$role" in
      # "shell" is dev/logs and is the reason roles are recorded for every pane
      # and not just the interesting ones: a pane meant to be bare is now
      # distinguishable from one we failed to place, which used to be the same
      # silent skip. "" is the latter — a pane the user made, nothing to run.
      shell | "") continue ;;
      agent:*)
        name="$ws_label"
        [[ -n "$tab_label" && ! "$tab_label" =~ ^"${role#agent:}"( [0-9]+)?$ ]] \
          && name="$tab_label"
        cmd="$(dev-agent-argv -q "${role#agent:}" "$name")" || continue ;;
      *) cmd="$(herdr-pane-cmd "$role")" \
           || { echo "$session: pane $pane has role '$role', which resolves to no command" >&2
                continue ;} ;;
    esac
    revive_pane_cmd "$session" "$pane" "$cmd" &
  done < <(jq -rn --argjson panes "$panes" --argjson tabs "$tabs" \
               --argjson workspaces "$workspaces" '
    ($workspaces | map({(.workspace_id): .label}) | add // {}) as $ws_label
    | ($tabs | map({(.tab_id): .label}) | add // {}) as $tab_label
    | ["review", "dev", "logs"] as $sibs
    # The agent-tab shape, for infer_role only: a tab carrying
    # herdr-agent-layout siblings plus exactly one other pane. That one pane is
    # the agent slot (1), its siblings are not (0); panes of any other tab get
    # "" and fall through to the label rules.
    | ($panes | group_by(.tab_id) | map(
        (map(.label // "")) as $ls
        | (map(select(IN(.label // ""; $sibs[]) | not))) as $rest
        | if (($sibs - $ls) | length) == 0 and ($rest | length) == 1
          then map({(.pane_id): (if .pane_id == $rest[0].pane_id then 1 else 0 end)})
          else [] end) | flatten | add // {}) as $slot
    | $panes | group_by(.tab_id)[] | (length == 1) as $single | .[]
    | [.pane_id, (.label // ""), ($ws_label[.workspace_id] // ""),
       ($tab_label[.tab_id] // ""), (.agent // ""),
       (if .agent_session then 1 else 0 end),
       ($slot[.pane_id] // ""), (if $single then 1 else 0 end)]
    | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")')

  # Bank what was inferred, then drop entries for panes that no longer exist.
  # Both after the loop so a single call covers the whole session, and after
  # `live` is complete so prune can never see a partial list.
  [[ ${#learned[@]} -gt 0 ]] && herdr-pane-role set -s "$session" "${learned[@]}"
  [[ ${#live[@]} -gt 0 ]] && herdr-pane-role prune -s "$session" "${live[@]}"
  # Reaps only the revive jobs: long-lived spawns (launch_client's kitty,
  # ensure_servers' server) go through spawn_detached, so they are never this
  # shell's children and cannot turn this wait into a forever-block.
  wait
}

# Boot the given sessions' servers if down, and wait for them. The CLI
# never auto-starts a server (a bare client errors on the missing socket), so
# a dead session must be booted explicitly; starting the headless server
# restores its saved workspaces/panes from session.json. Exit codes are
# unreliable for a session whose socket does not exist yet (the CLI prints an
# error but exits 0), so liveness comes from `session list`.
# All down servers are started first, then one shared poll watches the whole
# set — K dead servers boot in parallel instead of 5s each in sequence, and
# each tick costs one `session list` instead of one per session.
# Reports through globals (always returns 0, so callers under set -e choose
# how to react): BOOTED_SESSIONS = sessions this call started,
# FAILED_SESSIONS = sessions that never came up.
# Split into spawn/await phases so callers can act on the booted set (e.g.
# ensure_servers' notify) before committing to the poll wait.

# Spawn phase: start every not-yet-running server, setting BOOTED_SESSIONS.
spawn_servers() {
  local session up
  BOOTED_SESSIONS=()
  up="$(running_sessions)"
  for session in "$@"; do
    grep -qxF "$session" <<<"$up" && continue
    spawn_detached herdr --session "$session" server
    BOOTED_SESSIONS+=("$session")
  done
}

# Await phase: poll until every BOOTED_SESSIONS member is up or the wait
# times out, setting FAILED_SESSIONS.
await_servers() {
  local -a pending=("${BOOTED_SESSIONS[@]}")
  local session up i
  for ((i = 0; i < 20 && ${#pending[@]} > 0; i++)); do
    sleep 0.25
    up="$(running_sessions)"
    local -a still=()
    for session in "${pending[@]}"; do
      grep -qxF "$session" <<<"$up" || still+=("$session")
    done
    pending=("${still[@]}")
  done
  FAILED_SESSIONS=("${pending[@]}")
}

boot_servers() {
  spawn_servers "$@"
  await_servers
}

# boot_servers + relaunch the freshly booted servers' pane commands
# (revive_panes) once up. Prints the names that failed to come up; returns
# non-zero if any did.
#
# A cold boot restores every persisted workspace/pane (a grown session spawns
# dozens of shells) — seconds during which a keybind-driven launch shows
# nothing on screen. Two mitigations: announce the boot up front, and run
# revive_panes in the background (spawn_bg) so callers can open the client
# window as soon as the server is up — the panes visibly fill in instead of
# blocking the launch. The backgrounded revive takes its pane-list snapshot
# immediately, before a caller like dev-herdr can create new panes, so it
# only touches panes restored by the boot.
ensure_servers() {
  local session
  spawn_servers "$@"
  [[ ${#BOOTED_SESSIONS[@]} -gt 0 ]] && notify low "Starting: ${BOOTED_SESSIONS[*]}…"
  await_servers
  for session in "${BOOTED_SESSIONS[@]}"; do
    in_list "$session" "${FAILED_SESSIONS[@]}" && continue
    spawn_bg revive_panes "$session"
  done
  [[ ${#FAILED_SESSIONS[@]} -eq 0 ]] \
    || { printf '%s\n' "${FAILED_SESSIONS[@]}"; return 1; }
}

# Array membership: in_list NEEDLE [ITEM ...]
in_list() {
  local needle="$1"
  shift
  [[ $# -gt 0 ]] && printf '%s\n' "$@" | grep -qxF "$needle"
}

# Resolve a workspace's project directory for a new utility tab. First guess:
# read the label back as a project entry, grouped ("<session>/<label>") then
# bare ("<label>", which is where a project pinned into a session it does not
# live under — dotfiles in labs — actually sits). Both candidates go through
# dev-projects, which owns that mapping, and a candidate counts only if the
# forward mapping agrees it belongs to this session: the label is cosmetic, so
# a directory that merely happens to share its name must not be believed.
# Otherwise fall back to a live pane's foreground cwd — right after a headless
# boot the pane shells may still be initializing, hence the retry. Fails when
# neither resolves.
workspace_cwd() { # $1: session, $2: workspace_id, $3: workspace label
  local dir pane i
  if [[ -n "$3" ]]; then
    for dir in "$(dev-projects resolve "$1/$3")" "$(dev-projects resolve "$3")"; do
      [[ -d "$dir" ]] || continue
      [[ "$(dev-projects session "$dir")" == "$1" ]] && { echo "$dir"; return 0; }
    done
  fi
  local -a ws_panes=()
  mapfile -t ws_panes < <(herdr --session "$1" pane list 2>/dev/null \
    | jq -r --arg w "$2" '.result.panes[]? | select(.workspace_id == $w) | .pane_id')
  for ((i = 0; i < 10; i++)); do
    for pane in "${ws_panes[@]}"; do
      dir="$(herdr --session "$1" pane process-info --pane "$pane" 2>/dev/null \
        | jq -r '.result.process_info.foreground_processes[0].cwd // empty')" || dir=""
      [[ -n "$dir" ]] && { echo "$dir"; return 0; }
    done
    sleep 0.3
  done
  return 1
}

# Reconcile one session's persisted workspaces with the current dev-herdr
# layout. dev-herdr reattaches to existing workspaces as-is, so a layout
# change silently resurrects the previous iteration on the next server
# restart — revive-panes relaunches whatever the stale labels say (observed:
# an old "git"-labeled agent-tab split reviving lazygit where hunk belongs,
# with no git tab at all). Rules, all idempotent and label-only (running
# processes are left alone; commands follow at the next revive-panes):
#   - a "git"-labeled pane in a tab NOT labeled git is the old in-tab lazygit
#     split → relabel "review" (hunk). Historical rule: retire it once no
#     persisted workspace predates the git tab. Tabs labeled "git" are exempt,
#     which is what keeps this off the ctrl+alt+g tool tab.
#   - NO rule closes tabs labeled "git" any more. There was one, for the
#     retired per-workspace lazygit tab, and it was retired itself once no
#     persisted session had such a tab left (verified across all four
#     session.json files: only review/nvim labels remained). It had to go: a
#     "git" tab is now something you asked for with ctrl+alt+g, and the rule
#     matched exactly its pristine shape — single pane running lazygit or a
#     bare shell — so it would have closed the new tool tab on the next
#     migrate-layout run.
#   - the unlabeled root pane of a single-pane utility tab gets the tab's
#     label (workspaces predating dev-herdr labeling utility root panes)
#   - a workspace missing a utility tab gets it, with a labeled bare-shell
#     root pane (dev-herdr util_tab's create→label sequence, minus the
#     command — revive-panes launches that)
# Nothing here repairs an agent pane's label any more: what a pane is FOR lives
# in herdr-pane-role, so the label is free to say whatever you renamed it to.
# Every pass that changes what a pane *is* sets its role too, because the role
# bootstrap in revive_panes trusts the label — running these two in the other
# order would otherwise teach it a stale label as a permanent role.
migrate_layout() {
  local session="$1" tabs panes pane label ws util cwd
  local -a util_tabs=() new_roles=()
  mapfile -t util_tabs < <(herdr-pane-cmd --util-tabs)
  tabs="$(herdr --session "$session" tab list 2>/dev/null \
    | jq -c '.result.tabs // []')" || return 0
  panes="$(herdr --session "$session" pane list 2>/dev/null \
    | jq -c '.result.panes // []')" || return 0

  while read -r pane; do
    herdr --session "$session" pane rename "$pane" review >/dev/null
    new_roles+=("$pane=review")
    echo "$session: relabeled pane $pane git -> review"
  done < <(jq -rn --argjson tabs "$tabs" --argjson panes "$panes" '
    ($tabs | map({(.tab_id): .label}) | add // {}) as $tl
    | $panes[] | select(.label == "git" and $tl[.tab_id] != "git") | .pane_id')

  while IFS=$'\t' read -r pane label; do
    herdr --session "$session" pane rename "$pane" "$label" >/dev/null
    new_roles+=("$pane=$label")
    echo "$session: labeled $label root pane $pane"
  done < <(jq -rn --argjson tabs "$tabs" --argjson panes "$panes" \
               --arg utils "${util_tabs[*]}" '
    ($utils | split(" ")) as $u
    | ($tabs | map({(.tab_id): .label}) | add // {}) as $tl
    | $panes | group_by(.tab_id)[] | select(length == 1) | .[0]
    | select(.label == null and ($tl[.tab_id] as $l | $u | index($l)))
    | [.pane_id, $tl[.tab_id]] | @tsv')

  while IFS=$'\t' read -r ws label; do
    for util in "${util_tabs[@]}"; do
      jq -en --argjson tabs "$tabs" --arg w "$ws" --arg u "$util" \
        'any($tabs[]; .workspace_id == $w and .label == $u)' >/dev/null && continue
      cwd="$(workspace_cwd "$session" "$ws" "$label")" || {
        echo "$session: cannot resolve cwd for workspace '$label' ($ws) — add its $util tab manually" >&2
        continue
      }
      pane="$(herdr --session "$session" tab create --workspace "$ws" \
          --label "$util" --cwd "$cwd" --no-focus \
        | jq -r '.result.root_pane.pane_id')"
      herdr --session "$session" pane rename "$pane" "$util" >/dev/null
      new_roles+=("$pane=$util")
      echo "$session: added $util tab to workspace '$label' (cwd $cwd)"
    done
  done < <(herdr --session "$session" workspace list 2>/dev/null \
    | jq -r '.result.workspaces[]? | [.workspace_id, .label // ""] | @tsv')

  # One call for the whole pass, like herdr-agent-layout's: `set` is a
  # read-modify-write of the entire file under a lock, so per-pane calls make
  # it quadratic. Still before revive-panes ever runs (migrate_layout_sessions
  # boots without it), which is what the ordering rule above requires.
  if [[ ${#new_roles[@]} -gt 0 ]]; then
    herdr-pane-role set -s "$session" "${new_roles[@]}"
  fi
}

# Migrate the given sessions (default: every persisted one). Down sessions
# are booted WITHOUT revive-panes — migration only edits labels/tabs, so no
# agents or pane commands should start — and stopped again afterwards, which
# persists the corrected layout and preserves the machine's running set.
migrate_layout_sessions() {
  local -a sessions=() known=()
  local session
  mapfile -t known < <(herdr session list --json 2>/dev/null \
    | jq -r '.sessions[]? | .name')
  if [[ $# -gt 0 ]]; then
    # Only persisted names: `herdr --session X server` would happily create
    # a brand-new session out of a typo.
    for session in "$@"; do
      if in_list "$session" "${known[@]}"; then
        sessions+=("$session")
      else
        echo "herdr-clients: unknown session '$session' — skipping" >&2
      fi
    done
  else
    sessions=("${known[@]}")
  fi
  [[ ${#sessions[@]} -eq 0 ]] && return 0
  boot_servers "${sessions[@]}"
  for session in "${sessions[@]}"; do
    in_list "$session" "${FAILED_SESSIONS[@]}" \
      && { echo "herdr-clients: server for '$session' did not start" >&2; continue; }
    migrate_layout "$session"
  done
  [[ ${#BOOTED_SESSIONS[@]} -gt 0 ]] && stop_sessions "${BOOTED_SESSIONS[@]}"
  [[ ${#FAILED_SESSIONS[@]} -eq 0 ]]
}

# Upgrade plain workspaces rooted in linked Git checkouts to Herdr's native
# worktree provenance. `worktree open` deliberately reuses an existing
# workspace for the same checkout, so tabs, panes and agents stay untouched.
# It also marks (or, when absent, creates) the main checkout as the parent.
migrate_worktrees() {
  local session="$1" panes ws label cwd checkout git_dir common main out
  panes="$(herdr --session "$session" pane list 2>/dev/null \
    | jq -c '.result.panes // []')" || return 0

  while IFS=$'\t' read -r ws label; do
    cwd="$(jq -r --arg w "$ws" \
      '[.[] | select(.workspace_id == $w) | .cwd // .foreground_cwd // empty][0] // empty' \
      <<<"$panes")"
    [[ -n "$cwd" && -d "$cwd" ]] \
      || cwd="$(workspace_cwd "$session" "$ws" "$label" 2>/dev/null || true)"
    [[ -n "$cwd" && -d "$cwd" ]] || {
      echo "$session: cannot resolve cwd for workspace '$label' ($ws) — skipping worktree migration" >&2
      continue
    }

    checkout="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || continue
    git_dir="$(git -C "$checkout" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || continue
    common="$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || continue
    [[ "$git_dir" != "$common" ]] || continue
    main="$(git -C "$checkout" worktree list --porcelain 2>/dev/null \
      | awk '$1 == "worktree" { print substr($0, 10); exit }')"
    [[ -n "$main" && -d "$main" ]] || {
      echo "$session: cannot find main checkout for '$label' ($checkout) — skipping" >&2
      continue
    }

    if out="$(herdr --session "$session" worktree open --cwd "$main" \
        --path "$checkout" --label "$label" --no-focus 2>&1)"; then
      already="$(jq -r '.result.already_open // false' <<<"$out" 2>/dev/null || echo false)"
      echo "$session: grouped workspace '$label' under $(basename "$main") (reused=$already)"
    else
      echo "$session: failed to migrate workspace '$label': $out" >&2
    fi
  done < <(herdr --session "$session" workspace list 2>/dev/null \
    | jq -r '.result.workspaces[]? | [.workspace_id, .label // ""] | @tsv')
}

migrate_worktree_sessions() {
  local -a sessions=() known=()
  local session
  mapfile -t known < <(herdr session list --json 2>/dev/null \
    | jq -r '.sessions[]? | .name')
  if [[ $# -gt 0 ]]; then
    for session in "$@"; do
      if in_list "$session" "${known[@]}"; then
        sessions+=("$session")
      else
        echo "herdr-clients: unknown session '$session' — skipping" >&2
      fi
    done
  else
    sessions=("${known[@]}")
  fi
  [[ ${#sessions[@]} -eq 0 ]] && return 0
  boot_servers "${sessions[@]}"
  for session in "${sessions[@]}"; do
    in_list "$session" "${FAILED_SESSIONS[@]}" \
      && { echo "herdr-clients: server for '$session' did not start" >&2; continue; }
    migrate_worktrees "$session"
  done
  [[ ${#BOOTED_SESSIONS[@]} -gt 0 ]] && stop_sessions "${BOOTED_SESSIONS[@]}"
  [[ ${#FAILED_SESSIONS[@]} -eq 0 ]]
}

# Reload config.toml in the given sessions' running servers (default: every
# running one). A server reads config.toml only at boot and at reload-config,
# so a config change (e.g. a new keybinding) silently skips every session but
# the one it was reloaded in; down sessions need nothing — they pick it up at
# the next boot. Non-running names passed explicitly are reported, not booted.
reload_config_sessions() {
  local -a sessions=() up=()
  local session out rc=0
  mapfile -t up < <(running_sessions)
  if [[ $# -gt 0 ]]; then
    for session in "$@"; do
      if in_list "$session" "${up[@]}"; then
        sessions+=("$session")
      else
        echo "herdr-clients: session '$session' is not running — it reads config.toml at its next boot" >&2
      fi
    done
  else
    sessions=("${up[@]}")
  fi
  [[ ${#sessions[@]} -eq 0 ]] && { echo "herdr-clients: no running sessions to reload"; return 0; }
  for session in "${sessions[@]}"; do
    if out="$(herdr --session "$session" server reload-config 2>&1)"; then
      # Surface the server's diagnostics (e.g. an unparseable binding) — a
      # reload that "applied" with diagnostics is how a typo hides.
      jq -r --arg s "$session" \
        '"\($s): config \(.result.status // "applied")",
         (.result.diagnostics[]? | "\($s): \(.)")' <<<"$out" 2>/dev/null \
        || echo "$session: config reloaded"
    else
      echo "herdr-clients: reload failed for '$session': $out" >&2
      rc=1
    fi
  done
  return "$rc"
}

# Wait for a launched client's window to map (kitty is async).
wait_for_window() {
  local class="$1"
  for _ in $(seq 1 40); do
    window_exists "$class" && return 0
    sleep 0.1
  done
  echo "herdr-clients: window for $class did not appear" >&2
  return 1
}

# Does a session hold anything worth reopening? Reads the persisted state
# rather than asking the CLI, because a stopped server answers no call and
# whether to boot it is the whole question. Named sessions keep their state in
# sessions/<name>/, the default one directly in ~/.config/herdr (same
# derivation as herdr-nav quit and herdr-agent-title).
#
# The test is structural, never the workspace label (`custom_name`): labels are
# cosmetic and user-editable, so keying on one would mean clearing a workspace
# name silently drops its session from every later open-all and cold boot —
# the exact failure the pane roles exist to prevent, one object up. What a
# fresh server opens with is one workspace of one tab of one pane; any
# workspace `dev` has ever touched has more (four panes in its agent tab, plus
# the utility tabs). Growth past that shape is the durable fact.
has_workspaces() {
  local state="$HOME/.config/herdr/sessions/$1/session.json"
  [[ "$1" == default ]] && state="$HOME/.config/herdr/session.json"
  [[ -f "$state" ]] || return 1
  jq -e 'any(.workspaces[]?;
             (.tabs | length) > 1 or ((.tabs[0].panes? // []) | length) > 1)' \
    "$state" >/dev/null 2>&1
}

open_all() {
  local -a names=() to_open=()
  local session class failed classes running attached
  # Start from ALL persisted sessions (not just running ones): a reboot kills
  # the detached servers (setsid background procs, not services), so after a
  # boot nothing is running and a running-only list would find nothing to
  # revive — the whole point of the keybind is to reopen every session at any
  # moment, including a cold boot with zero servers alive.
  # …but skip the ones with nothing in them: herdr keeps a session in the list
  # once it has existed, so a group emptied by moving its last project away
  # ("default", after dotfiles joined labs) would otherwise cost a booted
  # server plus an empty client window at every open-all and every cold boot.
  # It comes back on its own the moment a project lands there again. Running
  # sessions are never dropped — their server is already paid for, and one
  # legitimately sits empty between two `dev` calls.
  # (list_sessions' third column is ignored: it samples the windows now, and
  # what matters here is which ones exist *after* the servers are up.)
  while IFS=$'\t' read -r session running attached; do
    [[ "$running" == 1 ]] || has_workspaces "$session" || continue
    names+=("$session")
  done < <(list_sessions)
  [[ ${#names[@]} -eq 0 ]] && return 0
  failed="$(ensure_servers "${names[@]}")" || true
  # One hyprctl call for the whole loop (same one-call-then-grep pattern as
  # running_sessions in ensure_servers).
  classes="$(hyprctl clients -j 2>/dev/null | jq -r '.[].class')"
  for session in "${names[@]}"; do
    if [[ -n "$failed" ]] && grep -qxF "$session" <<<"$failed"; then
      echo "herdr-clients: server for '$session' did not start" >&2
      continue
    fi
    grep -qxF "$(class_for "$session")" <<<"$classes" || to_open+=("$session")
  done
  [[ ${#to_open[@]} -eq 0 ]] && return 0

  # Open the clients as one tabbed Hyprland group: launch sequentially, turn
  # the first mapped window into a group, and let the rest auto-join
  # (group.auto_group = true in general.lua — a new window opening at a
  # focused grouped window is added to the group). If some herdr windows
  # already exist (a partial open-all, or a lone `show`), join the new
  # clients onto the existing one instead of forming a second group: focus
  # it, make sure it is a group, and auto_group does the rest.
  local group_pending=0 existing_class
  existing_class="$(grep -m1 -E '^herdr(-.*)?$' <<<"$classes" || true)"
  if [[ -n "$existing_class" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"class:^($existing_class)\$\" })" >/dev/null
    if ! hyprctl clients -j 2>/dev/null \
        | jq -e --arg c "$existing_class" 'any(.[]; .class == $c and (.grouped | length) > 0)' >/dev/null; then
      hyprctl dispatch "hl.dsp.group.toggle()" >/dev/null
    fi
  elif [[ ${#to_open[@]} -ge 2 ]]; then
    # A single missing window just opens plain — no groupbar on a lone tile.
    group_pending=1
  fi
  for session in "${to_open[@]}"; do
    class="$(class_for "$session")"
    launch_client "$session"
    wait_for_window "$class" || continue
    if [[ $group_pending -eq 1 ]]; then
      group_pending=0
      hyprctl dispatch "hl.dsp.focus({ window = \"class:^($class)\$\" })" >/dev/null
      # auto_group may have already pulled the window into a pre-existing
      # group (it opened at the focused window — e.g. a grouped terminal);
      # togglegroup there would disband that group, so pull out first.
      if hyprctl clients -j 2>/dev/null \
          | jq -e --arg c "$class" 'any(.[]; .class == $c and (.grouped | length) > 0)' >/dev/null; then
        hyprctl dispatch "hl.dsp.window.move({ out_of_group = \"r\" })" >/dev/null
      fi
      hyprctl dispatch "hl.dsp.group.toggle()" >/dev/null
    fi
  done
}

# SIGTERM the kitty processes hosting matching clients — kitty closes
# cleanly, the herdr client exits, and the detached servers live on.
detach_matching() { # $1: jq filter applied to a window class
  hyprctl clients -j 2>/dev/null \
    | jq -r ".[] | select(.class | $1) | .pid" \
    | xargs -r kill 2>/dev/null || true
}

detach_all() { detach_matching 'test("^herdr(-.*)?$")'; }
detach_one() { detach_matching ". == \"$(class_for "$1")\""; }

# Stop the given sessions' servers. `session stop` kills the server process
# and everything in it (agents included); the persisted session.json
# survives, so a later show/open-all reboots them with their saved
# workspaces/panes. Callers close the client windows first (detach_one /
# detach_all). `session stop` returns as the server exits, but give teardown
# a bounded grace so a follow-up open-all (queued on the lock) sees a clean
# slate.
stop_sessions() {
  local session up alive i
  for session in "$@"; do
    herdr session stop "$session" >/dev/null 2>&1 || true
  done
  for ((i = 0; i < 20; i++)); do
    up="$(running_sessions)"
    alive=0
    for session in "$@"; do
      grep -qxF "$session" <<<"$up" && { alive=1; break; }
    done
    ((alive)) || return 0
    sleep 0.25
  done
}

# Full shutdown for a fresh start: close every client window, then stop
# every running server.
stop_all() {
  local -a up=()
  detach_all
  mapfile -t up < <(running_sessions)
  [[ ${#up[@]} -gt 0 ]] || return 0
  stop_sessions "${up[@]}"
}

case "${1:-}" in
  show|open)
    session="${2:?usage: herdr-clients show|open SESSION}"
    class="$(class_for "$session")"
    if window_exists "$class"; then
      # Hyprland 0.55 lua config: dispatch takes hl.dsp.* lua expressions
      # (classic `dispatch focuswindow class:...` errors but still exits 0).
      hyprctl dispatch "hl.dsp.focus({ window = \"class:^($class)\$\" })" >/dev/null
    else
      # Revive the server if it is down (e.g. after a reboot) — a bare client
      # errors on the missing socket, so it must be booted first.
      ensure_servers "$session" >/dev/null || die "server for '$session' did not start"
      launch_client "$session"
    fi
    ;;
  detach)
    session="${2:?usage: herdr-clients detach SESSION}"
    detach_one "$session"
    ;;
  stop)
    session="${2:?usage: herdr-clients stop SESSION}"
    detach_one "$session"
    stop_sessions "$session"
    ;;
  list) list_sessions ;;
  ensure-server)
    session="${2:?usage: herdr-clients ensure-server SESSION}"
    ensure_servers "$session" >/dev/null || die "server for '$session' did not start"
    ;;
  revive-panes)
    session="${2:?usage: herdr-clients revive-panes SESSION}"
    revive_panes "$session"
    ;;
  open-all)   open_all;   notify low "All sessions open" ;;
  detach-all) detach_all; notify low "All clients detached" ;;
  stop-all)   stop_all;   notify low "All servers stopped" ;;
  migrate-layout)
    shift
    migrate_layout_sessions "$@"
    ;;
  migrate-worktrees)
    shift
    migrate_worktree_sessions "$@"
    ;;
  reload-config)
    shift
    reload_config_sessions "$@"
    ;;
  *)
    die "unknown command: ${1:-<none>} (expected: show|open | detach | stop | list | ensure-server | open-all | detach-all | stop-all | revive-panes | migrate-layout | migrate-worktrees | reload-config)"
    ;;
esac
