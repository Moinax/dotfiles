[Desktop Entry]
Version=1.0
Name=Messenger
GenericName=Instant Messaging
Comment=Facebook Messenger in a dedicated window
# Absolute, like google-chrome.desktop next to it: a launcher is not started
# from a login shell, so ~/.local/bin is only on PATH when the Hyprland session
# put it there — a different condition than the one that installs this entry.
Exec={{ .chezmoi.homeDir }}/.local/bin/messenger
StartupNotify=true
# Must match the app_id the script sets via setDesktopFileName(), otherwise the
# launcher cannot tie the window back to this entry.
StartupWMClass=messenger
Terminal=false
# The favicon the app caches on every run (IconCache in ~/.local/bin/messenger),
# so the launcher shows the same icon as the tray and the notifications. An
# absolute path, which beats any icon theme that also ships a "messenger": the
# point is *this* icon, not a lookalike. It only misses on a machine where the
# app has never run — the app seeds the file from a theme icon at startup.
# ~/.local/share rather than $XDG_DATA_HOME: a desktop entry cannot read the
# environment, and chezmoi has no more idea than it does what that will be set to.
Icon={{ .chezmoi.homeDir }}/.local/share/icons/hicolor/128x128/apps/messenger.png
Type=Application
Categories=Network;InstantMessaging;
