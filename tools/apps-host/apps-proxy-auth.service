[Unit]
Description=Tailscale Whois authentication for the application proxy
After=tailscaled.service
Requires=tailscaled.service
PartOf=tailscaled.service

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/apps-tailscale-auth -sockpath /run/apps-proxy-auth/auth.sock
Restart=on-failure
RestartSec=2
RuntimeDirectory=apps-proxy-auth
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
