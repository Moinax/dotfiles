[Unit]
Description=Public Twitch Grid HTTPS
After=network-online.target twitch-grid.service
Wants=network-online.target

[Service]
User=apps-public
Group=apps-public
EnvironmentFile=/etc/personal-apps/public-proxy.env
EnvironmentFile=/etc/personal-apps/cloudflare.env
Environment=XDG_DATA_HOME=/var/lib/apps-public-proxy
Environment=XDG_CONFIG_HOME=/var/lib/apps-public-proxy
ExecStart=/usr/local/bin/apps-caddy run --config /etc/apps-public-proxy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/apps-caddy reload --config /etc/apps-public-proxy/Caddyfile --adapter caddyfile --address unix//run/apps-public-proxy/admin.sock
Restart=on-failure
RestartSec=5
RuntimeDirectory=apps-public-proxy
RuntimeDirectoryMode=0700
StateDirectory=apps-public-proxy
StateDirectoryMode=0700
MemoryMax=256M
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/etc/personal-apps /var/lib/finance /var/lib/daylight /opt/personal-apps/finance /opt/personal-apps/daylight /var/lib/apps-proxy

[Install]
WantedBy=multi-user.target
